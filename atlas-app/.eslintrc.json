{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "rules": {
    "no-restricted-syntax": [
      "error",
      {
        "selector": "Literal[value=/\\b(margin|padding|border)-(left|right)\\b/]",
        "message": "Use logical properties (margin-inline-start / -end). Arabic is RTL — physical properties break the layout."
      },
      {
        "selector": "Literal[value=/^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/]",
        "message": "No hard-coded colours. Use a theme token — the original app is unbrandable because its palette is hard-coded."
      }
    ],
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "assert": "either",
        "depth": 3
      }
    ],
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/aria-props": "error"
  }
}
