# Which environment this is. The seed refuses to run when APP_ENV=production.
# Local: development.  Vercel production: production.
APP_ENV="development"

# Database — Supabase gives you two connection strings. You need BOTH.
#
# Use SEPARATE Supabase projects for development and production. Sharing one
# means a seed run or a schema experiment hits live data.
#
#   DATABASE_URL  Transaction pooler, port 6543. Used at runtime.
#                 Must end with ?pgbouncer=true&connection_limit=1
#   DIRECT_URL    Direct connection, port 5432. Used by `prisma migrate`.
#                 PgBouncer cannot run migration DDL.
#
# Supabase dashboard -> Project Settings -> Database -> Connection string
# Replace [YOUR-PASSWORD] with the DB password you set at project creation.
DATABASE_URL="postgresql://postgres.[REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Auth
SESSION_SECRET="change-me-min-32-chars-long-random-string"

# SMS provider (mobile OTP login)
SMS_PROVIDER_KEY=""

# Meta WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# GST e-Invoice (IRP / GSP)
EINVOICE_BASE_URL=""
EINVOICE_CLIENT_ID=""
EINVOICE_CLIENT_SECRET=""

# GSTIN verification
GSTIN_LOOKUP_API_KEY=""

# S3-compatible storage
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Redis (queues)
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------- storage --
# Attachments on quotations, orders and invoices.
#
# The bucket must be PRIVATE. Links are signed per request and expire in ten
# minutes, so access follows the login and can actually be revoked. A public
# bucket hands out permanent URLs that work for anyone who ever sees them.
#
# Supabase -> Project Settings -> API
#   SUPABASE_URL              is "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY is the service_role key, behind Reveal.
#                             NOT the anon key - anon cannot write.
#
# The service role key bypasses every row-level security rule. Never give it a
# NEXT_PUBLIC_ prefix; that prefix ships the value to every visitor's browser.
#
# Setup: 03-technical-docs/06-runbooks/file-storage-setup.md
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments

# Brand assets — org logo, seal, icon, favicon, invoice logo, payment QR.
#
# A SEPARATE bucket, and this one must be PUBLIC. A logo has to render inside a
# printed PDF and an emailed invoice, neither of which carries a login — a
# 10-minute signed URL cannot do that. Nothing stored here is a secret; it is
# the organisation's own public-facing identity.
#
# Setup: same runbook as above, "Brand assets" section.
SUPABASE_BRAND_BUCKET=brand
