// ============================================================== GENERAL LEDGER
// Spec: 09-documentation/04-roadmap/PLATFORM-COMPLETION.md, "D011, in full"
//
// RULE 1 - every financial transaction ends as balanced double-entry journal
// lines. No module keeps a competing financial balance. Trial Balance, P&L,
// Balance Sheet, Bank Summary and every customer/supplier/employee balance
// are GENERATED FROM these two tables - nothing else stores a total.
//
// A posted entry is never edited and never deleted. A mistake is corrected
// by reversing it (same lines, debit and credit swapped) and posting the
// correction - both stay visible, which is what an audit actually needs.

/// The chart of accounts. One per organisation, not per store - GST
/// registration is per-branch in India, not per company, so a single chart
/// shared by every store is correct; branch, GSTIN and cost centre are
/// DIMENSIONS on the journal line, not separate accounts per store.
model Account {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code String // "1000", "4000" - sorts and groups the COA
  name String

  /// asset | liability | equity | revenue | expense - decides which side of
  /// the balance sheet or P&L this sits on and what its normal balance is.
  type String

  /// Free text, not an enum: "current_asset", "bank", "receivable",
  /// "payable", "cogs"... The set of useful subtypes grows with the reports
  /// that read it, and a report added later should not need a migration to
  /// group accounts the way it wants to.
  subType String?

  parentId String?
  parent   Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[] @relation("AccountHierarchy")

  /// A system account is one the posting engine posts to by code - it must
  /// always exist and stay active, or a document that tries to post
  /// against it fails at the worst possible moment. A tenant may still add
  /// their own accounts on top; those are never `isSystem`.
  isSystem Boolean @default(true)
  isActive Boolean @default(true)

  journalLines JournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([organizationId, code])
  @@index([organizationId, type])
}

/// One posting event - a source document's financial effect, expressed as
