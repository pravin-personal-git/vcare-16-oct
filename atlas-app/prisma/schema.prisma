/// An employee asking for an asset - Atlas-HRNS's "Requests & Allocation"
/// screen. Routed through the same reporting-line approval as leave
/// (`entityType = 'asset_request'` in hierarchy.ts) - an employee's own
/// manager is exactly who should see "I need a laptop" first, same as a
/// leave request. Once approved, an admin FULFILS it by pointing at an
/// existing spare `Asset` or creating a new one - fulfilment is a distinct
/// step from approval, because "yes you can have one" and "here is the
/// actual laptop" happen at different times and by different people.
model AssetRequest {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  /// Free text - "Laptop", "Company Phone", not a link to a specific Asset,
  /// since the whole point of a request is that the requester doesn't know
  /// or care which physical unit they end up with.
  assetType String
  reason    String?

  /// `pending` | `approved` | `rejected` | `fulfilled`
  status String @default("pending")

  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?

  /// Set once an admin allocates a real Asset against this request - the
  /// bridge from "approved" to "fulfilled".
  fulfilledAssetId String?
  fulfilledAsset   Asset?    @relation(fields: [fulfilledAssetId], references: [id], onDelete: SetNull)
  fulfilledAt      DateTime?
  fulfilledBy      String?

  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([storeId, status])
}

