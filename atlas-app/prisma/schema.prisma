  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([storeId, phase, sortOrder])
}

model LifecycleTask {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phase           String
  checklistItemId String?
  checklistItem   LifecycleChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  /// Copied from the template at creation time, so renaming or deactivating
