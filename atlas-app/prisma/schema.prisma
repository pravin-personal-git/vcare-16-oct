}

/// A personal quick-switch between two logins the same physical person
/// controls - deliberately NOT a way to hold one identity across multiple
/// organisations. Each business stays a fully separate `Organization`, fully
/// isolated exactly as it is today; this only remembers "I proved I control
/// this other account once" so switching later doesn't ask for its password
/// again. Created in both directions at once (A→B and B→A) so either side
/// can switch to the other. Ownership was already proven at creation time
/// (`server/linked-accounts.ts` verifies the target's password before
/// writing this row) - nothing here bypasses authentication, it just
/// remembers a check that already happened.
model LinkedAccount {
  id String @id @default(cuid())

  ownerUserId String
  owner       User   @relation("LinkedAccountOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  linkedUserId String
  linked       User   @relation("LinkedAccountTarget", fields: [linkedUserId], references: [id], onDelete: Cascade)

  label     String?
  createdAt DateTime @default(now())

  @@unique([ownerUserId, linkedUserId])
  @@index([ownerUserId])
}

// ===========================================================================
// ATTENDANCE - leave, working from home, and public holidays
//
// A shift says somebody WAS at work. These two models say why they were not,
// which is the other half of an attendance sheet and the half that decides
// whether a blank cell is a problem.
//
// WITHOUT THESE, EVERY BLANK LOOKS THE SAME
//
// A salesperson on approved leave, a public holiday, and somebody who simply
// did not turn up all render identically - an empty box. A manager scanning a
// month cannot tell them apart, so either they chase people who are on
// holiday, or they stop looking at the grid. Both end with the feature unused.
// ===========================================================================

/// A day the business is closed. Diwali, Republic Day, a local bandh.
///
/// Per STORE, not per organisation: a Chhattisgarh branch and a Kerala branch
/// close on different days, and a national list would mark the wrong people
/// absent in both.
model Holiday {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Midnight local. Compared by calendar day, never by timestamp.
  date DateTime
  name String

  /// `public` | `optional` | `closure`
  ///
  /// An OPTIONAL holiday is one staff may take or not - common in India, where
  /// a company offers a list and each person picks two. It does not excuse an
  /// absence by itself, which is why it is not simply another public holiday.
  kind String @default("public")

  /// Set when this row was generated by toggling a `GovernmentHoliday` on
  /// for this store, so toggling it back off can find and remove exactly
  /// this row without duplicating on a second toggle-on. Null for anything
  /// typed in by hand.
  sourceGovernmentHolidayId String?
  sourceGovernmentHoliday   GovernmentHoliday? @relation(fields: [sourceGovernmentHolidayId], references: [id], onDelete: SetNull)

  createdBy String?
  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@unique([storeId, date, name])
  @@index([storeId, date])
}

/// The published national/state holiday calendar an admin picks FROM,
/// rather than typing every holiday out by hand each year.
///
/// Global, not store-scoped - the same published calendar applies to every
/// tenant. Which of it actually applies to one store is a per-store
/// decision, held as the `Holiday` rows toggling one of these generates,
/// not here.
///
/// Seeded with only the handful of FIXED-DATE national holidays that are
/// safe to generate for any year without guessing - see
/// `sync-tenant-defaults.ts`. Movable and state-specific holidays are real
/// backlog, added here by hand as they're confirmed, not invented.
model GovernmentHoliday {
  id    String   @id @default(cuid())
  date  DateTime
  name  String
  /// Null = observed nationally. Set = only that state observes it.
  state String?
  year  Int

  holidays Holiday[]

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@unique([date, name, state])
  @@index([year, state])
}

/// Somebody asking not to be at work, or to work from elsewhere.
///
/// One row covers a RANGE, not a day. A person taking Monday to Friday off
/// makes one request their manager approves once - five rows would be five
/// approvals and five chances to approve four of them.
model LeaveRequest {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)

  /// `leave` | `wfh` | `half_day`
  kind String @default("leave")

  /// Which LeaveType bucket this draws from - null for `wfh`/`half_day`,
  /// which never consume a quota, and for a plain `leave` request made
  /// before this store had configured any types. Added 18 Sep 2026;
  /// existing rows stay null rather than being guessed at.
  leaveTypeId String?
  leaveType   LeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)

  /// Inclusive both ends. A single day has the same value in both.
  fromDate DateTime
  toDate   DateTime

  reason String?

  /// `pending` | `approved` | `rejected` | `cancelled`
  ///
  /// A REJECTED request is kept, not deleted. "I did ask" is the commonest
  /// dispute in attendance, and a deleted row cannot answer it.
  status String @default("pending")

  decidedBy    String?
  decider      User?     @relation("LeaveDecider", fields: [decidedBy], references: [id])
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Covering the range for the month grid, which asks "anything overlapping
  /// these 30 days" on every load.

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@index([storeId, status])
  @@index([storeId, userId, fromDate])
  @@index([storeId, fromDate, toDate])
}

/// A named leave category with its own quota - Casual, Sick, Earned, and so
/// on. Distinct from LeaveRequest.kind, which only says what KIND of day off
/// a request is ('leave' / 'wfh' / 'half_day'), never which bucket a 'leave'
/// request draws from - that's this model, referenced by LeaveRequest.leaveTypeId.
model LeaveType {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Short code shown wherever space is tight - CL, SL, EL.
  code               String
  name               String
  /// What fraction of a normal day's pay a day of this leave type draws -
  /// 100 for a fully-paid type (Casual, Sick, Earned), 0 for unpaid, or
  /// anything between for a partial-pay type (atlas-hrns's
  /// `payment_percentage`; Atlas had no equivalent until 19 Sep 2026, when
  /// this replaced a binary `isPaid` boolean - see `payroll-days.ts`'s
  /// `paidFraction` for where it's actually consumed).
  paidPercentage     Int     @default(100)
  /// The figure offered when creating a new employee's allocation for a
  /// year - a starting point, not a cap. LeaveAllocation.allowedDays is what
  /// actually governs any specific employee's quota for any specific year.
  defaultDaysPerYear Int?
  isActive           Boolean @default(true)
  sort               Int     @default(0)

  allocations          LeaveAllocation[]
  requests             LeaveRequest[]
  encashments          LeaveEncashment[]
  allocationRequests   LeaveAllocationRequest[]
  restrictedInSpecific RestrictedLeavePeriod[]  @relation("RestrictedPeriodSpecific")
  restrictedInExcluded RestrictedLeavePeriod[]  @relation("RestrictedPeriodExcluded")

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, code])
}

/// How many days of one leave type one employee gets for one year.
///
/// "Taken" is deliberately NOT a column here. It's computed at read time as
/// the sum of that employee's APPROVED LeaveRequest day-spans of this type
/// overlapping the year - the same "ledger, not a stored total" rule this
/// codebase already applies to stock and the general ledger. A stored
/// "taken" counter could drift from what was actually approved; a computed
/// one cannot.
model LeaveAllocation {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  year        Int
  allowedDays Int

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, userId, leaveTypeId, year])
}

/// An employee asking for MORE days than their normal allocation - routed
/// through their own reporting line like leave/wfh/comp_off (see
/// `HIERARCHY_ROUTED_ENTITIES` in `hierarchy.ts`). Approving one adds
/// `requestedDays` onto that employee's `LeaveAllocation.allowedDays` for
/// the current year - it never edits the allocation directly, so "why does
/// this person have 15 CL days instead of the usual 12" is always
/// answerable by this table, the same "ledger explains the total" rule
/// `LeaveAllocation`'s own comment already applies.
model LeaveAllocationRequest {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId String
