// ================================================================== INVOICE
// Spec: 05-sales-orders-invoices.md §2
//
// Status is NOT stored as a single column that someone can type into.
// `paid` and `partially_paid` are derived from money received, and `overdue`
// is derived from the due date - exactly as quotation expiry is. What IS
// stored is the part a human decides: draft, sent, cancelled.

model Invoice {
  /// How many times this invoice has been corrected after issue. 1 is the
  /// original. Kept on the row so a list can show it without joining.
  version Int @default(1)

  revisions InvoiceRevision[]

  /// The customer's own purchase order number. Their reference, not ours -
  /// large buyers will not pay an invoice that does not quote it back.
  poNumber String?

  /// Closing archives a document without deleting it - it leaves the Active
  /// list and appears under History. The reference carries an Active/History
  /// toggle on every list screen and this is what it switches on.
  ///
  /// Deliberately NOT a status. A quotation that was accepted and then closed
  /// is still an accepted quotation; folding "closed" into the status would
  /// destroy that fact and make the accepted count wrong forever.
  closedAt  DateTime?
  closedBy  String?
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  invoiceNo String // INV-BR001-2026-0001

  /// Original reference from the system this was migrated from. Null on
  /// anything Atlas issued. See `Complaint.legacyRef` for the reasoning.
  legacyRef String?

  /// Where it came from. Null means it was raised directly.
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id])

  // Buyer snapshot. A tax invoice is a legal document - once issued, the name
  // and GSTIN on it must never change because a master record was edited.
  customerName     String
  organizationName String?
  email            String?
  phone            String
  gstin            String?
  billingAddress   String?
  shippingAddress  String?
  stateId          String?
  cityId           String?

  invoiceDate DateTime @default(now())
  dueDate     DateTime

  /// draft | sent | cancelled. Paid/partial/overdue are computed - see
  /// lib/invoice-status.ts for why storing them invites a lie.
  lifecycle String @default("draft")

  salespersonId String?

  deliveryCharge Int     @default(0)
  deliveryExempt Boolean @default(false)

  discountType  String @default("amount")
  discountValue Int    @default(0)

  subtotalPaise      Int    @default(0)
  itemDiscountPaise  Int    @default(0)
  orderDiscountPaise Int    @default(0)
  taxableBasePaise   Int    @default(0)
  cgstPaise          Int    @default(0)
  sgstPaise          Int    @default(0)
  igstPaise          Int    @default(0)
  grandTotalPaise    Int    @default(0)
  taxMode            String @default("IGST")

  /// Kept alongside the payment rows so the list screen does not need to
  /// aggregate a join for every row. Written only inside the payment
  /// transaction, never by hand.
  amountPaidPaise Int @default(0)

  termsBody String?
  notes     String?

  // ---- GST e-Invoice (IRP). Populated only above the turnover threshold.
  irn       String?
  ackNo     String?
  ackDate   DateTime?
  qrPayload String?

  /// The customer's no-login link (/i/<token>), minted the first time the
  /// invoice is shared. 24 random bytes; the token IS the credential, the same
  /// as Quotation.publicToken.
  publicToken String? @unique

  sentAt       DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  items             InvoiceItem[]
  payments          InvoicePayment[]
  allocations       ReceiptAllocation[]
  salesReturns      SalesReturn[]
  creditNotes       CreditNote[]           @relation("InvoiceCreditNotes")
  creditAllocations CreditNoteAllocation[] @relation("InvoiceCreditAllocations")
  /// Contracts THIS invoice bills the fee for.
  amcContracts      AmcContract[]          @relation("AmcBillingInvoice")
  /// Contracts created because this invoice sold a product carrying AMC.
  amcContractsSold  AmcContract[]          @relation("AmcOriginInvoice")
  /// The field job this invoice bills (Bill this job, 28 Sep 2026).
  job               Complaint?             @relation("JobInvoice")
  unitsSold         StockUnit[]
  /// Every document this invoice bills (2 Oct 2026). `salesOrderId` above
  /// still carries the first order; this carries all of them.
  sources           InvoiceSource[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, invoiceNo])
  @@index([storeId, lifecycle])
  @@index([storeId, invoiceDate])
  @@index([storeId, dueDate])
  @@index([storeId, legacyRef])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  srNo        Int
  productId   String?
  productName String
  productCode String?
  hsnCode     String?

  qty            Int
  unitPricePaise Int
  discountPct    Decimal @default(0) @db.Decimal(5, 2)
  taxRatePct     Decimal @default(18) @db.Decimal(5, 2)

  lineDiscountPaise Int
  lineTotalPaise    Int

  /// Every return raised against this line. The cumulative cap is computed from
  /// these rows - never stored on the line, because a stored "returned so far"
  /// is the same failure mode as a stored balance and would let a cancelled
  /// return keep consuming the allowance forever.
  returnItems SalesReturnItem[]

  // ---- AMC on this line. Added 24 Sep 2026.
  //
  // Issuing the invoice turns these into a real `AmcContract` - see
  // `createContractsForInvoice` in server/amc.ts. ONE CONTRACT PER LINE, which
  // is what "one contract per product" means while stock is not serialised:
  // eight identical cameras are one line with qty 8, so they share one
  // contract covering eight units. Per-physical-unit contracts need Phase 3,
  // and `AmcContractItem.serialNo` is already there waiting for it.

  /// True when this line carries AMC.
  ///
  /// Set automatically for a product whose AMC is `included` - the customer did
  /// not choose it, it came with the purchase. Set by a person ticking a box
  /// when the AMC is `extra`, because then it is a sale they can decline.
  amcOpted Boolean @default(false)

  /// The AMC terms AS SOLD, copied from the product at the moment of sale.
  ///
  /// Snapshotted for the same reason `productName` is denormalised onto this
  /// line: a tax invoice records what was agreed on the day. Editing the
  /// product's AMC price next April must not silently change what this
  /// customer was charged, nor how long they were told they were covered.
  ///
  /// `amcPricePaise` is null when the AMC was included in the purchase price -
  /// there was no separate fee. It is NOT added into `lineTotalPaise`: an
  /// extra-cost AMC is billed on its own invoice, so putting it in this line's
  /// total would charge for it twice and overstate the GST on the goods.
  amcMonths     Int?
  amcPricePaise Int?

  /// The contract this line produced, if it has been created yet.
  ///
  /// One-to-one via the unique `AmcContract.originInvoiceItemId`. This relation
  /// is what makes contract creation idempotent: `createContractsForInvoice`
  /// asks for lines where it `is: null` rather than trying an insert and
  /// catching the failure, so running it repeatedly finds nothing left to do.
  amcContract AmcContract?

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  /// Which document each charge on this line came from (2 Oct 2026).
  sources InvoiceItemSource[]

  @@index([invoiceId])
}

/// WHAT ONE INVOICE BILLS. Added 2 Oct 2026.
///
/// `Invoice.salesOrderId` is a single nullable foreign key, so until now an
/// invoice could physically point at one order and no more. That is wrong for
/// how Vcare actually sell: a site grows over weeks, the customer adds items
/// mid-job on a second order, three technicians raise three installation
/// challans, and at the end the customer expects ONE bill for all of it.
/// Issuing an invoice per order instead means the customer reconciles four
/// documents against one site, which is the thing they complained about.
///
/// So this is the real answer to "where did this invoice come from": a list,
/// not a column. `Invoice.salesOrderId` stays and still carries the FIRST
/// order, because thirty-odd call sites read it and a tax document's history
/// is not something to rewrite for tidiness - this table is additive.
///
/// NO UNIQUE ON THE SOURCE DOCUMENT. Tempting, since a challan must not be
/// billed twice - but a cancelled invoice has to release its challans, and a
/// database unique cannot tell a cancelled invoice from a live one while both
/// rows still exist (nothing here is ever deleted). Double billing is refused
/// in `assertNotAlreadyBilled`, which asks for a live invoice rather than any
/// invoice, the same way `SalesOrder.isInvoiced` has always been reversible.
model InvoiceSource {
  id        String  @id @default(cuid())
  storeId   String
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// sales_order | installation_challan | job
  kind String

  salesOrderId String?
  salesOrder   SalesOrder?          @relation("InvoiceSourceOrder", fields: [salesOrderId], references: [id])
  challanId    String?
  challan      InstallationChallan? @relation("InvoiceSourceChallan", fields: [challanId], references: [id])
  complaintId  String?
  complaint    Complaint?           @relation("InvoiceSourceJob", fields: [complaintId], references: [id])

  /// The document number AS IT READ when the invoice was raised, for the same
  /// reason the buyer name is snapshotted onto the invoice: a tax document
  /// records what was true on the day. The foreign key is how you open it; this
  /// is how it prints even if the row behind it is later archived.
  docNo   String
  docDate DateTime

  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  /// One document appears once on one invoice. Catches a double-add in the
  /// picker without needing the picker to be careful.
  @@unique([invoiceId, docNo])
  @@index([storeId, challanId])
  @@index([storeId, salesOrderId])
  @@index([storeId, complaintId])
}

/// WHERE ONE CHARGE CAME FROM. Added 2 Oct 2026.
///
/// Pravin's requirement, in his words: the customer's PDF shows the cost and
/// the thing it is being charged for, and an employee with the permission can
/// click any line and "see the trail of what cost came from where and why".
///
/// One invoice line can draw on several documents - twelve cameras delivered
/// across three challans are ONE line on the bill, because that is what the
/// customer bought - so this is a list per line with the quantity each
/// document contributed. It is what makes the line clickable instead of a
/// number somebody has to take on trust.
///
/// QTY IS STORED, not derived from the source line. The source line records
/// what was dispatched; this records what was BILLED from it. They are usually
/// equal and must not be assumed to be: a part-billed challan, a short
/// delivery invoiced in full by agreement, or a line split across two invoices
/// all make them differ, and in every one of those cases the invoice's own
/// number is the one that has to add up.
model InvoiceItemSource {
  id            String      @id @default(cuid())
  storeId       String
  invoiceItemId String
  invoiceItem   InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)

  /// installation_challan | sales_order | job | manual
  kind String

  challanId        String?
  challan          InstallationChallan?     @relation("InvoiceLineChallan", fields: [challanId], references: [id])
  challanItemId    String?
  challanItem      InstallationChallanItem? @relation(fields: [challanItemId], references: [id])
  salesOrderId     String?
  salesOrder       SalesOrder?              @relation("InvoiceLineOrder", fields: [salesOrderId], references: [id])
  salesOrderItemId String?
  salesOrderItem   SalesOrderItem?          @relation(fields: [salesOrderItemId], references: [id])

  /// Billed from this document. See the note above on why it is stored.
  qty Int

  /// Snapshot, as on `InvoiceSource.docNo`.
  docNo   String
  docDate DateTime

  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([invoiceItemId])
  @@index([storeId, challanId])
  @@index([storeId, salesOrderId])
}

/// Every receipt against an invoice, as its own row.
///
/// A running total alone cannot answer "when did they pay, and how?" - which
/// is the first question asked when a customer disputes a balance.
///
/// SUPERSEDED by Receipt + ReceiptAllocation. Kept, with its rows, because it
/// is the record of what was banked before the split existed and deleting it
/// would leave those receipts with no origin. Nothing writes here any more.
model InvoicePayment {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  storeId   String

  amountPaise Int
  paidAt      DateTime @default(now())
  method      String   @default("cash") // cash | upi | bank | cheque | card | adjustment
  reference   String? // UTR, cheque no, txn id

  recordedBy String?
  note       String?
  createdAt  DateTime @default(now())

  /// Set by the migration that split payments into receipts, so the two
  /// records can be reconciled and neither is double-counted.
  migratedToReceiptId String?

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([invoiceId])
  @@index([storeId, paidAt])
}

// ===================================================================== RECEIPTS
// Spec: 07-decisions/foundation-review-finance-inventory.md §2
//
// Money arriving and the invoices it settles are two different facts, and the
// old model conflated them by hanging every payment off exactly one invoice.
// That made four ordinary things impossible: an advance, one cheque against
// several invoices, money paid on account, and TDS deducted at source.

/// Money that arrived, from a party, on a date. One banking event, one row.
///
/// Note what is NOT here: no invoice. A receipt can exist before any invoice
/// does - that is an advance - and the link to invoices lives in
/// ReceiptAllocation, where it can be changed without rewriting this record of
/// what the bank actually saw.
///
/// `method` includes `tds`, which is not cash at all: the customer paid the
/// government on the seller's behalf. It settles an invoice exactly as cash
/// does, and only the account it posts to differs. Treating it as anything
/// else leaves every such invoice showing a permanent shortfall that staff
/// waste weeks chasing.
model Receipt {
  id        String @id @default(cuid())
  receiptNo String
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Original reference from the system this was migrated from. Null on
  /// anything Atlas issued. See `Complaint.legacyRef` for the reasoning.
  ///
  /// Expected to stay null across the whole Vcare import: their `Payment`
  /// model had no payment-number field at all, so there was never a reference
  /// to carry. `receiptNo` here is Atlas's own.
  legacyRef String?

  partyId String
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Restrict)

  /// WHAT THIS MONEY WAS COLLECTED AGAINST. Added 2 Oct 2026.
  ///
  /// Pravin's rule: an advance "sits with the relevant challan", or with the
  /// order if it arrived before any work. Without these two columns a receipt
  /// knows only the customer, so money handed to a technician on site on the
  /// 8th is indistinguishable a month later from money posted at the office,
  /// and nobody can answer "what has this site already paid?".
  ///
  /// Both nullable and both ordinary: a receipt against a plain invoice, or
  /// money simply paid on account, names neither. Neither is a link TO an
  /// invoice - that is `ReceiptAllocation`, and it stays the only thing that
  /// decides what a receipt settles.
  salesOrderId String?
  salesOrder   SalesOrder?          @relation(fields: [salesOrderId], references: [id])
  challanId    String?
  challan      InstallationChallan? @relation(fields: [challanId], references: [id])

  amountPaise Int
  receivedAt  DateTime @default(now())
  /// cash | upi | bank | cheque | card | tds | adjustment
  method      String   @default("cash")
  /// UTR, cheque number, or the TDS certificate number.
  reference   String?
  note        String?

  /// received | bounced | reversed
  ///
  /// Never deleted. A bounced cheque is an event that happened and the bank
  /// charge that follows has to hang off something; deleting the receipt would
  /// make the money look as though it never arrived, which is a different and
  /// untrue story.
  status         String    @default("received")
  reversedAt     DateTime?
  reversalReason String?
  reversedBy     String?

  recordedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  allocations ReceiptAllocation[]

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, receiptNo])
  @@index([storeId, receivedAt])
  @@index([partyId, receivedAt])
  @@index([storeId, salesOrderId])
  @@index([storeId, challanId])
  @@index([storeId, status])
}

/// How much of a receipt settles which invoice.
///
/// Append-only and signed, the same shape as StockMovement: un-applying money
/// writes a negative row rather than deleting the original. Deleting would make
/// a correction and a mistake look identical afterwards, and with money that is
/// the difference between an error and a missing ₹40,000.
///
/// An invoice's paid figure is the sum of these rows, never a stored column.
/// The stored version of that number is what broke Party.currentBalancePaise
/// twice over.
model ReceiptAllocation {
  id        String  @id @default(cuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Signed. Negative takes an earlier allocation back.
  amountPaise Int
  /// Why it was taken back. Only set on negative rows.
  reason      String?

  allocatedAt DateTime @default(now())
  allocatedBy String?

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([invoiceId])
  @@index([receiptId])
  @@index([storeId, allocatedAt])
}

// ================================================================ STOCK LEDGER
// Spec: 06-inventory.md §1
//
// Append-only. `ProductBalance.currentQty` is a running total maintained in the
// same transaction as the movement that changed it - never edited on its own.
// A balance you can set by hand is a balance nobody trusts at audit.

model StockMovement {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  /// Signed. Negative takes stock out, positive puts it in. One column rather
  /// than in/out columns, so the ledger sums to the balance with no case
  /// analysis and no way to get the sign wrong at the call site.
  qty Int

  /// dispatch | receipt | adjustment | return_in | return_out | opening |
  /// unit_status | migration_backfill | migration_opening - see
  /// `MovementReason` in server/stock.ts for the full list.
  ///
  /// The two `migration_` reasons are permanent labels, not temporary ones: a
  /// movement reconstructed from old paperwork, or an opening balance worked
  /// out backwards, must stay distinguishable from a counted one forever.
  reason String

  /// The lot this movement came out of or went into, for a `batch` product.
  /// Lot quantity on hand is the sum of these - never stored on the lot.
  lotId String?
  lot   StockLot? @relation(fields: [lotId], references: [id])

  /// The physical unit that moved, for a `serial` product whose unit changed
  /// state one at a time. Null on a receipt line that brought in many units -
  /// those are linked through `StockUnit.grnItemId` instead.
  stockUnitId String?
  stockUnit   StockUnit? @relation(fields: [stockUnitId], references: [id])

  /// What caused it, for traceability back to the document.
  refType String? // SalesOrder | Invoice | GRN | Manual
  refId   String?
  refNo   String?

  /// Balance immediately after this movement, so history can be read without
  /// replaying the whole ledger.
  balanceAfter Int

  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([storeId, productId, createdAt])
  @@index([refType, refId])
  @@index([lotId])
  @@index([stockUnitId])
}

// =============================================================== SALES TARGET
// Spec: 05-sales-orders-invoices.md §3
//
// A target is per user, per store, per period. Storing the period as an
// explicit start and end rather than a month number is what lets the same table
// hold monthly, quarterly and financial-year targets without a second model.

model UserTarget {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// month | quarter | fy
  periodType  String
  periodStart DateTime
  periodEnd   DateTime
  /// Human label - "Aug 2026", "Q2 FY 2026-27". Stored so a renamed period
  /// convention does not silently rewrite history.
  periodLabel String

  targetPaise Int @default(0)

  /// Percentage of achieved value paid as incentive. Decimal because half a
  /// percent is a real slab, and floats lose money at scale.
  incentivePct Decimal @default(0) @db.Decimal(5, 2)

  note      String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One target per person per period per store. Two targets for the same
  /// month is not a feature, it is a disagreement.

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, userId, periodType, periodStart])
  @@index([storeId, periodStart])
}

/// A file hung off a sales document.
///
/// One table for all three document types rather than three near-identical
/// tables, because the alternative is writing the same upload code three times
/// and having it drift. `docType` plus `docId` is a deliberate soft reference:
/// a hard foreign key would need three nullable columns and a check constraint
/// to keep exactly one populated, which is more machinery than this earns.
///
/// The file itself is not in the database. `storagePath` points into a private
/// storage bucket; putting megabytes of PDF in Postgres makes every backup and
/// every restore slower for no gain, and Supabase charges for the privilege.
model DocumentAttachment {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// quotation | sales_order | invoice
  docType String
  docId   String

  fileName String
  /// Bytes. Shown to the user, and checked before upload.
  fileSize Int
  mimeType String

  /// The object key inside the storage bucket - NOT a URL.
  ///
  /// The bucket is private, so there is no permanent address to store. A
  /// short-lived signed URL is minted when somebody with a session actually
  /// asks for the file. Storing a URL instead would either mean a public
  /// bucket, or a link in the database that expires and goes stale.
  storagePath String

  /// What this document is - PO copy, signed quotation, cheque photo.
  label String?

  /// 11 Oct 2026: what kind of file it is - Customer PO, Payment proof, Signed
  /// challan, Site / Before / After photo, Warranty card, E-way bill, Other
  /// (lib/attachment-tags). "This document needs" is checked against it.
  tag               String?
  /// Shown in the customer portal for that job / document. Off by default.
  visibleToCustomer Boolean @default(false)
  /// Set on the OLD row when a newer version replaced it. The old file is kept.
  replacedById      String?
  /// What the AI reader found in it (PO number, amount, UTR) and whether it matched.
  extracted         Json?
  /// Why it was removed. Removing keeps the file (nothing is hard-deleted).
  removedReason     String?

  uploadedBy String?
  uploadedAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([storeId, docType, docId])
}

/// A file in the Common Hub - not attached to any specific quotation, order or
/// invoice, which is what makes it different from `DocumentAttachment`.
///
/// Deliberately no folder TREE, no per-row permission list, no version chain -
/// the reference app's own equivalent screen is a flat list too. A folder here
/// is one label, not a path; building a tree nobody has asked for yet is a
/// guess, and guesses in a schema are expensive to undo.
model SharedFile {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  fileName String
  fileSize Int
  mimeType String

  /// Same shape as DocumentAttachment.storagePath - an object key, not a URL.
  storagePath String

  /// A single label, not a path. "General" when nobody chose one.
  folder String @default("General")

  description String?

  uploadedBy String?
  uploadedAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([storeId, folder])
}

/// One row per correction made to an invoice after it was issued.
///
/// The client's most-asked-for feature is editing an issued invoice, and they
/// are not wrong to want it - in a trading business a bill gets corrected the
/// same day it is written, long before it is filed. But an edit with no record
/// is the thing that has no answer at audit: "this invoice says 35,400, the
/// customer's copy says 30,000, which is right and who changed it?"
///
/// So the edit is allowed and the history is not optional. Append-only: a
/// revision row is never updated or deleted, because the one somebody wants to
/// remove is exactly the one worth keeping.
///
/// The before/after figures are stored rather than recomputed from the lines,
/// because the lines are gone - they were replaced by the edit. This row is
/// the only thing that remembers what the invoice used to say.
model InvoiceRevision {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// 2 for the first correction - version 1 is the invoice as issued.
  version Int

  /// Why. Required, because an edit without a reason is indistinguishable from
  /// someone quietly changing a number.
  reason String

  /// Plain-language lines: "Camera: qty 3 → 5", "Total up by ₹2,000".
  /// Sentences rather than a diff structure, because what anybody wants six
  /// months later is something they can read.
  changes String[]

  beforeGrandTotalPaise Int
  afterGrandTotalPaise  Int
  beforeLineCount       Int
  afterLineCount        Int

  /// The full previous line set, so the old invoice can still be reconstructed.
  /// JSON because its shape is a snapshot of history, not a live model - giving
  /// it real columns would mean migrating old snapshots every time the invoice
  /// changes shape, which defeats the point of a snapshot.
  beforeLines Json

  changedBy String?
  changedAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([invoiceId, version])
  @@index([storeId, changedAt])
}

// ================================================== RETURNS AND CREDIT NOTES
// Spec: _archive/roadmap/NEXT-SPRINT.md weeks 2-4 - the client's actual ask, and the
// open end of the pipe: today a customer returning goods has no answer at all.
//
// THE ONE DESIGN DECISION EVERYTHING ELSE FOLLOWS FROM
//
// Goods coming back and money going back are two different events, and most
// small ERPs - the reference app included - model them as one "Sales Return"
// document. That conflation is precisely why two ordinary things are
// impossible to record in it:
//
//   - a REPLACEMENT: goods come back, a new one goes out, no money moves
//   - a DAMAGE ALLOWANCE: money comes off, no goods come back at all
//
// Both are common, and in a system with one document they get faked - usually
// as a discount on the next invoice, which quietly misstates that invoice's
// GST. So they are two documents here, linked but independent:
//
//   SalesReturn  - physical. Moves stock. No tax consequence on its own.
//   CreditNote   - financial. Statutory GST document. Settles invoices.
//
// Either can exist without the other. The normal case creates both, and the
// return screen offers it in one step, so the split costs the user nothing.

/// Goods coming back from a customer.
///
/// Always against an invoice. Not a UI convenience - GST requires a credit note
/// to reference the original supply, and without the invoice line there is no
/// honest answer to "what was this sold for?", which is what the credit has to
/// be worked out from.
model SalesReturn {
  id       String @id @default(cuid())
  returnNo String
  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: Restrict)

  /// Buyer snapshot, for the same reason the invoice carries one: this document
  /// is shown to the customer, and editing a master record must never rewrite
  /// what a document said on the day it was raised.
  customerName String
  gstin        String?

  returnedAt DateTime @default(now())

  /// draft | received | cancelled
  ///
  /// Only decisions are stored, per lib/invoice-status.ts. Whether it has been
  /// credited is DERIVED from the credit notes that point at it - storing a
  /// "credited" flag is the same mistake as a stored balance, and it would go
  /// stale the first time a credit note was cancelled.
  ///
  /// Stock moves on `received`, never on `draft`. A draft is somebody typing.
  lifecycle String @default("draft")

  /// Why it came back. Drives reporting that answers "what are we getting wrong",
  /// which is the only reason to record returns beyond the accounting.
  reason String @default("other")

  /// Where the goods physically went back into. Null is the store's default
  /// holding, matching StockMovement.
  warehouseId String?

  notes String?

  receivedAt DateTime?
  receivedBy String?

  cancelledAt  DateTime?
  cancelReason String?

  items       SalesReturnItem[]
  creditNotes CreditNote[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, returnNo])
  @@index([storeId, lifecycle])
  @@index([storeId, returnedAt])
  @@index([invoiceId])
}

/// One product coming back, against the invoice line it was sold on.
///
/// `invoiceItemId` is what makes the cumulative cap possible: you may not return
/// more of a line than was invoiced on it, counting every earlier return. That
/// rule cannot be expressed against the product alone, because the same product
/// can appear on two lines of one invoice at two different prices.
model SalesReturnItem {
  id       String      @id @default(cuid())
  returnId String
  return   SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  srNo Int

  invoiceItemId String
  invoiceItem   InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)

  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  productCode String?
  hsnCode     String?

  qty Int

  /// What happened to it. This is the field the reference app has no equivalent
  /// of, and its absence is why damaged goods silently re-enter sellable stock.
  ///
  ///   restock - good, sellable, goes back on the shelf. The only value that
  ///             writes a positive stock movement.
  ///   damaged - came back, cannot be sold. Recorded, not restocked.
  ///   scrap   - destroyed or never physically returned. Recorded, not restocked.
  ///
  /// Credit is owed on all three. What was done with the goods is a separate
  /// question from what the customer is owed, and tying them is how a shop ends
  /// up refusing a credit because the item was broken.
  disposition String @default("restock")

  /// Copied from the invoice line at the time of return, so the credit is
  /// worked out from what was actually charged rather than from today's price
  /// list. The invoice line still exists and could be read - but it can be
  /// edited by editIssuedInvoice, and a return raised in March must not change
  /// value because the invoice was corrected in May.
  ///
  /// Shown on the document. Not what the credit is computed from - see below.
  unitPricePaise Int
  discountPct    Decimal @default(0) @db.Decimal(5, 2)
  taxRatePct     Decimal @default(18) @db.Decimal(5, 2)

  /// The invoice line's quantity and TAXABLE value - after the line discount
  /// and after the order-level discount apportioned to it.
  ///
  /// The credit is a proportion of these two, not a per-unit price, because a
  /// per-unit figure has to be rounded and the rounding is then multiplied by
  /// the quantity. On a line of 7 at ₹142.857 that strands rupees on the
  /// invoice permanently - an amount too small to chase and too visible to
  /// ignore, which is how a receivables report ends up with a page of ₹2
  /// balances nobody can close.
  ///
  /// Proportional credit also lets the return that exhausts a line true up to
  /// the exact remainder, so part-returns always sum back to the whole.
  invoiceLineQty          Int
  invoiceLineTaxablePaise Int

  note String?

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([returnId])
  @@index([invoiceItemId])
}

/// A statutory credit note. Section 34 of the CGST Act, not a bookkeeping note.
///
/// Three things follow from it being statutory rather than internal:
///
///  1. It carries its own document number series, unbroken and sequential.
///  2. It carries GST, at the rates of the original supply, and it is the
///     document that reduces output tax liability in GSTR-1.
///  3. Its tax mode is COPIED from the invoice and cannot be changed. An IGST
///     sale cannot be credited as CGST+SGST; that is two states' revenue.
///
/// A credit note may exist with no goods behind it - a damage allowance or a
/// price correction - which is why `salesReturnId` is optional.
model CreditNote {
  id           String @id @default(cuid())
  creditNoteNo String
  storeId      String
  store        Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation("InvoiceCreditNotes", fields: [invoiceId], references: [id], onDelete: Restrict)

  /// Set when goods came back. Null for an allowance or a price correction.
  salesReturnId String?
  salesReturn   SalesReturn? @relation(fields: [salesReturnId], references: [id], onDelete: Restrict)

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: Restrict)

  // Buyer snapshot - a tax document, same rule as the invoice.
  customerName     String
  organizationName String?
  email            String?
  phone            String?
  gstin            String?
  billingAddress   String?
  stateId          String?

  creditNoteDate DateTime @default(now())

  /// draft | issued | cancelled. Nothing settles an invoice until `issued`.
  lifecycle String @default("draft")

  /// goods_returned | damage_allowance | price_correction | short_supply
  /// | cancellation | other
  reason     String  @default("goods_returned")
  reasonNote String?

  /// Copied from the invoice. Never chosen by the user - see the model comment.
  taxMode String

  subtotalPaise     Int @default(0)
  itemDiscountPaise Int @default(0)
  taxableBasePaise  Int @default(0)
  cgstPaise         Int @default(0)
  sgstPaise         Int @default(0)
  igstPaise         Int @default(0)
  grandTotalPaise   Int @default(0)

  notes String?

  issuedAt     DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  items       CreditNoteItem[]
  allocations CreditNoteAllocation[]
  refunds     Refund[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, creditNoteNo])
  @@index([storeId, lifecycle])
  @@index([storeId, creditNoteDate])
  @@index([invoiceId])
  @@index([salesReturnId])
}

model CreditNoteItem {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  srNo Int

  /// Which invoice line this credits. Null only for an allowance that is not
  /// tied to a specific line - a freight adjustment, say.
  invoiceItemId String?

  productId   String?
  productName String
  productCode String?
  hsnCode     String?

  qty            Int
  unitPricePaise Int
  discountPct    Decimal @default(0) @db.Decimal(5, 2)
  taxRatePct     Decimal @default(18) @db.Decimal(5, 2)

  lineDiscountPaise Int
  /// Taxable value of this line - after every discount, before tax.
  lineTotalPaise    Int
  taxPaise          Int @default(0)

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([creditNoteId])
  @@index([invoiceItemId])
}

/// How much of a credit note settles which invoice.
///
/// Deliberately a mirror of ReceiptAllocation - signed, append-only, taken back
/// with a negative row rather than a delete. A credit note is an allocation
/// source in exactly the way a receipt is, and the day the general ledger
/// arrives the two post to different accounts and nothing else changes.
///
/// It is a SEPARATE table rather than a nullable `creditNoteId` on
/// ReceiptAllocation because the two answer different questions. "What did this
/// customer pay us" must never include credit notes - no money arrived - and a
/// bank reconciliation that counts them is a bank reconciliation that will not
/// balance. What an invoice is SETTLED by is the sum of both, and that sum has
/// one home: settledByInvoice() in server/credit-notes.ts.
model CreditNoteAllocation {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoiceId    String
  invoice      Invoice    @relation("InvoiceCreditAllocations", fields: [invoiceId], references: [id], onDelete: Restrict)
  storeId      String
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Signed. Negative takes an earlier allocation back.
  amountPaise Int
  reason      String?

  allocatedAt DateTime @default(now())
  allocatedBy String?

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([invoiceId])
  @@index([creditNoteId])
  @@index([storeId, allocatedAt])
}

/// Money paid back to a customer out of a credit note.
///
/// Its own model rather than a negative Receipt. A refund is cash LEAVING, and
/// folding it into the receipts table would mean every cash report, every
/// customer statement and every "what did they pay us" figure has to remember
/// to check a sign. Something eventually forgets - that is the same reasoning
/// that split Receipt from InvoicePayment in the first place.
model Refund {
  id       String @id @default(cuid())
  refundNo String
  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)

  partyId String
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Restrict)

  amountPaise Int
  refundedAt  DateTime @default(now())
  /// cash | upi | bank | cheque | card | adjustment
  method      String   @default("bank")
  reference   String?
  note        String?

  /// paid | reversed. Never deleted, same rule as a receipt.
  status         String    @default("paid")
  reversedAt     DateTime?
  reversalReason String?

  recordedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, refundNo])
  @@index([storeId, refundedAt])
  @@index([creditNoteId])
  @@index([partyId])
}

// ================================================================= CALL LOGS
// Spec: 01-product/CALL-LOG-PLATFORM.md
//
// The differentiating feature. An Android app on each employee's phone reads
// the phone's call log and posts it here; the web app turns that into "who
// called whom, and who was never called back".
//
// METADATA ONLY. Number, direction, when, how long. Never a recording - that
// is banned by Google Play policy and blocked by Android since version 10.
// Never message content - SMS permissions are not available for CRM use.

/// A phone that reports call logs.
///
/// The unit of trust is the DEVICE, not the user. A phone has no browser
/// session and no cookie, so it authenticates with a token of its own, issued
/// once at pairing and revocable from the web the moment a handset is lost or
/// an employee leaves.
model CallSyncDevice {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Whose phone. Every call it reports is attributed to this user.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Bearer token the app sends on every sync. Stored as a SHA-256 hash: a
  /// leaked database must not hand over working device credentials, and
  /// nothing ever needs to read the original back.
  tokenHash String @unique

  /// Short code shown on the web and typed into the phone once, to pair it.
  /// Cleared the moment it is used - a pairing code that stays valid is a
  /// second, weaker credential nobody remembers exists.
  pairingCode      String?   @unique
  pairingExpiresAt DateTime?

  /// What the phone told us about itself. Free text, for recognising a handset
  /// in a list - never trusted for anything.
  deviceLabel    String?
  deviceModel    String?
  androidVersion String?
  appVersion     String?

  /// THE MOST IMPORTANT COLUMN ON THIS MODEL.
  ///
  /// When a Xiaomi kills the app in the background, the manager must see "this
  /// phone has not reported for 3 days" - not "this employee made no calls".
  /// A silent gap reads as a lazy employee, and that single misreading is what
  /// destroys trust in the whole feature. Every screen that shows call counts
  /// has to show this beside them.
  lastSyncedAt      DateTime?
  /// The most recent call timestamp we have accepted, so the phone can ask for
  /// "everything after this" rather than re-uploading its whole log.
  lastCallAt        DateTime?
  /// What the last call sync did (27 Sep 2026): kept, and left out by the
  /// branch's "CRM numbers only" setting - so the Phones page can say WHY a
  /// phone that is reporting shows no calls.
  lastSyncAccepted  Int?
  lastSyncSkipped   Int?
  /// When the phone last asked for its call-sync marker (GET /api/v1/calls) -
  /// proof the app reached the call step, separate from check-ins - and the
  /// last error a call upload hit (27 Sep 2026: calls vanished silently).
  lastCallCheckAt   DateTime?
  lastCallSyncError String?
  /// The phone's own account of its last call sync (MAALIK OS 1.0.4+):
  /// { at, stage, sent?, error? } - lib/device-trust parseCallSyncState.
  callSyncState     Json?

  isActive  Boolean   @default(true)
  revokedAt DateTime?
  revokedBy String?

  pairedAt  DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  // ---- MAALIK OS device trust (roadmap §6) --------------------------------
  /// Android's ANDROID_ID (SSAID) at pairing. A different value later means a
  /// factory reset or a different phone - the phone must be paired again.
  /// Changes when the app's signing key changes (APK -> Play), by design.
  androidId          String?
  /// Last address the phone called in from. Recorded, not trusted: mobile
  /// data puts many phones behind one IP.
  lastIp             String?
  /// Latest permission / battery report from the phone, as the app sent it
  /// (location, callLog, notifications, batteryUnrestricted, ...).
  permissionState    Json?
  /// Last time Android flagged a location from this phone as mocked.
  mockLocationSeenAt DateTime?
  /// Phone clock minus server clock at the last check-in, in ms.
  clockSkewMs        Int?
  /// Google Play Integrity result, when available.
  integrityVerdict   String?
  integrityCheckedAt DateTime?
  /// Firebase Cloud Messaging token - for job pushes and the uninstall check.
  pushToken          String?
  /// When Google reported the app is no longer on the phone.
  appRemovedAt       DateTime?

  events             DeviceEvent[]
  calls              CallLog[]
  attendanceSessions AttendanceSession[]
  attendanceEvents   AttendanceEvent[]

  @@index([storeId, isActive])
  @@index([userId])
  @@index([storeId, lastSyncedAt])
}

/// One call, as the phone recorded it.
///
/// Append-only. There is no edit and no delete: this is evidence of what a
/// phone reported, and a call log a manager can quietly amend is a call log
/// nobody can rely on in a performance conversation.
model CallLog {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  deviceId String
  device   CallSyncDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// Denormalised from the device so that "calls by this person" is one index
  /// hit rather than a join. The device owns the truth; this is a copy for
  /// reading, and it is written only by the ingest path.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Which working session this call fell inside, if any.
  ///
  /// Resolved at ingest by TIME RANGE, not by "whichever session is open now".
  /// Calls arrive late - the background sync runs every 15 minutes and an OEM
  /// that killed the app can delay a batch by days - so a call made at 18:50
  /// routinely arrives after the 19:03 session end. Matching on the open
  /// session would file it under the next day, or nowhere.
  sessionId String?
  session   AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  /// True when no session covered this call. Q21, answered 7 Sep 2026.
  ///
  /// A customer ringing at 21:15 is real work and is kept - discarding it loses
  /// something the salesperson actually did, and they will notice. But it is
  /// not counted in the headline "calls today" figure, because a number that
  /// silently means "during work" for one person and "any time at all" for
  /// another is a number nobody can act on.
  ///
  /// Stored rather than derived from `sessionId == null` because those two can
  /// come apart: a deleted session sets `sessionId` to null on rows that were
  /// genuinely worked, and this flag remembers what was true at ingest.
  outsideShift Boolean @default(false)

  /// As dialled, exactly as the phone had it - with spaces, +91, whatever.
  /// Kept so a number can be read back the way the employee saw it.
  rawNumber  String
  /// Digits only, last 10 for India. This is what CRM matching compares on,
  /// because +91 98765 43210 and 09876543210 are the same customer and a
  /// string comparison says they are not.
  e164Number String

  /// outgoing | incoming | missed | rejected | blocked | unknown
  direction String

  startedAt   DateTime
  /// Seconds of connected call. Zero for missed, rejected and unanswered -
  /// which is exactly what makes "attempted but never connected" findable.
  durationSec Int      @default(0)

  /// Whether this number was in the CRM at the moment it was ingested.
  ///
  /// Recorded rather than derived because it is the reason the row was kept at
  /// all when the store is in `crm_only` mode. Which PARTY it belongs to is
  /// still resolved on read - a number that becomes a customer next month
  /// should link up retroactively, and a stored partyId would freeze it.
  matchedCrm Boolean @default(false)

  /// SHA-256 of (device + number + startedAt + duration + direction).
  ///
  /// The dedupe key, and deliberately NOT Android's own `CallLog.Calls._ID` -
  /// that id is local to the handset and is reused after a factory reset, so
  /// two genuinely different calls can carry the same one. A content hash
  /// cannot collide unless the calls really are identical.
  contentHash String

  /// When the phone sent it, as opposed to when the call happened. The gap
  /// between the two is how long the app was asleep.
  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@unique([storeId, contentHash])
  @@index([storeId, startedAt])
  @@index([storeId, userId, startedAt])
  @@index([storeId, e164Number])
  @@index([deviceId, startedAt])
  @@index([sessionId])
}

/// One working shift: an employee started work, and later stopped.
///
/// THIS IS TWO FEATURES WEARING ONE COAT, AND THAT IS THE POINT.
///
/// To the salesperson it scopes what the app collects - calls outside a shift
/// are flagged and kept out of the headline figure, so their evening is
/// visibly their own. To the manager it is **attendance**: a start time, an end
/// time and a location, captured from a phone they already carry, with no
/// biometric device and no second app.
///
/// The attendance half was not designed for. It fell out of the privacy half,
/// which is why it costs almost nothing.
/// One continuous stretch of work, from clock-in to clock-out - regardless of
/// where the clock-in came from.
///
/// RENAMED FROM `Shift`, 18 Sep 2026, TO UNIFY WEB, APP AND FUTURE SOURCES.
///
/// Until this date, a "shift" only ever meant the phone: opened from a paired
/// `CallSyncDevice`, because "a shift the employee did not start from their
/// own phone is not evidence of nothing" - and the browser's own attendance
/// button (`WebPresence`) was deliberately kept in a SEPARATE table for
/// exactly that reason, so the two kinds of evidence could never be confused.
///
/// That reasoning does not disappear here - it becomes the `source` column.
/// A session started from the paired app still carries a `deviceId` and GPS
/// from a company-issued handset; one started from the web does not, and
/// never claims to. What changes is that both are now rows in ONE ledger
/// instead of two, with `AttendanceDay` (below) as the single per-day gate
/// both surfaces read before showing a clock-in button - which is the actual
/// point: open the app after clocking in from the web, and it already knows.
model AttendanceSession {
  photos  AttendancePhoto[]
  id      String            @id @default(cuid())
  storeId String
  store   Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Which handset opened it - only ever set for `source = 'app'`. Null for
  /// web/manual/biometric: those are not phone evidence and must not look
  /// like it.
  deviceId String?
  device   CallSyncDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  /// `app` | `web` | `biometric` | `manual`. The whole reason this column
  /// exists: so a session's evidentiary weight is a fact on the row, not an
  /// inference from which table it happened to land in.
  source String

  attendanceDayId String
  attendanceDay   AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)

  startedAt DateTime
  endedAt   DateTime?

  /// Where the phone was when the shift opened and closed. Both nullable:
  /// location permission is asked for separately from call logs and may be
  /// refused, and a shift with no coordinates is still a valid shift. Refusing
  /// to start work because GPS was unavailable would be a bug, not a policy.
  startLat Decimal? @db.Decimal(9, 6)
  startLng Decimal? @db.Decimal(9, 6)
  endLat   Decimal? @db.Decimal(9, 6)
  endLng   Decimal? @db.Decimal(9, 6)

  /// Metres of uncertainty the phone reported. Kept because a fix accurate to
  /// 2 km and a fix accurate to 20 m mean completely different things, and a
  /// bare coordinate hides which one you are looking at.
  startAccuracyM Int?
  endAccuracyM   Int?

  /// Geofence result at clock-in, only ever set when the store's
  /// `AttendancePolicy.geofencingEnabled` was on at the time. Null means "not
  /// checked" (the feature was off), never "failed silently".
  startWithinPolicy  Boolean?
  startMatchedZoneId String?
  startDistanceM     Int?

  /// TRUE WHEN NOBODY PRESSED END SHIFT AND THE SERVER CLOSED IT.
  ///
  /// People forget. Phones die. Without this, one forgotten shift stays open
  /// for a week and silently swallows every personal call the employee makes
  /// in the evenings - turning the privacy promise inside out and doing it
  /// invisibly, which is the worst way for a promise to fail.
  ///
  /// So a shift open longer than `SHIFT_MAX_HOURS` is closed automatically,
  /// and marked. An auto-closed shift is NOT attendance evidence: it says the
  /// person started work and never said they stopped. Payroll must treat it as
  /// a question, not an answer, which is exactly why it needs its own column
  /// rather than a guessed `endedAt` that looks like every other one.
  autoClosed Boolean @default(false)

  /// A MANAGER SAID WHAT TIME THIS ACTUALLY FINISHED.
  ///
  /// I originally refused to build this. The reasoning was that a shift a
  /// manager can type in is evidence of nothing - and that half is right. What
  /// it missed is that people forget to press End Shift, and without a
  /// correction the record is stuck reading "unknown" for ever. An unfixable
  /// wrong record is not more trustworthy than a corrected one; it is just
  /// wrong and permanent, and it makes the whole screen useless for payroll.
  ///
  /// So the correction exists, and it is kept SEPARATE from `endedAt` rather
  /// than overwriting it. That distinction is the entire point: anyone reading
  /// this row can still see the machine's version and the human's version side
  /// by side, along with who changed it and why. A correction that overwrote
  /// the original would be indistinguishable from a real clock-off, which is
  /// exactly the thing that must never happen to a wage record.
  correctedEndedAt DateTime?
  correctedBy      String?
  correctedAt      DateTime?
  correctionReason String?

  /// Free text from the employee. Optional, and never required to end a shift:
  /// a mandatory note is a note that says "work" every day.
  note String?

  calls  CallLog[]
  events AttendanceEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Finding the open session for a device, which happens on every sync.

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@index([storeId, userId, startedAt])
  @@index([storeId, startedAt])
  @@index([attendanceDayId])
  @@index([deviceId, endedAt])
}

/// Where somebody was, sampled while their phone was already awake.
///
/// RENAMED FROM `LocationPing`, 18 Sep 2026 - same shape, now shared by
/// whatever source produces a location fix, not only the paired app.
///
/// NEVER POLLED ON A TIMER OF ITS OWN, for the app source. A fix is taken at
/// session start, at session end, and alongside each call sync - moments
/// when the device is awake and talking to us anyway. Continuous GPS
/// tracking would flatten the battery by mid-afternoon, and an employee
/// whose phone dies at 15:00 uninstalls the app by Friday. The feature that
/// kills the battery is the feature that gets removed.
///
/// Accuracy is deliberately coarse - balanced-power, wifi and cell towers,
/// roughly 100 m. That answers "was Rahul at the industrial area or at home?",
/// which is the question a manager actually has. It does not answer "which
/// door was he standing at", and the product must not be sold as if it does.
model AttendanceEvent {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   CallSyncDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  /// Null for a fix taken outside any session - which should be rare, since
  /// the app only reports while a session is open, but a clock skew or a
  /// session that closed mid-sync can produce one. Kept rather than dropped
  /// so the gap is visible instead of mysterious.
  sessionId String?
  session   AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  lat       Decimal @db.Decimal(9, 6)
  lng       Decimal @db.Decimal(9, 6)
  accuracyM Int?
  /// Android flagged this fix as simulated ("fake GPS") - kept, shown red.
  mocked    Boolean @default(false)
  /// Metres per second, when the phone reported it.
  speedMps  Float?

  /// `session_start` | `session_end` | `sync` | `manual` | `field_check_in`
  source String

  /// When a field check-in is against a specific complaint's fixed location -
  /// set only for `source = 'field_check_in'`.
  complaintId String?

  /// When the phone took the fix, which is not when we received it.
  recordedAt DateTime
  createdAt  DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([storeId, userId, recordedAt])
  @@index([sessionId, recordedAt])
}

/// The single per-user, per-day attendance gate - what both the web button
/// and the app check before showing "clock in" vs "already marked, via X at
/// H:MM". Added 18 Sep 2026 as the unification point for `AttendanceSession`
/// (any source) and, going forward, the sole thing `hrns-bridge.ts` pushes.
///
/// One row per person per day, same shape as the `WebPresence` table this
/// supersedes for new writes - `WebPresence` itself is kept, untouched, as a
/// historical record of presence-button presses made before this existed.
model AttendanceDay {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// `2026-09-18`, resolved in Asia/Kolkata - a label for a business day, not
  /// an instant, same reasoning as `WebPresence.workDate`.
  workDate String

  firstInAt     DateTime?
  /// `app` | `web` | `biometric` | `manual` - whichever source produced the
  /// day's first clock-in. This is the column the Attendance Grid's new
  /// Source indicator reads.
  firstInSource String?
  lastOutAt     DateTime?
  lastOutSource String?

  /// Maintained projection - the sum of `workedMinutes` across this day's
  /// sessions, recomputed inside the same transaction as any session change.
  /// Same ledger-then-projection split as `StockMovement` -> `ProductBalance`.
  /// Null, not zero, when nothing is closed yet to sum - matches
  /// `workedMinutes()` in lib/shift.ts returning null for "unknown", not "0".
  workedMinutes Int?
  status        String @default("not_marked") // not_marked | in_progress | completed

  /// ---------------------------------------------------------------------
  /// THE BRIDGE TO ATLAS-HRNS - moved here from the old per-session columns
  /// on `Shift`, 18 Sep 2026. HRNS keeps one attendance row per person per
  /// day; this table already IS that grouping, so the bridge no longer needs
  /// to fold several session rows together before it can push - see the
  /// comment on the old columns' history in PLATFORM-COMPLETION.md if this
  /// needs re-deriving.
  hrnsAttendanceId String?
  hrnsSyncedAt     DateTime?
  hrnsError        String?

  sessions AttendanceSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workDate])
  @@index([storeId, workDate])
}

// ===========================================================================
// PURCHASE
//
// The keystone. Four other things were blocked behind it: payables, the
// supplier ledger, true stock cost, and every financial report - a profit and
// loss statement with no purchases in it is a list of revenue.
//
// DELIBERATELY NOT BUILT YET: purchase orders and goods receipt notes. A shop
// this size usually receives goods WITH the supplier's bill, and modelling the
// three-way match (order → receipt → bill) before anyone has asked for it would
// be three documents where one is doing the work. `PO` and `GRN` already exist
// as document-number types for when that changes.
// ===========================================================================

/// A supplier's bill. What we bought, what it cost, and what we now owe.
///
/// The mirror of `Invoice`, and deliberately shaped like one - same integer
/// paise, same tax breakdown, same lifecycle, same cached settlement column.
/// Somebody who understands invoices should not have to learn a second set of
/// rules to understand purchases.
///
/// WHERE IT IS NOT A MIRROR
///
/// The tax on a purchase is INPUT tax, which is money the business gets back
/// from the government rather than money it collects for them. The arithmetic is
/// identical and the meaning is opposite, which is why the GST report has to
/// keep the two apart and why these columns are not merged with the invoice's.
model PurchaseBill {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  /// Ours, for filing. `PB-BR001-2026-0001`.
  billNo String

  /// THE SUPPLIER'S OWN NUMBER, AND THE ONE THAT ACTUALLY MATTERS.
  ///
  /// Their invoice number is what goes on the GST return, what they quote when
  /// chasing payment, and what an auditor matches against. Ours is a filing
  /// convenience. Required, therefore, and unique per supplier - the same bill
  /// entered twice is the single most common way a payables ledger goes wrong,
  /// and it looks exactly like an ordinary purchase.
  supplierBillNo String

  partyId String
  party   Party  @relation(fields: [partyId], references: [id])

  /// Supplier snapshot at the time of the bill. A supplier's GSTIN may change;
  /// a filed bill must not change with it.
  supplierName String
  gstin        String?
  stateId      String?

  billDate DateTime
  dueDate  DateTime

  /// draft | received | cancelled
  ///
  /// Nothing happens on `draft` - no stock, no payable, no cost history. All
  /// three land together when it moves to `received`, in one transaction, so a
  /// half-posted bill cannot exist.
  lifecycle String @default("draft")

  /// HAVE THE GOODS ARRIVED? (28 Oct 2026, Vcare) - asked once, when the
  /// bill is entered, so stock moves exactly once:
  ///   received    arrived with the bill - posting makes its receipt (with the
  ///               serials typed on the lines)
  ///   on_receipt  already received on a goods receipt - posting moves no
  ///               stock; the receipt carries `billedOnId`
  ///   awaited     still to come - posting books what is owed only; the store
  ///               receives against the bill later, and it becomes `received`
  goodsStatus    String             @default("received")
  /// Receipts this bill pays for that were received before it (on_receipt).
  billedReceipts GoodsReceiptNote[] @relation("GrnBilledOn")

  /// Charges the supplier added that are not a line item.
  freightPaise Int @default(0)

  subtotalPaise     Int    @default(0)
  itemDiscountPaise Int    @default(0)
  taxableBasePaise  Int    @default(0)
  cgstPaise         Int    @default(0)
  sgstPaise         Int    @default(0)
  igstPaise         Int    @default(0)
  grandTotalPaise   Int    @default(0)
  taxMode           String @default("IGST")

  /// A CACHE OF WHAT WE HAVE PAID, NOT THE TRUTH.
  ///
  /// The truth is the sum of live allocations. This column exists so that "show
  /// me every unpaid bill" is one indexed query rather than a join across every
  /// payment ever made, and it is kept in step inside the same transaction as
  /// every allocation change. Nothing else may write it.
  amountPaidPaise Int @default(0)

  notes String?

  cancelledAt  DateTime?
  cancelReason String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items           PurchaseBillItem[]
  allocations     SupplierPaymentAllocation[]
  purchaseReturns PurchaseReturn[]
  debitNotes      SupplierDebitNote[]

  /// The same supplier bill number twice is a duplicate, and duplicates in
  /// payables are how a business pays twice. Enforced rather than warned about.

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, partyId, supplierBillNo])
  @@unique([storeId, billNo])
  @@index([storeId, lifecycle, billDate])
  @@index([storeId, partyId])
  @@index([storeId, dueDate])
}

model PurchaseBillItem {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  billId String
  bill   PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  srNo Int

  /// Null for something bought that is not a catalogued product - a repair, a
  /// delivery charge, a one-off. Those must still reach the profit and loss
  /// statement, so a bill line does not require a product.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  /// Snapshot, like every other document line in this product. What the bill
  /// said is what the bill said, even after the catalogue is renamed.
  productName String
  productCode String?
  hsnCode     String?

  qty           Int
  /// Serials typed or scanned on the bill line (28 Oct 2026) - they become
  /// the units' identities when the goods are received; fewer than the
  /// quantity and the rest get house tags.
  serials       String[] @default([])
  /// Excluding tax, before discount. Integer paise.
  unitCostPaise Int
  discountPct   Decimal  @default(0) @db.Decimal(5, 2)
  taxRatePct    Decimal  @default(18) @db.Decimal(5, 2)

  lineDiscountPaise Int @default(0)
  /// Taxable value of this line, after its discount. Snapshot of a computed
  /// figure at the moment the bill was posted - not a running aggregate.
  lineTotalPaise    Int @default(0)

  /// Whether this line put stock in.
  ///
  /// Recorded rather than derived from `productId != null`, because a service
  /// line carries a product too and moves nothing. Reading it back later must
  /// not require re-deriving a decision made under rules that may since have
  /// changed.
  movedStock Boolean @default(false)

  returnItems PurchaseReturnItem[]

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([billId])
  @@index([storeId, productId])
}

/// The one thing that may increase inventory QUANTITY (RULE 2, D011 decision
/// log: "a Purchase Bill must never mutate inventory quantity directly - all
/// quantity changes occur through explicit Inventory Movements. A GRN/Receipt
/// is the inbound stock movement; direct purchases automatically create a
/// linked receipt behind the scenes.").
///
/// `PurchaseBill.postBill` still posts the FINANCIAL entry (Inventory value,
/// GST, Accounts Payable) - that has not changed. What moved here is only the
/// physical quantity: `postBill` now creates and posts a GRN behind the
/// scenes (`sourceBillId` set, no manual entry) for a bill with no PO, which
/// is the common case for a shop with no PO discipline. A GRN entered by hand
/// against a `PurchaseOrder` supports partial delivery the same way a Goods
/// Dispatch Note does on the sales side - quantity received against a PO
/// line accumulates on `PurchaseOrderItem.receivedQty`.
///
/// DEFERRED, ON PURPOSE: the true three-way match (a GRNI clearing account
/// for goods received before any bill exists, or a bill posted with no goods
/// yet). Today a bill and its receipt are always created together, in one
/// atomic step - there is no workflow yet for the timing gap either
/// direction, and building the clearing-account mechanics for a gap nothing
/// can currently create would be speculative. See PLATFORM-COMPLETION.md.
model GoodsReceiptNote {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  grnNo String // GRN-BR001-2026-0001

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  partyId      String
  party        Party  @relation(fields: [partyId], references: [id])
  supplierName String

  receivedDate DateTime @default(now())

  /// The supplier's own invoice number for this delivery - the number THEY
  /// quote when a unit comes back under their warranty. Optional because a
  /// delivery can arrive ahead of its paperwork.
  supplierInvoiceNo String?

  /// The receipt's number in the system it was migrated from. Null on anything
  /// Atlas issued. See `Complaint.legacyRef`.
  legacyRef String?

  /// draft | posted | cancelled. Nothing moves on `draft` - same rule as
  /// `PurchaseBill.lifecycle`, for the same reason: a half-posted receipt
  /// must not be possible.
  status String @default("draft")

  /// Set only on a receipt this app created for itself, behind a purchase
  /// bill with no PO - never set on one a person filled in by hand. Lets
  /// `cancelBill` find and reverse the right receipt without a second lookup
  /// table, and keeps an auto-created row visibly distinct from a real GRN.
  sourceBillId String?
  /// The bill that pays for this receipt, when the goods came first and the
  /// bill after (28 Oct 2026). Unlike `sourceBillId` (a receipt the bill
  /// made), cancelling that bill leaves this receipt - the goods are here -
  /// and only unlinks it.
  billedOnId   String?
  billedOn     PurchaseBill? @relation("GrnBilledOn", fields: [billedOnId], references: [id], onDelete: SetNull)

  notes String?

  cancelledAt  DateTime?
  cancelReason String?

  items GoodsReceiptNoteItem[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, grnNo])
  @@index([storeId, status])
  @@index([storeId, receivedDate])
  @@index([storeId, purchaseOrderId])
  @@index([storeId, legacyRef])
  @@index([billedOnId])
}

model GoodsReceiptNoteItem {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  grnId String
  grn   GoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)

  /// Which PO line this receives against, for partial-delivery tracking.
  /// Null for a receipt with no PO behind it at all.
  purchaseOrderItemId String?

  srNo Int

  /// Bare id, no relation - same reasoning as `PurchaseOrderItem.productId`.
  productId   String?
  productName String
  productCode String?

  qty           Int
  /// Excluding tax. The PO's price if this came from one, or the bill's
  /// unit cost if this is an auto-created receipt behind a bill - either
  /// way, an estimate until the bill (if not already known) sets the real
  /// landed cost.
  unitCostPaise Int

  /// The GST rate on the supplier's bill for this line. Recorded, not
  /// computed - the bill is the supplier's document and this is what it said.
  taxRatePct Decimal? @db.Decimal(5, 2)

  /// THE SUPPLIER'S warranty to us, in months from `receivedDate`.
  ///
  /// Not the customer's warranty: that is `Product.warrantyMonths`, counted
  /// from the sale. The two differ in practice - a DVR can be two years from
  /// the manufacturer and one to the customer - and they answer different
  /// questions: this one is "can we send it back", that one is "do we have to
  /// fix it free". Expiry is derived with lib/expiry `addMonths`, never stored.
  warrantyMonths Int?

  /// Arrived refurbished rather than new. Copied onto each unit as its
  /// starting condition; the unit's own history takes over from there.
  isRefurbished Boolean @default(false)

  /// For a `batch` product: the lot this line brought in, and its dates as
  /// printed on the pack. The lot row itself is `StockLot`.
  lotNo      String?
  mfgDate    DateTime?
  expiryDate DateTime?

  units StockUnit[]
  lots  StockLot[]

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([grnId])
  @@index([storeId, productId])
}

/// A LOT of a `batch`-tracked product: one delivery's worth, with its own cost
/// and dates. A pharmacy's strip of tablets, a food business's crate.
///
/// Built now although the first migrated tenant needs none of it. It is what
/// makes the framework serve a trade with expiry dates, and adding a third
/// tracking mode later would mean touching every query that reads stock.
///
/// QUANTITY IS NOT STORED HERE. What is left of a lot is the sum of the stock
/// movements that name it - the same ledger rule as everything else (CLAUDE.md
/// decision 5). A `qtyRemaining` column would be a second balance to drift.
model StockLot {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// The number printed on the pack. Unique per product within a store, so a
  /// second delivery of the same lot adds to it rather than splitting it.
  lotNo String

  /// The receipt line that first brought this lot in. Null for opening stock.
  grnItemId String?
  grnItem   GoodsReceiptNoteItem? @relation(fields: [grnItemId], references: [id])

  unitCostPaise Int?
  mfgDate       DateTime?
  expiryDate    DateTime?
  receivedAt    DateTime

  movements StockMovement[]

  createdBy String?
  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@unique([storeId, productId, lotNo])
  @@index([storeId, expiryDate])
}

/// ONE PHYSICAL UNIT of a `serial`-tracked product - a camera, a DVR, a switch.
///
/// The same table for every client; nothing in it belongs to any trade. What a
/// trade needs beyond this - a MAC address, a lens size, engine hours - lives
/// in `customFields`, defined per store by `StockFieldConfig`, so a client adds
/// "MAC address" themselves without a schema change.
///
/// WHAT IS DELIBERATELY NOT STORED
///
/// Warranty expiry, whether an AMC covers it, which supplier sent it and on
/// what invoice: all DERIVED - from `warrantyMonths` plus the sale date via
/// lib/expiry, from `resolveCoverage` against the holder's contracts, and from
/// the receipt line. `Party.currentBalancePaise` drifted negative by exactly
/// every payment ever made; a stored warranty expiry would drift the moment a
/// product's warranty was corrected.
model StockUnit {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// The serial or barcode. NULL IS A PLACEHOLDER: the unit arrived and is on
  /// the shelf, and its serial is still to be typed in - "50 arrived, serials
  /// to follow". Postgres treats NULLs as distinct, so the unique index below
  /// allows any number of placeholders while refusing a duplicate serial.
  serialNo String?

  /// WHERE THIS UNIT'S NUMBER CAME FROM: vendor | house | migrated.
  ///
  /// Added 2 Oct 2026 with Rule 1 (see 09-documentation/03-specs/
  /// STOCK-IDENTITY-SPEC.md): every item received now gets a unit, so a line
  /// of ten cameras with three serials typed no longer creates three units and
  /// seven unnamed items on the shelf. The other seven get a house tag Atlas
  /// issued itself, and this column is how anyone can tell them apart.
  ///
  ///   vendor    the maker's serial, read off the item
  ///   house     Atlas generated it because there was none to read
  ///   migrated  came in with historical data; trust it, never re-issue it
  ///
  /// It matters because the three behave differently: a vendor serial is what
  /// a supplier will quote on a warranty claim, a house tag only means
  /// something inside this business, and a migrated one may be either.
  identitySource String @default("vendor")

  /// in_stock | reserved | with_customer | with_supplier | scrapped | lost.
  /// Transitions and their stock effect live in lib/stock-units, with tests.
  status String @default("in_stock")

  /// new | refurbished. A CONDITION, not a state: a refurbished unit can be on
  /// the shelf or at a customer's site, so it is a second axis rather than a
  /// seventh status. `StockUnitEvent` holds the history that made it so.
  condition String @default("new")

  /// Who holds it: the customer when `with_customer`, the supplier when
  /// `with_supplier`, null when it is ours. One column rather than two, read
  /// through the status, so a unit cannot claim two holders at once.
  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id])

  /// The invoice that sold it, once one did.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  /// The receipt line it arrived on - which gives the supplier, the supplier's
  /// invoice number, the arrival date and the supplier's warranty. Null only
  /// for opening stock, which by definition arrived before the system did.
  grnItemId String?
  grnItem   GoodsReceiptNoteItem? @relation(fields: [grnItemId], references: [id])

  /// What THIS unit cost. Usually the receipt line's cost; held per unit
  /// because serialised stock is what makes actual cost per unit possible, and
  /// opening stock has no receipt line to read it from.
  unitCostPaise Int?
  receivedAt    DateTime

  /// The customer warranty for this unit, when it differs from the product's.
  /// Null - the normal case - means `Product.warrantyMonths`.
  warrantyMonths Int?
  /// A FRESH warranty from this day (10 Oct 2026, repair flow stage 6): a
  /// supplier's new serial, or a unit from our stock given in place of one the
  /// supplier kept, is covered in full from the day it is handed over
  /// (decision 4). Null - the normal case - counts from the sale or install.
  warrantyFrom   DateTime?

  /// Values for this store's `StockFieldConfig` fields, keyed by `fieldKey`.
  customFields Json?

  legacyRef String?
  note      String?

  events         StockUnitEvent[]
  movements      StockMovement[]
  challanItems   InstallationChallanItem[]
  replacements   ReplacementCase[]
  complaintItems ComplaintItem[]
  /// Cases this unit was the supplier's new serial for (stage 5).
  replacedFor    ReplacementCase[]         @relation("RmaReplacementUnit")

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  /// WHERE THIS ITEM PHYSICALLY IS. Added 2 Oct 2026.
  ///
  /// `status` says what has become of a unit - on the shelf, with a customer,
  /// scrapped. It cannot say WHICH shelf, and once a technician's van is a
  /// warehouse that distinction matters: a camera in Tikam's van is `in_stock`,
  /// because it has not been sold and has not left the business, and a picker
  /// offering it to the counter would be offering something nobody at the
  /// counter can reach.
  ///
  /// Null means the main warehouse, the same convention `ProductBalance` and
  /// `StockMovement` already use for a store with no warehouses configured.
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@unique([storeId, productId, serialNo])
  @@index([storeId, serialNo])
  @@index([storeId, status])
  @@index([storeId, productId, status])
  @@index([storeId, identitySource])
  @@index([partyId])
}

/// Everything that ever happened to a unit, append-only. The unit row says
/// where it is now; this says how it got there - including the repair that
/// turned it from new to refurbished.
model StockUnitEvent {
  id      String @id @default(cuid())
