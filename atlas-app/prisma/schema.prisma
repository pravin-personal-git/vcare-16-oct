  /// invoice | receipt | purchase_bill | supplier_payment | credit_note |
  /// sales_return | refund | opening_balance | reversal | manual
  sourceType String
  sourceId   String?

  /// Set on a REVERSAL entry: which entry it reverses. Unique, because at
  /// most one reversal may exist per original - reversing a reversal is a
  /// new correction, posted forward, not a second reversal of the same one.
