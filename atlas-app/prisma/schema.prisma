/// THE `delegate` QUEUE (D16).
///
/// When a client hides a flow step with fallback `delegate`, the work does not
/// vanish - it moves. A technician who may no longer raise a parts challan taps
/// "Request parts" and this row is what the store sees. Without it, hiding the
/// step would strand the job, which is the failure the fallback rule exists to
/// prevent.
///
/// `assignedTo` is nullable on purpose: requests route by PERMISSION, not by a
/// named person (spec §9 q3), so they survive someone leaving. A row is claimed
/// when somebody acts on it.
model StepRequest {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// The flow step that was hidden, e.g. `job.challan`.
  stepKey String

  /// What it is about - `complaint`, `invoice`... plus its id, so this table
  /// needs no foreign key per document type.
  refType String
  refId   String

  /// The permission that decides who may act on it, copied from the step's
  /// `delegateTo` at creation so a later registry change cannot orphan the row.
  needsPermission String

  note String?

  requestedById String
  requestedBy   User   @relation("StepRequestRequester", fields: [requestedById], references: [id])

  /// open | done | cancelled. Nothing is deleted (AGENTS.md §4).
  status String @default("open")

  assignedToId String?
  assignedTo   User?   @relation("StepRequestAssignee", fields: [assignedToId], references: [id])

  resolvedAt DateTime?
  /// Why it was cancelled - required when status becomes `cancelled`.
  reason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@index([storeId, status, createdAt])
  @@index([refType, refId])
}

// ------------------------------------------------------------- F2: NUMBERING
// 30 Sep 2026 - F2-SYNC-FOUNDATION-SPEC.md §4.3, decision D10.

/// A RANGE OF DOCUMENT NUMBERS ONE NODE OWNS.
///
/// `DocumentSequence` hands out invoice numbers by incrementing a row inside a
/// transaction against one database. Two offices doing that offline would both
/// issue INV-BR001-2026-0042. That is not a merge conflict to be resolved
/// later - it is a tax problem, because a GST series must be sequential and
/// unbroken.
///
/// So the hub stays the only allocator: it advances `DocumentSequence` by the
/// block size and hands the node this range. A node issues from its own block
/// and never touches the sequence, which makes offline numbering a local,
/// lock-free operation with no way to collide.
///
/// Unused numbers at year end are not a bug. They are the gap register, which
/// is acceptable to an auditor *when documented* - a gap nobody can explain is
/// the thing that gets asked about.
model NumberBlock {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Matches `DocType` in server/document-number.ts - INV, QT, JCH...
  docType       String
  /// 2026 => FY Apr 2026 - Mar 2027.
  financialYear Int

  /// Inclusive range this node owns.
  fromSeq Int
  toSeq   Int
  /// The next number not yet issued. Past `toSeq` means the block is spent.
  nextSeq Int

  /// Which node holds it. Null while the hub holds one for its own use.
  nodeId String?

  issuedAt    DateTime  @default(now())
  exhaustedAt DateTime?

  @@unique([storeId, docType, financialYear, fromSeq])
  @@index([storeId, docType, financialYear, nodeId])
}

/// ONE PUNCH, EXACTLY ONCE (F2.5, ATTENDANCE-CAPTURE-SPEC.md).
///
/// Before this, nothing recorded a punch individually. Replay safety rested
/// entirely on `clockIn` being idempotent for TODAY, which does not hold for a
/// batch that is three days old - and a three-day-old batch is precisely what
/// arrives when a reader has been offline. Re-sending it would have reopened
/// and closed sessions in the past.
///
/// `externalId` is the vendor's own id where it has one. The fallback key
/// (device + person + second) is right except when two people punch the same
/// reader in the same second, which is why the vendor id is preferred.
///
/// Rows are kept even when they cannot be matched to a person: attendance that
/// silently disappears is worse than attendance sitting in a queue.
/// WHOSE CODE IS THAT, REMEMBERED (14 Oct 2026, Vcare). A biometric machine
/// sends a number ("1"), not a name. Mapping a number to a person used to
/// stamp only the punches already received; the next punch from the same
/// number arrived unmapped again. This row is the answer kept for good, per
/// branch: ingest consults it before the user-code match. `userId` null =
/// the mapping was undone (kept rather than deleted, so remapping is an
/// update and the history stays in the audit trail).
model AttendanceCodeMap {
  id           String  @id @default(cuid())
  storeId      String
  store        Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  employeeCode String
  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  mappedBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  version      Int       @default(1)
  originNodeId String?
  deletedAt    DateTime?
  deletedBy    String?

  @@unique([storeId, employeeCode])
}

model AttendancePunch {
  id       String           @id @default(cuid())
  storeId  String
  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deviceId String
  device   AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// The natural key - see `punchKey` in lib/attendance-capture/contract.
  punchKey String

  /// The code as the VENDOR knows it, before mapping.
  employeeCode String
  /// Null until the code is mapped to somebody. Not an error - a queue.
  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  punchAtUtc DateTime
  /// in | out
  direction  String
  /// True when `first_last` decided this rather than the vendor.
  inferred   Boolean  @default(false)

  verifyType  String?
  terminalRef String?
  externalId  String?

  /// Everything the vendor sent, for when a punch is disputed.
  raw Json?

  /// Set once the punch has been turned into a session. Null means it is
  /// stored but not yet counted - usually waiting for a person to map to.
  appliedAt DateTime?

  ingestedAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@unique([deviceId, punchKey])
  @@index([storeId, punchAtUtc])
  @@index([storeId, employeeCode, punchAtUtc])
  @@index([deviceId, appliedAt])
}

/// A CLOCK-IN PHOTO. NOT A FACE SCAN (F2.5, decision D14).
///
/// The phone's front camera takes a picture at clock-in and it is shown to the
/// supervisor beside the attendance row. There is no enrolment, no template
/// and no matching - so Atlas stores no biometric data, and this table has no
/// column that could hold any.
///
/// That is a decision, not an omission. Under DPDP 2023 a face template is
/// sensitive personal data; holding one for twenty clients would make us its
/// processor, with consent, purpose-limitation and breach duties attached. A
/// timestamped photo inside a geofence delivers most of the deterrence for
/// none of that exposure - and unlike a matcher it cannot lock a genuine
/// employee out because the light was bad.
///
/// The bytes live in the private Supabase bucket, same as every other
/// attachment: a public URL for a photograph of somebody's face, working, is
/// exactly the link you do not want leaking into a chat or a screenshot.
model AttendancePhoto {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The session this photo belongs to, where one was open. Null for a photo
  /// taken against a punch the server refused - kept, because "he says he
  /// clocked in" is exactly when the picture matters.
  sessionId String?
  session   AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  /// in | out
  direction String

  /// The object key in the private bucket - never a URL. A signed link is
  /// minted per request for somebody who already holds a session.
  storagePath String

  /// Where the phone said it was, so the photo and the fix travel together.
  lat       Decimal? @db.Decimal(9, 6)
  lng       Decimal? @db.Decimal(9, 6)
  accuracyM Int?
  /// Android flagged the location as simulated. Shown red beside the photo.
  mocked    Boolean  @default(false)

  /// When the picture was taken, from the phone. Not when we received it - a
  /// photo queued offline is evidence of the moment it was taken.
  capturedAt DateTime

  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([storeId, userId, capturedAt])
  @@index([sessionId])
}

/// A customer's review of a product on the shop (5 Oct 2026, Pravin: "reviews
/// hone chahiye har item pr, admin ke side se manageable"). Written by a
/// signed-in customer (registered on the shop); shown only once the business
/// approves it in Catalogue > Reviews. One review per customer per product -
/// writing again replaces it and sends it back for approval.
model ProductReview {
  id        String           @id @default(cuid())
  storeId   String
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  listingId String
  listing   CatalogueListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  partyId   String?
  party     Party?           @relation(fields: [partyId], references: [id], onDelete: SetNull)

  /// As it will show - the customer's first name, never their phone.
  authorName String
  /// 1 to 5.
  rating     Int
  body       String?
  /// pending | approved | hidden.
  status     String    @default("pending")
  /// The business's public answer, shown under the review.
  reply      String?
  decidedBy  String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  // ---- sync (F2) ----
  version      Int       @default(1)
  originNodeId String?
  deletedAt    DateTime?
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@unique([listingId, partyId])
  @@index([storeId, status, createdAt])
  @@index([listingId, status])
}

/// A product saved for later on the shop - the heart (5 Oct 2026). Works
/// without signing in (by the shop's session key); a signed-in customer's
