/// A FAULTY ITEM SENT BACK FOR REPAIR OR REPLACEMENT - "where is my camera".
///
/// Tracks the physical journey: out to a supplier or service centre, by which
/// courier and docket, when it is expected, when it actually came back, when
/// the customer got it, and what happened to the faulty item. A case can
/// follow another (`parentCaseId`) for an item that comes back faulty twice.
///
/// Not a financial document - SalesReturn and PurchaseReturn are those. When
/// a serialised unit is attached, the unit's own status moves with the case
/// (with_supplier on the way out, back again on return), so the stock table
/// and this tracker tell the same story. Statuses and transitions: lib/rma.ts.
model ReplacementCase {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  caseNo    String
  legacyRef String?

  /// open | sent | received_back | returned_to_customer | closed | cancelled
  status String @default("open")

  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  /// Denormalised, like every other document line: what it was called then.
  productName String
  brandModel  String?
  qty         Int      @default(1)
  /// The serial as written on the paperwork, even when no unit is attached.
  serialNo    String?

  stockUnitId String?
  stockUnit   StockUnit? @relation(fields: [stockUnitId], references: [id], onDelete: SetNull)

  customerId        String?
  customer          Party?            @relation("RmaCustomer", fields: [customerId], references: [id])
  complaintId       String?
  complaint         Complaint?        @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  /// The complaint item this case is the supplier's half of (stage 3, 10 Oct 2026).
  complaintItemId   String?
  complaintItem     ComplaintItem?    @relation(fields: [complaintItemId], references: [id], onDelete: SetNull)
  /// The box it went out in (stage 4, 10 Oct 2026) - one dispatch carries many cases.
  dispatchId        String?
  dispatch          SupplierDispatch? @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  /// This case's share of the dispatch's courier charge - and of the return
  /// courier when it comes back on a receipt that cost something (stage 5).
  courierSharePaise Int?

  /// THE SUPPLIER'S ANSWER (stage 5, 10 Oct 2026), before anything comes back:
  /// repair | replace | credit | cannot_repair, with their quote when they
  /// charge for it. A chargeable item's estimate is drafted from the quote.
  supplierAnswer     String?
  supplierQuotePaise Int?
  supplierAnswerNote String?
  supplierAnswerAt   DateTime?
  /// The RMA receipt it came back on, when something physical came back.
  receiptId          String?
  receipt            RmaReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  /// The supplier's new unit, when they sent a new serial for the customer's.
  replacementUnitId  String?
  replacementUnit    StockUnit?  @relation("RmaReplacementUnit", fields: [replacementUnitId], references: [id], onDelete: SetNull)
  /// What closed it with nothing coming back: credit_note | written_reply.
  closedOn           String?
  /// The supplier's written reply - their reference and what it said.
  supplierReplyRef   String?

  supplierId    String?
  supplier      Party?  @relation("RmaSupplier", fields: [supplierId], references: [id])
  /// Free text when the item goes somewhere that is not a supplier on file.
  supplierName  String?
  serviceCentre String?
  courier       String?
  docketNo      String?

  sentAt               DateTime?
  expectedBackAt       DateTime?
  receivedBackAt       DateTime?
  returnedToCustomerAt DateTime?

  /// repaired | replaced | refurbished_to_stock | scrapped | credit_note
  outcome             String?
  replacementSerialNo String?
  /// The supplier's credit note for this item (outcome credit_note): their
  /// number and the amount, posted to the supplier's account (28 Sep 2026).
  creditNoteNo        String?
  creditAmountPaise   Int?
  /// When an old unit from a job came back into stock (replaced / repaired) -
  /// set once so it is never booked twice.
  stockBookedAt       DateTime?

  parentCaseId String?
  parentCase   ReplacementCase?  @relation("RmaChain", fields: [parentCaseId], references: [id], onDelete: SetNull)
  childCases   ReplacementCase[] @relation("RmaChain")

  /// The replaced old unit from a job, when this case started there.
  jobOldUnits FaultyPartReturn[]
  events      ReplacementEvent[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, caseNo])
  @@index([storeId, status])
  @@index([storeId, docketNo])
  @@index([stockUnitId])
}

