  rewardPoints        Int       @default(0)
  currentBalancePaise Int       @default(0) // positive = they owe us
  dueDate             DateTime?

  /// Set by hand from the Customer Account screen - "call them back about this
  /// balance on [date]". Not derived from anything; there is no document that
  /// implies a follow-up is due.
  followUpDate DateTime?
  /// Set by hand, same screen. Excludes the account from being chased as
  /// normal collections - the balance itself is untouched, this is a flag,
  /// not a write-off.
  isBadDebt    Boolean   @default(false)

  // ---- supplier-side
  supplierType     String? // product | service
  payablePaise     Int     @default(0) // positive = we owe them
  paymentTermsDays Int     @default(0)
  bankAccountNo    String?
  bankIfsc         String?
  bankName         String?

  status String @default("active") // active | dormant

  lastPurchaseAt      DateTime?
  lastCommunicationAt DateTime?

  // ---- customer portal login. Off by default - a staff member turns it on
  // per party from the customer record, which is also where the one-time
  // temporary password is shown. Nothing here is ever set by the portal
  // itself except the hash on a password change.
  /// THEY MADE THIS ACCOUNT THEMSELVES. Added 3 Oct 2026.
  ///
  /// Everything else under `portal*` is switched on by a staff member for
  /// somebody who is already a customer. Decision 9 opens a second door: a
  /// visitor browsing the shop can register in order to ask for something, and
  /// they are not a customer yet - nobody has met them, nothing has been sold,
  /// and the address they typed has never been visited.
  ///
  /// So the difference is recorded rather than smoothed over. A self-registered
  /// party must not silently become a trusted customer record: it is a lead
  /// with a login until somebody at the branch says otherwise.
  selfRegisteredAt    DateTime?
  portalEnabled       Boolean             @default(false)
  portalPasswordHash  String?
  /// True until the customer sets their own password - forces the
  /// staff-issued temporary one to be single-use in practice.
  portalMustReset     Boolean             @default(true)
