  /// platform owner's portal (Support) as well as this business's desk.
  toSupport       Boolean   @default(false)
  sentToSupportAt DateTime?
  /// What the person was looking at when they raised it - page, browser,
  /// roles, branch, app version - so support rarely has to ask.
  context         Json?

