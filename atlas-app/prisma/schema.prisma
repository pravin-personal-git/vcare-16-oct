  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@id([taskId, userId])
}

/// Logged against a project OR a specific task within it - the caller
/// (server/projects.ts) validates the logging employee is actually a
/// manager or member of whichever one they're logging against, and that
/// the date isn't in the future, per atlas-hrns's TimeSheet.clean().
model ProjectTimesheet {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  date         DateTime
  minutesSpent Int // store as minutes, not a "HH:MM" string like atlas-hrns - avoids a string-parsing validator for no real benefit
  status       String   @default("in_progress") // in_progress | completed
  description  String

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([projectId, date])
}

// ============================================================ SERVICE & COMPLAINTS
// Four screens over three real objects, not four tables pretending to be
// independent: a Complaint (what the customer reported), a ServiceVisit (a
// technician's scheduled or completed call against it), and a RepairChallan
// (stock that physically left the building to fix it). "Complaint Tracker"
// and "Repair Tracker" are both just filtered views over these three -
// building them as separate tables would let a complaint's own tracker
// disagree with its own repair history, which defeats the point of a tracker.

/// Per-branch: which extra fields a complaint form asks for, and whether each
/// is mandatory. Deliberately scoped to Complaint only for now, not a
/// generic engine retrofitted onto every existing module - that is a
/// separate, much larger decision. Values live in `Complaint.customFields`,
/// a JSON object keyed by `fieldKey`.
model ComplaintFieldConfig {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  fieldKey  String
  label     String
  fieldType String // text | number | select | boolean
  /// Comma-separated. Only meaningful when fieldType is "select".
  options   String?
  required  Boolean @default(false)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@unique([storeId, fieldKey])
  @@index([storeId, sortOrder])
}

model Complaint {
  id          String @id @default(cuid())
  storeId     String
  store       Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  complaintNo String // CMP-BR001-2026-0001, same numbering service as every other document

  /// THE REFERENCE THIS DOCUMENT HAD IN THE SYSTEM IT CAME FROM.
  ///
  /// Added 23 Sep 2026. A migrated tenant's documents kept their original
  /// numbers as `complaintNo`, which works until the day anyone renumbers -
  /// and then the number a customer reads down the phone is gone with no
  /// record it ever existed. This column is that record, set once at import
  /// and never written again.
  ///
  /// Null on anything Atlas issued itself, which is how a screen tells a
  /// migrated document from a native one without guessing from its format.
  legacyRef String?

  customerId String
  customer   Party    @relation(fields: [customerId], references: [id])
  /// The equipment the complaint concerns. Nullable - a customer describing
  /// "the camera near the entrance" before staff match it to a catalogue row
  /// must still be able to raise the complaint.
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])

  /// Which of the customer's sites this is at, when they have named sites.
  /// `siteLocation` below stays the text of record - a complaint raised
  /// before sites existed, or at a one-off address, has no site row.
  siteId String?
  site   PartySite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  /// True when raised from the customer's own login rather than typed in by
  /// staff - see docs/22-OPEN-QUESTIONS.md, the customer portal is the next
  /// piece of work after this module, not part of it yet. Once it exists this
  /// flag is how a complaint says which side of the counter it started on.
  raisedByPortal Boolean @default(false)

  /// Free-text note about the site - "Gate 3, near the warehouse". Optional
  /// and supplementary now, not the primary location signal - see siteLat/
  /// siteLng below, added 18 Sep 2026.
  siteLocation String?

  /// Where the equipment actually is, captured one of two mandatory ways -
  /// the customer's own browser geolocation, or a pasted Google Maps link
  /// resolved server-side (see lib/maps-link.ts). Nullable only for
  /// complaints raised before 18 Sep 2026; every complaint from that date
  /// has one, enforced in createComplaint, not at the database level - a
  /// hard NOT NULL would have no way to backfill real coordinates for
  /// historical rows the way the attendance unification could.
  siteLat    Decimal? @db.Decimal(9, 6)
  siteLng    Decimal? @db.Decimal(9, 6)
  /// `gps` | `maps_link` | null for a complaint raised before this existed.
  siteSource String?

  description String

  /// received -> assigned -> in_progress -> resolved -> closed
  status         String  @default("received")
  /// Set once staff decide how this gets fixed. Null means undecided.
  /// field_visit | direct_replacement
  resolutionType String?

  assignedTechnicianId String?
  assignedTechnician   User?     @relation("ComplaintTechnician", fields: [assignedTechnicianId], references: [id])
  assignedAt           DateTime?

  /// WHO OWNS THE JOB, as distinct from who attends site.
  ///
  /// Added 23 Sep 2026 for the Vcare migration. Their system carried both
  /// `assign_to` (one back-office manager, accountable for the job) and
  /// `assigned_technician` (the field staff who actually went). Atlas had only
  /// the second, so the migration wrote managers into
  /// `assignedTechnicianId`-shaped data and then nulled it rather than assert
  /// that a dispatcher climbed a ladder.
  ///
  /// Nullable: a complaint raised and resolved by one person needs no separate
  /// owner, and historical rows whose owner was hard-deleted from the source
  /// system have nobody to point at.
  ownerId String?
  owner   User?   @relation("ComplaintOwner", fields: [ownerId], references: [id])

  priority String @default("normal") // low | normal | high | urgent

  /// FIELD-JOB ENGINE (27 Sep 2026, workflow spec). One lifecycle for
  /// complaints, repairs and installations - lib/job-flow decides which step
  /// may follow which. `status` codes: see JOB_STATUSES there.
  /// complaint | repair | installation
  jobType         String             @default("complaint")
  /// not_billable | to_invoice | invoiced | part_paid | paid - billing is its
  /// own dimension, not a job step (old "Pending for Invoice/Payment").
  billingStatus   String             @default("not_billable")
  /// The invoice "Bill this job" made (28 Sep 2026) - one per job.
  invoiceId       String?            @unique
  invoice         Invoice?           @relation("JobInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  acceptedAt      DateTime?
  declinedReason  String?
  closedBy        String?
  reopenCount     Int                @default(0)
  /// Set while the technician is Working on site; the period is added to
  /// timeOnSiteSec when he leaves or finishes (workflow spec §4.3).
  onSiteSince     DateTime?
  timeOnSiteSec   Int                @default(0)
  /// A manager let him start without the location check (SiteOverride).
  overrideUsed    Boolean            @default(false)
  siteOverrides   SiteOverride[]
  jobChallans     JobChallan[]
  faultyParts     FaultyPartReturn[]
  /// The customer's no-login link (/j/<token>) for customers without the app
  /// or portal - random, per job, stops working 30 days after closing.
  customerToken   String?            @unique
  /// The customer's rating after the job (1-5) - workflow spec §4.7.
  ratingStars     Int?
  /// The customer's rating of the technician (1-5), next to the job's (28 Sep 2026).
  techRatingStars Int?
  ratingComment   String?
  ratedAt         DateTime?
  estimates       JobEstimate[]
  /// How the customer's "resolved" was proven (workflow spec §4.6):
  /// otp | customer (tapped confirm) | technician (fallback) | office.
  signOff         String?
  /// Set by the technician's "customer approved, please close" fallback -
  /// closing then needs the approver to have called the customer.
  needsCallback   Boolean            @default(false)
  closeNote       String?
  otps            JobOtp[]
  /// An installation job's sales order (workflow slice 9).
  salesOrderId    String?
  salesOrder      SalesOrder?        @relation(fields: [salesOrderId], references: [id])

  /// Keyed by ComplaintFieldConfig.fieldKey for this store.
  customFields Json?

  resolvedAt DateTime?
  closedAt   DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities   ComplaintActivity[]
  visits       ServiceVisit[]
  challans     RepairChallan[]
  replacements ReplacementCase[]
  /// The items on this job (10 Oct 2026) - see ComplaintItem.
  items        ComplaintItem[]
  pickups      ItemPickup[]

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  /// Invoices that billed this job (2 Oct 2026).
  invoiceSources InvoiceSource[] @relation("InvoiceSourceJob")

  /// The basket this service request came from (3 Oct 2026).
  carts Cart[] @relation("CartComplaint")

  @@unique([storeId, complaintNo])
  @@index([storeId, status])
  @@index([storeId, customerId])
  @@index([storeId, assignedTechnicianId])
  @@index([storeId, ownerId])
  @@index([storeId, legacyRef])
  @@index([storeId, createdAt])
}

/// The complaint's own history - the "Complaint Tracker" page is this table,
/// filtered to one complaint, plus its visits and challans read alongside it.
/// Append-only, same rule as ActivityLog and LeadActivity: a tracker that can
/// be edited after the fact is not a tracker.
model ComplaintActivity {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  /// status_change | note | assignment | visit_scheduled | visit_completed | challan_created | field_check_in
  kind       String
  body       String?
  statusFrom String?
  statusTo   String?

  /// False by default - a staff note is internal unless someone deliberately
  /// shares it. The system-generated entries (status changes, assignment,
  /// visits, the resolution decision) are written with this true, since
  /// those are exactly the "progress" a customer's portal login is for.
  visibleToPortal Boolean @default(false)

  createdBy String?
  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([complaintId, createdAt])
}

/// "Service Calls" - a technician's scheduled or completed visit against a
/// complaint, whether that visit is to actually fix something or just to
/// collect more detail before a decision is made.
model ServiceVisit {
  id String @id @default(cuid())

  /// The visit's own store.
  ///
  /// Added 7 Oct 2026 with `installationChallanId`. A visit used to borrow its
  /// store from its complaint; now that a visit can belong to an installation
  /// instead, it needs one of its own. Nullable in the schema only because the
  /// migration refuses to tighten a column it cannot fill - every write path
  /// sets it.
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// WHAT THIS VISIT IS ABOUT - exactly one of these two.
  ///
  /// A database CHECK enforces the exclusive-or, because a visit attached to
  /// neither is a row no screen can draw, and one attached to both is two
  /// answers to "whose job is this".
  complaintId String?
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  /// A NEW INSTALLATION'S APPOINTMENT (7 Oct 2026).
  ///
  /// Vcare had 2 service visits and 906 installation challans. The scheduler
  /// was not under-used, it was unusable for half their work: a visit could
  /// only hang off a complaint. A challan says goods went out on a date; it is
  /// not an appointment with the customer, and a new installation needs one.
  installationChallanId String?
  installationChallan   InstallationChallan? @relation(fields: [installationChallanId], references: [id], onDelete: Cascade)

  /// A SURVEY BEFORE ANYTHING IS SOLD (27 Oct 2026, Vcare).
  ///
  /// A survey happens before there is a challan, so it hangs off the customer
  /// alone. The CHECK allows a visit with only a customer for the survey
  /// reason and nothing else. When a challan is raised from the survey, the
  /// visit gets that challan too.
  customerId  String?
  customer    Party?  @relation("ServiceVisitCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  /// Where to go, when there is no complaint or challan to borrow a site from.
  siteAddress String?

  technicianId String
  technician   User   @relation("ServiceVisitTechnician", fields: [technicianId], references: [id])
  /// field_visit | info_collection
  purpose      String

  /// WHY THE TECHNICIAN IS GOING - `lib/visit-reasons.ts` holds the list and
  /// is the only place it is defined. Distinct from `purpose`, which says what
  /// KIND of trip it is (attend site, or collect information); the reason says
  /// what brought it about. Every visit that existed before this column is an
  /// existing-complaint visit, which is what the default says.
  reason String @default("existing_complaint")

  scheduledAt DateTime

  /// Every change of date/time, with the reason (workflow spec §4.2).

  changes     VisitChange[]
  /// scheduled | completed | cancelled
  status      String        @default("scheduled")
  outcomeNote String?
  completedAt DateTime?

  /// ---------------------------------------------------------------------
  /// THE FIELD CHECK-IN - mandatory before a `field_visit` purpose visit can
  /// be marked completed, added 18 Sep 2026. The raw fix is written as an
  /// AttendanceEvent (source='field_check_in', complaintId set) - the same
  /// ledger every other location event goes through; these three columns
  /// are the maintained projection of that event, cached here so the
  /// Service Calls list does not need a join to show it.
  checkedInAt        DateTime?
  checkInDistanceM   Int?
  /// Null until checked in. True/false once it has been - whether the
  /// technician's position matched the complaint's site within the store's
  /// configured radius (AttendancePolicy.defaultRadiusMeters).
  checkInWithinRange Boolean?

  /// THE CONTRACT THIS VISIT WAS DRAWN FROM.
  ///
  /// Added 24 Sep 2026. A contract can include a fixed number of visits -
  /// "four services a year" - and `AmcContract.visitsIncluded` recorded that
  /// promise while nothing kept it. This column is what makes the count real:
  /// visits used is `count(ServiceVisit where amcContractId = contract)`,
  /// derived rather than a stored tally, for the same reason every other count
  /// in this schema is derived - a stored one drifts the first time a visit is
  /// cancelled or reassigned.
  ///
  /// STAMPED ON COMPLETION, NOT ON SCHEDULING. A visit that was booked and
  /// never happened must not consume a customer's allowance; the work is what
  /// they paid for. So this stays null until `completeVisit` resolves coverage
  /// and finds an active contract.
  ///
  /// Null also means "this visit was chargeable, or the customer holds no
  /// contract" - both normal, and both different from a covered visit.
  amcContractId String?
  amcContract   AmcContract? @relation(fields: [amcContractId], references: [id], onDelete: SetNull)

  createdBy String?
  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([complaintId])
  @@index([technicianId, scheduledAt])
  @@index([amcContractId])
  @@index([installationChallanId])
  @@index([storeId, scheduledAt])
  @@index([customerId])
}

/// The "Repair Tracker" page's own table: stock that physically left the
/// building to fix a complaint. Modelled on Goods Dispatch Note - same
/// document-numbering service, same append-only stock movement written
/// through `stock.ts::applyMovements` in the same transaction as this row,
/// so a challan can never exist without the matching movement or the other
/// way around. `costPaise` is what reconciles this against the books; it is
/// not derived from the product's own costing method, because a warranty
/// replacement often has a different real cost (freight, a partial
/// write-off) than a normal sale of the same part.
model RepairChallan {
  id        String @id @default(cuid())
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  challanNo String

  /// Original reference from the system this was migrated from. Null on
  /// anything Atlas issued. See `Complaint.legacyRef` for the reasoning.
  ///
  /// Note for the Vcare import: one source challan could cover several
  /// products and became one row per product here, so `challanNo` carries a
  /// `-n` suffix while this column holds the unsuffixed original. Several rows
  /// therefore share one `legacyRef`, which is correct and why it is not unique.
  legacyRef String?

  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int     @default(1)
  costPaise Int     @default(0)

  dispatchedAt DateTime @default(now())
  note         String?

  /// ---------------------------------------------------------------------
  /// THE OFFICE'S CHECK ON FIELD WORK - added 23 Sep 2026.
  ///
  /// Both of the migrated client's challan types moved through
  /// Pending -> Work_Done -> Approved | Rejected, and the spread was real
  /// work, not a dormant column: 895 approved, 206 pending, 24 work-done,
  /// 16 rejected. Atlas had no status at all, so every one of the 6,819
  /// migrated rows read as though it had never been checked. A supervisor
  /// could reject a challan in the old system; here there was nothing to
  /// reject.
  ///
  /// Deliberately NOT routed through `ApprovalChain`/`ApprovalRequest`
  /// (CLAUDE.md decision 7). That engine exists for threshold-and-role
  /// chains over money - a sales order above a value needing two levels of
  /// sign-off. This is a single-step field verification with no thresholds
  /// and no chain: the person who did the work marks it done, the office
  /// accepts or sends it back. Modelling it as an approval request would
  /// add a second row and a chain lookup to express one column.
  ///
  /// pending | work_done | approved | rejected | legacy_unknown
  ///
  /// `legacy_unknown` exists because this column was added after 6,819 rows
  /// had already been migrated. The default is `pending`, which is right for
  /// a challan raised today and wrong for a historical one - it would show
  /// years of finished work as a queue awaiting sign-off. The source system's
  /// own spread was 78% approved, so guessing `approved` would be closer to
  /// the truth and still a fabrication. Migrated rows whose source status
  /// could not be recovered get this value instead, and the UI says "not
  /// recorded" rather than implying anything about them.
  status          String    @default("pending")
  approvedBy      String?
  approvedAt      DateTime?
  /// Why it was sent back. Only meaningful when status is `rejected`.
  rejectionReason String?

  /// WHAT THE TECHNICIAN WROTE, as distinct from `note` above, which is the
  /// office's own annotation. 360 of the client's 1,141 repair challans
  /// carried one; the migration folded some into `note` and lost the
  /// distinction between who wrote what.
  /// Technicians the challan was assigned to (Atlas user ids). Vcare kept a list
  /// per challan; restored from the live old app on 26 Sep 2026.
  assigneeIds      String[] @default([])
  technicianRemark String?

  /// THE NUMBER ON THE PAPER SLIP the customer actually signed.
  ///
  /// The single most-used field on either challan type in the source system
  /// - 96% of repair challans and 94% of installation challans had one - and
  /// Atlas had nowhere to put it, so all 6,819 migrated rows lost the only
  /// reference that ties the screen to the signed sheet in the filing
  /// cabinet. Free text, not an integer: it is somebody else's numbering
  /// from a pre-printed book, and one of them is `12893`.
  physicalChallanNo String?

  createdBy String?
  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@unique([storeId, challanNo])
  @@index([storeId])
  @@index([complaintId])
  @@index([storeId, legacyRef])
  @@index([storeId, status])
  @@index([storeId, physicalChallanNo])
  @@index([storeId, dispatchedAt])
}

/// "Installation Challan" - the work slip for a NEW INSTALLATION, signed off
/// at the customer's site once the cameras are actually fitted.
///
/// WHY THIS EXISTS SEPARATELY FROM `RepairChallan`
///
/// The migrated client ran two document chains that both end at one invoice:
/// service (Complaint -> repair challan) and installation (Lead -> Quotation ->
/// SalesOrder -> install challan). Atlas modelled only the first, and
/// `RepairChallan` requires a parent `Complaint` - so the installation half of
/// their business, the growth half, had no record of the work performed and
/// 873 source rows were parked outside the system. This is that table.
///
/// It is NOT a generalisation of RepairChallan with a nullable parent. A
/// nullable `complaintId` would make every existing query on the repair
/// tracker have to remember to exclude installation rows, which is the kind
/// of shared table that leaks one module's rows into another module's list.
/// Two tables, one shared status vocabulary.
///
/// Numbering goes through the same `document-number.ts` service as everything
/// else (docType `ICH`), and stock movement through the same
/// `stock.ts::applyMovements` in the same transaction as the row, so a challan
/// can never exist without its movement or the other way round.
model InstallationChallan {
  id        String @id @default(cuid())
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  challanNo String

  /// The customer's no-login link, /c/<token> (A2, 11 Oct 2026): items, stage,
  /// fit status, handover and warranty - no prices (Pravin, W2).
  publicToken String? @unique

  /// The appointments booked to carry this installation out (7 Oct 2026).
  /// A challan says goods went out; a visit is the date the customer was
  /// given. One installation can need more than one trip.
  visits ServiceVisit[]

  /// The reference this document had in the system it was migrated from.
  /// Null on anything Atlas issued. See `Complaint.legacyRef`.
  legacyRef String?

  /// The order being fulfilled. Nullable because the source data has three
  /// rows out of 203 that name only an enquiry or nothing at all - refusing
  /// them at the database level would mean dropping real history to keep a
  /// constraint tidy.
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])

  /// THE CUSTOMER, ON THE CHALLAN ITSELF (27 Oct 2026, Vcare redesign).
  ///
  /// The challan used to borrow its customer from the sales order, so one
  /// raised without an order had no customer, phone or address. Required by
  /// the raise form now; filled from the order for the challans before it.
  customerId String?
  customer   Party?  @relation("InstallationChallanCustomer", fields: [customerId], references: [id])

  /// "Don't bill" (27 Oct 2026): why the office closed the job without a bill.
  notBilledReason String?

  /// Same vocabulary as `RepairChallan.status`, deliberately - one word means
  /// one thing across both challan types, and the UI can share a badge.
  /// pending | work_done | approved | rejected | legacy_unknown
  status          String    @default("pending")
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?

  /// The paper slip number. See `RepairChallan.physicalChallanNo`.
  physicalChallanNo String?
  technicianRemark  String?
  /// Office-side annotation, separate from the technician's remark.
  note              String?

  /// Terms printed on the slip. Present on every single source row (203/203),
  /// so it is captured as text rather than a `TncTemplate` reference: the
  /// wording that was actually on the signed sheet is the historical fact,
  /// and a template can be edited afterwards.
  termsBody String?

  dispatchedAt DateTime  @default(now())
  completedAt  DateTime?

  /// WHERE IT IS FITTED (10 Oct 2026, G-21). An installation raised from a
  /// sales order is a challan, not a complaint - so the site the office captured
  /// lives here: the text, and the pin the technician's on-site check reads.
  siteLocation String?
  siteLat      Decimal? @db.Decimal(9, 6)
  siteLng      Decimal? @db.Decimal(9, 6)

  /// The working stage, moved by what happens (27 Oct 2026): raised |
  /// technician | visit | fitting | work_done | billed - see
  /// lib/installation-stages `deriveStage`. `status` stays what the phone
  /// reads (pending -> work_done -> approved | rejected); billing closes it.
  stage         String    @default("raised")
  priority      String    @default("normal")
  /// Site survey checklist + estimated cable, filled on the first visit.
  surveyJson    Json?
  /// Testing checklist ticked before handover.
  testingJson   Json?
  /// Material and cable recorded by the technician: issued vs used, extras to bill.
  materialsJson Json?
  /// Handed over to the customer: when, to whom, by whom. Warranty starts here.
  handoverAt    DateTime?
  handoverTo    String?
  handoverBy    String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       InstallationChallanItem[]
  assignees   InstallationChallanAssignee[]
  /// Material challans for cable, clamps and the like that are not on the
  /// order (22 Oct 2026, R3) - the complaint's challan engine, raised here.
  jobChallans JobChallan[]

  /// BILLED OR NOT. Added 2 Oct 2026, mirroring `SalesOrder.isInvoiced`.
  ///
  /// With one invoice covering several challans, "has this work been billed?"
  /// stops being answerable from the order alone - two of its three challans
  /// may be on an invoice and the third still open. Reversible, like the
  /// order's flag: cancelling the invoice releases the challan to be billed
  /// again, which is why cancellation clears this rather than leaving a
  /// tombstoned row to be reasoned about.
  isInvoiced Boolean   @default(false)
  invoicedAt DateTime?

  invoiceSources InvoiceSource[]     @relation("InvoiceSourceChallan")
  invoiceLines   InvoiceItemSource[] @relation("InvoiceLineChallan")
  /// Advances collected on site against this challan (2 Oct 2026).
  receipts       Receipt[]

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, challanNo])
  @@index([storeId, status])
  @@index([storeId, salesOrderId])
  @@index([storeId, legacyRef])
  @@index([storeId, physicalChallanNo])
  @@index([storeId, customerId])
}

/// One product line on an installation challan.
///
/// `barcode` is the specific physical unit that left the building. The source
/// system tracked stock per unit - each line carried the unit's own barcode,
/// its GRN number and what it cost to buy - and Atlas has no serialised stock
/// table yet (that is Phase 3). So the barcode is held as text for now: it
/// preserves the fact without pretending to a foreign key that has nothing to
/// point at. Phase 3 adds the stock-unit table and links these rows to it.
///
/// One source challan carried 44 lines, so this is a real list, not a
/// convenience for the occasional second item.
model InstallationChallanItem {
  id        String              @id @default(cuid())
  challanId String
  challan   InstallationChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)

  productId        String?
  product          Product? @relation(fields: [productId], references: [id])
  /// Denormalised, as on every other document line in this schema: what the
  /// product was called on the day it was dispatched, which is not
  /// necessarily what the catalogue calls it now.
  productName      String
  barcode          String?
  qty              Int      @default(1)
  unit             String?
  srNo             Int      @default(1)
  /// The order line this fits - one line belongs to one installation (11 Oct 2026).
  salesOrderItemId String?
  /// Where on site it goes ("Main gate").
  placement        String?
  /// Serial scanned on site.
  serialNo         String?
  /// to_fit | fitted | tested
  fitStatus        String   @default("to_fit")

  /// UNUSED, COMING BACK (22 Oct 2026, R2). The technician says how many are
  /// coming back - a request only; stock moves when the store receives them,
  /// against the order's GDN. Billed = qty - qtyReturned.
  qtyReturnPending Int @default(0)
  qtyReturned      Int @default(0)

  /// The unit that left on this line, now that units exist (Phase 3).
  /// `barcode` above stays as the text that was on the slip - the historical
  /// fact - and this is the link to the thing itself. Null where the slip
  /// carried no barcode, or one that matches no unit.
  stockUnitId String?
  stockUnit   StockUnit? @relation(fields: [stockUnitId], references: [id])

  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  /// The invoice lines billed from this dispatch line (2 Oct 2026).
  invoiceLines InvoiceItemSource[]

  @@index([challanId])
  @@index([barcode])
  @@index([stockUnitId])
}

/// AN ANNUAL MAINTENANCE CONTRACT, as a thing the system knows about.
///
/// WHY THIS IS A TABLE AND NOT A FLAG ON THE CUSTOMER
///
/// An AMC has a period, a price, a renewal date and a scope of cover. A flag
/// answers none of those. The question this table exists to answer is asked
/// dozens of times a day - "does this customer pay for cover, and does it
/// cover what has just broken" - and it was being answered from memory.
///
/// STARTS ESSENTIALLY EMPTY, AND THAT IS EXPECTED
///
/// The Vcare import carried exactly one AMC-shaped record: a single
/// "ANNUAL MAINTENANCE CHARGES" service line on one invoice, Rs 24,000, and
/// zero rows in PolicyRenewal. So unlike the challans, this is not a migration
/// - it is a module that begins empty and is filled in as contracts are sold
/// and as staff record the ones already running on paper. Worth stating
/// plainly: nobody should expect this screen to show history on day one.
///
/// NOT FILED IN PolicyRenewal
///
/// Phase 4 of the roadmap said to reuse the existing PolicyRenewal reminder
/// rather than build a second one. On inspection PolicyRenewal is an HRM
/// table - the company's OWN insurance and licences - store-scoped with no
/// customer, no amount and no covered equipment. Customer contracts filed
/// there would appear on the HRM screen beside the office fire policy with
/// most of their fields missing. The reuse that was actually worth having is
/// the expiry arithmetic, which both now share via lib/expiry.
model AmcContract {
  id         String @id @default(cuid())
  storeId    String
  store      Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// AMC-{BRANCH}-{FY}-{SEQ}, from the one document-numbering service.
  contractNo String

  /// The reference this contract had in a previous system or on paper. Lets
  /// staff enter a contract that already exists in a ledger somewhere and
  /// still find it by the number the customer knows. See `Complaint.legacyRef`.
  legacyRef String?

  customerId String
  customer   Party  @relation(fields: [customerId], references: [id])

  /// Which premises, as free text.
  ///
  /// Deliberately text and not a foreign key: the site master is Phase 5, and
  /// a nullable relation to a table that does not exist yet would be a column
  /// that can never be filled. When Phase 5 lands this becomes a `siteId`
  /// alongside, and this text is what seeds it - the same approach
  /// `InstallationChallanItem.barcode` takes toward serialised stock.
  siteLabel String?

  /// The invoice that BILLS this contract's fee.
  ///
  /// Not the invoice that sold the product - that is `originInvoiceId` below.
  /// An extra-cost AMC is billed on its own separate invoice (the client's
  /// decision, 24 Sep 2026), so these are two different documents and
  /// conflating them would make it impossible to tell a billed contract from
  /// an unbilled one.
  ///
  /// Null in three legitimately different situations, which is why the
  /// "awaiting invoice" state is DERIVED rather than stored (see
  /// `billingState` in lib/amc-offer): the AMC was included in the purchase
  /// price so there is no fee; the fee exists but nobody has raised the
  /// invoice yet; or the contract predates Atlas entirely.
  invoiceId String?
  invoice   Invoice? @relation("AmcBillingInvoice", fields: [invoiceId], references: [id])

  /// The product sale this contract was born from.
  ///
  /// Set by `createContractsForInvoice` when an invoice carrying an AMC line is
  /// issued. Null on a contract somebody typed in by hand, which is how a
  /// screen tells an automatic contract from a manual one without guessing.
  originInvoiceId String?
  originInvoice   Invoice? @relation("AmcOriginInvoice", fields: [originInvoiceId], references: [id])

  /// The invoice LINE this contract came from.
  ///
  /// Carried so creating contracts for an invoice is idempotent: issuing is one
  /// step in a larger flow and may be retried, and the guard against writing a
  /// second contract for the same line is a lookup on this column. One contract
  /// per line is the rule - see the note on `InvoiceItem.amcOpted`.
  originInvoiceItemId String?      @unique
  originInvoiceItem   InvoiceItem? @relation(fields: [originInvoiceItemId], references: [id])

  /// The AMC terms as agreed, copied from the product when the contract was
  /// created. A snapshot for the same reason the invoice line snapshots the
  /// price: editing the product's wording later must not rewrite what an
  /// existing customer signed up to.
  coverageNote String?

  startDate DateTime
  /// Inclusive. A contract running 1 Apr to 31 Mar covers work done on 31 Mar
  /// - see `coveredBy` in lib/amc-coverage, which is where that is enforced
  /// and tested. Anything else sells a customer 364 days of a year.
  endDate   DateTime

  /// What the customer pays for the period, in paise like every other money
  /// column in this schema.
  amountPaise Int @default(0)

  /// draft | active | expired | cancelled
  ///
  /// Only `active` covers anything. `expired` is set by the renewal sweep
  /// rather than inferred on read, so that a contract's status is a fact
  /// somebody can see and override - a customer who has paid late is still
  /// covered, and that decision needs somewhere to live.
  status String @default("draft")

  /// parts_and_labour | labour_only
  ///
  /// The distinction the counter argument is actually about. Not an enum in
  /// the database for the same reason every other status here is text: adding
  /// a third term should not need a migration.
  coverageTerms String @default("labour_only")

  /// Visits included in the price, for the common "four services a year"
  /// contract. Null means unlimited, which is a different promise from zero.
  visitsIncluded Int?

  /// Days before expiry to start warning. Same meaning as
  /// `PolicyRenewal.reminderDays`, and read by the same shared rule.
  reminderDays Int @default(30)

  /// THE GST RATE THIS CONTRACT IS BILLED AT, typed in by a person.
  ///
  /// No default, deliberately - the client's instruction is that the tax on an
  /// AMC is entered by hand, not assumed. It was a hard-coded 18 in
  /// server/amc.ts, which is the usual rate today and still the wrong kind of
  /// thing to hide in source: wrong tax on an invoice is a legal problem
  /// (CLAUDE.md decision 4). Null means nobody has entered it yet, and
  /// `raiseAmcInvoice` refuses such a contract rather than guessing. Once an
  /// invoice is raised, the rate actually charged lives on that invoice line.
  /// Decimal(5,2) to match every other tax rate in this schema.
  taxRatePct Decimal? @db.Decimal(5, 2)

  /// The SAC code the AMC is billed under - services take a SAC where goods
  /// take an HSN. Null until somebody enters it; never invented.
  sacCode String?

  /// Set when this contract replaces one that ran out, so a renewal chain can
  /// be followed backwards. Self-relation rather than a copied "previousNo"
  /// string, which would go stale the moment a number was corrected.
  renewedFromId String?
  renewedFrom   AmcContract?  @relation("AmcRenewal", fields: [renewedFromId], references: [id])
  renewedTo     AmcContract[] @relation("AmcRenewal")

  notes String?

  cancelledAt  DateTime?
  cancelReason String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  AmcContractItem[]
  /// Visits drawn from this contract's allowance. Counted, never tallied.
  visits ServiceVisit[]

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, contractNo])
  @@index([storeId, status])
  @@index([storeId, customerId])
  @@index([storeId, endDate])
  @@index([storeId, legacyRef])
}

/// A specific piece of equipment a contract covers.
///
/// NO ROWS MEANS THE WHOLE SITE, NOT NOTHING.
///
/// Both are real ways this trade sells a contract: "we maintain your eight
/// cameras" and "we maintain your premises". An itemised contract has rows
/// here; a site-wide one has none. That reading is load-bearing and is pinned
/// down by tests in lib/__tests__/amc-coverage.test.ts - the alternative
/// reading, that an empty list covers nothing, would silently make every
/// site-wide contract useless.
model AmcContractItem {
  id         String      @id @default(cuid())
  contractId String
  contract   AmcContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  /// Denormalised, as on every other document line here: what it was called
  /// when the contract was signed.
  productName String
  qty         Int      @default(1)

  /// The physical unit, when known. Text for now for the same reason
  /// `InstallationChallanItem.barcode` is text - serialised stock is Phase 3.
  /// Once it exists, a contract can cover unit 0041 rather than "a camera".
  serialNo String?

  srNo Int @default(1)

  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([contractId])
  @@index([productId])
  @@index([serialNo])
}

/// Who went to site. A join table because the source system allowed several -
/// though in practice 202 of its 203 challans named exactly one technician and
/// a single row named three, so the UI should treat one as the normal case and
/// more as the exception rather than leading with a multi-select.
model InstallationChallanAssignee {
  challanId String
  challan   InstallationChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation("InstallationChallanAssignee", fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@id([challanId, userId])
  @@index([userId])
}

/// HRM - Insurance & Policy: anything with an expiry date that must not be
/// missed. A renewal reminder, not a claims system.
model PolicyRenewal {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  title        String
  policyType   String // Insurance | Licence | Contract | AMC | Other
  provider     String?
  policyNumber String?
  /// The NEXT due date (27 Sep 2026). Named expiryDate from when a policy had
  /// one date; marking a due paid moves it on by one billing cycle.
  expiryDate   DateTime
  /// Superseded by reminderOffsets (27 Sep 2026); kept for older reads.
  reminderDays Int      @default(30)
  notes        String?
  isActive     Boolean  @default(true)

  /// company | client - a client policy is linked to a customer (27 Sep 2026).
  ownerKind           String  @default("company")
  partyId             String?
  party               Party?  @relation(fields: [partyId], references: [id])
  /// Where the renewal reminder goes on WhatsApp (6 Oct 2026). Kept on the
  /// policy, not only on the client, because a company policy has no client
  /// to read a number from - that is why the button used to stop and ask for
  /// one every time. A client policy may leave this empty and fall back to
  /// the customer's own phone.
  contactPhone        String?
  /// monthly | quarterly | half_yearly | yearly | one_time
  frequency           String  @default("yearly")
  expectedAmountPaise Int?
  /// Days before the due date to remind; empty = the business default (15, 7, 0).
  reminderOffsets     Int[]   @default([])
  responsibleUserId   String?
  /// When automatic WhatsApp is on, reminder days also message the client.
  remindClient        Boolean @default(false)
  /// active | not_renewing | closed
  status              String  @default("active")
  closedReason        String?

  payments PolicyRenewalPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@index([storeId, expiryDate])
}

/// One due marked paid / renewed - the policy's history (27 Sep 2026).
model PolicyRenewalPayment {
  id          String        @id @default(cuid())
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  policyId    String
  policy      PolicyRenewal @relation(fields: [policyId], references: [id], onDelete: Cascade)
  dueDate     DateTime
  amountPaise Int
  paidAt      DateTime      @default(now())
  paidBy      String?
  note        String?
  createdAt   DateTime      @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([policyId, dueDate])
  @@index([storeId, paidAt])
}

model Quotation {
  /// Closing archives a document without deleting it - it leaves the Active
  /// list and appears under History. The reference carries an Active/History
  /// toggle on every list screen and this is what it switches on.
  ///
  /// Deliberately NOT a status. A quotation that was accepted and then closed
  /// is still an accepted quotation; folding "closed" into the status would
  /// destroy that fact and make the accepted count wrong forever.
  closedAt    DateTime?
  closedBy    String?
  id          String    @id @default(cuid())
  storeId     String
  quotationNo String // QT-BR001-2026-0001

  /// Original reference from the system this was migrated from. Null on
  /// anything Atlas issued. See `Complaint.legacyRef` for the reasoning.
  legacyRef String?

  /// A quotation is raised against a Lead OR a Party. Both are optional and
  /// exactly one is expected - the original splits its list the same way.
  leadId  String?
  lead    Lead?   @relation(fields: [leadId], references: [id])
  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id])

  // Snapshot of the buyer at the time of quoting. Party details may change
  // later; a sent quotation must not silently change with them.
  customerName     String
  organizationName String?
  email            String?
  phone            String
  gstin            String?
  billingAddress   String?
  shippingAddress  String?
  stateId          String?
  cityId           String?

  store Store @relation(fields: [storeId], references: [id])

  quotationDate      DateTime @default(now())
  validityPeriodDays Int      @default(15)
  validUntil         DateTime

  salespersonId String?

  courierId      String?
  deliveryMode   String? // road | air
  deliveryCharge Int     @default(0)
  deliveryExempt Boolean @default(false)

  discountType  String @default("amount") // amount | percent
  discountValue Int    @default(0) // paise, or basis of percent

  subtotalPaise      Int    @default(0) // sum of lines at DLP
  itemDiscountPaise  Int    @default(0)
  orderDiscountPaise Int    @default(0)
  taxableBasePaise   Int    @default(0)
  cgstPaise          Int    @default(0)
  sgstPaise          Int    @default(0)
  igstPaise          Int    @default(0)
  grandTotalPaise    Int    @default(0)
  taxMode            String @default("IGST") // CGST_SGST | IGST

  // Internal margin panel - never printed on the customer document.
  costPricePaise Int @default(0)
  transportPaise Int @default(0)
  incentivePaise Int @default(0)

  tncTemplateId String?
  tncTemplate   TncTemplate? @relation(fields: [tncTemplateId], references: [id])
  termsBody     String?
  notes         String?

  status String @default("draft") // draft|sent|accepted|rejected|converted|expired

  /// Random token for the public view. A quotation is only reachable from
  /// outside once it has been shared, and the token can be rotated to revoke
  /// a link that went to the wrong person.
  publicToken String? @unique

  sentAt      DateTime?
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  /// Why the deal was lost, asked when it is marked Lost from the Sales
  /// dashboard (11 Oct 2026). Null on quotations rejected any other way.
  lostReason  String?
  convertedAt DateTime?

  items       QuotationItem[]
  salesOrders SalesOrder[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, quotationNo])
  @@index([storeId, status])
  @@index([storeId, quotationDate])
  @@index([storeId, legacyRef])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  srNo        Int
  productId   String?
  productName String
  productCode String?

  qty            Int
  unitPricePaise Int // DLP at time of quoting
  discountPct    Decimal @default(0) @db.Decimal(5, 2)
  taxRatePct     Decimal @default(18) @db.Decimal(5, 2)

  lineDiscountPaise Int
  lineTotalPaise    Int // after line discount, before tax

  /// The AMC quoted on this line. See `InvoiceItem.amcOpted` for the full
  /// reasoning; here it exists so a customer asking "how much with AMC?" gets
  /// the answer on the quotation rather than at the last step. Carried forward
  /// to the order and then to the invoice, which is where it becomes a
  /// contract.
  amcOpted      Boolean @default(false)
  amcMonths     Int?
  amcPricePaise Int?

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([quotationId])
}

// ---------------------------------------------------------------- SALES ORDER
//
// Spec: 05-sales-orders-invoices.md §1, §4
//
// The original collapses fulfilment and payment into ONE strip of 15 KPI cards.
// They are two orthogonal dimensions and are modelled as two columns here: an
// order can be `delivered` AND `partial_paid` at the same time, which a single
// enum cannot express. This is non-negotiable #3 in CLAUDE.md.

model SalesOrder {
  /// The customer's own purchase order number. Their reference, not ours -
  /// large buyers will not pay an invoice that does not quote it back.
  poNumber String?

  /// Closing archives a document without deleting it - it leaves the Active
  /// list and appears under History. The reference carries an Active/History
  /// toggle on every list screen and this is what it switches on.
  ///
  /// Deliberately NOT a status. A quotation that was accepted and then closed
