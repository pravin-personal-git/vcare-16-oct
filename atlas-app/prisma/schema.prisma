  billId String
  bill   PurchaseBill @relation(fields: [billId], references: [id], onDelete: Restrict)

  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Restrict)

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: Restrict)

  supplierName String
  gstin        String?

  debitNoteDate DateTime @default(now())

  taxableBasePaise Int
  cgstPaise        Int @default(0)
  sgstPaise        Int @default(0)
  igstPaise        Int @default(0)
  grandTotalPaise  Int

  reason String

  /// draft | issued | cancelled
  lifecycle String @default("draft")

  issuedAt     DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, debitNoteNo])
  @@index([storeId, lifecycle, debitNoteDate])
  @@index([storeId, billId])
  @@index([storeId, purchaseReturnId])
