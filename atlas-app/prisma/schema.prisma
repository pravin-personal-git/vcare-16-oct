/// The figures a balance sheet needs that no document in this system can supply.
///
/// WHY THIS EXISTS AT ALL
///
/// Atlas records documents, not ledger entries. It knows what was invoiced,
/// bought, received and paid - so receivables, payables and stock all fall out
/// of the data. What it cannot know is what was in the bank on the day the
/// business started using it, or how much money the owner put in.
///
/// Without those, a balance sheet is missing its largest numbers. With them, it
/// is a useful statement of position. Somebody types them once.
///
/// EXPLICITLY NOT DOUBLE-ENTRY BOOKKEEPING
///
/// There is no chart of accounts and no journal. Equity here is derived as
/// assets minus liabilities - which is the accounting identity, so the sheet
/// balances by construction. That makes it honest about the position and
/// useless as a check ON the books: a real balance sheet balances because two
/// independently-kept sides agree, and that is the thing this cannot do.
///
/// The screen says so. Anyone filing accounts uses their CA, who works from
/// these same documents.
model OpeningBalance {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// The day the figures below were true. Everything the system records after
  /// this date is added to them; anything before is assumed to be inside them.
  asOfDate DateTime

  /// Physical cash in the drawer and safe.
  cashPaise Int @default(0)
  /// Across all bank accounts. One figure - Atlas does not model accounts
  /// individually, and pretending otherwise would invite reconciliation nobody
  /// can actually do here.
  bankPaise Int @default(0)

  /// What the owner has put in. Not a loan - money that does not come back.
  capitalPaise Int @default(0)

  /// Vehicles, machinery, fittings - at written-down value, not what they cost.
  /// Depreciation is not modelled, so this is a number somebody maintains by
  /// hand and the screen says as much.
  fixedAssetsPaise Int @default(0)

  /// Borrowings still outstanding. Bank loans, family money that comes back.
  loansPaise Int @default(0)

  note String?

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One per store. A second row would silently change the answer depending on
  /// which was read first.

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId])
}

/// SOMEBODY MARKED THEMSELVES PRESENT FROM A BROWSER.
///
/// A deliberately weaker record than `Shift`, and kept in its own table so the
/// difference stays visible.
///
/// A shift is opened from a paired handset the company issued and can revoke.
/// This is a button on a web page, pressed by whoever is holding the session.
/// It is the right record for a manager or an office worker who never carries
/// the field app, and it is the wrong record to treat as proof that anyone was
/// anywhere. Merging the two into one table with a `source` column would have
/// buried that distinction in a string, and a wage record should not depend on
/// anybody remembering to filter on it.
///
/// ATLAS-HRNS OWNS THE ANSWER, NOT THIS TABLE.
///
/// The press pushes an attendance row to HRNS immediately, because a manager
/// who marks themselves present expects to see it in HR now, not after the
/// 02:00 reconciler. This row is the local audit copy: who pressed, when,
/// where, and whether HRNS accepted it. If HRNS refuses, the press is still
/// recorded here with the refusal, so the person can be told something true
/// rather than nothing.
model WebPresence {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The business day, `YYYY-MM-DD`, resolved in Asia/Kolkata.
  ///
  /// Stored as text rather than a date because it is a label for a day, not an
  /// instant. A `DateTime` here would be written in UTC and a 09:00 IST press
  /// would file itself against the previous day - the same trap the bridge
  /// documents, and the reason attendance is keyed on this column.
  workDate String

  clockInAt  DateTime
  clockOutAt DateTime?

  /// Where the browser said it was. All nullable: a browser can refuse
  /// location, and refusing to record attendance because of it would punish
  /// the employee for a setting. A press with no coordinates is still a press.
  inLat        Decimal? @db.Decimal(9, 6)
  inLng        Decimal? @db.Decimal(9, 6)
  inAccuracyM  Int?
  outLat       Decimal? @db.Decimal(9, 6)
  outLng       Decimal? @db.Decimal(9, 6)
  outAccuracyM Int?

  /// The HRNS attendance row this became, and the last refusal if it did not.
  hrnsAttendanceId String?
  hrnsSyncedAt     DateTime?
  hrnsError        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One per person per day, matching how HRNS stores attendance. A second row
  /// for the same day would be a second answer to a question that has one.

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([userId, workDate])
  @@index([storeId, workDate])
}

/// WHAT COUNTS AS LATE, AND WHICH DAYS ARE OFF.
///
/// One row per store, because branches genuinely differ: a showroom closes
/// Sunday and a workshop closes Tuesday, and a single company-wide rule would
/// mark half the staff absent on the wrong day.
///
/// WHY THESE NUMBERS ARE NOT CONSTANTS IN THE CODE.
///
/// Every one of them is the subject of an argument with a real employee at some
/// point - "I was four minutes late", "that was a half day, not an absence".
/// A number somebody can point at, with a date it changed, ends the argument.
/// A number compiled into a deployment does not.
model AttendancePolicy {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Weekly offs as day numbers, Sunday = 0, matching JavaScript's getDay().
  ///
  /// An array rather than seven booleans, so "second Saturday" style patterns
  /// can be added later without a migration per day.
  weekOffDays Int[] @default([0])

  /// Minutes after the shift start that are still counted as on time.
  graceMinutes Int @default(10)

  /// Worked minutes at or above which a day is a full day, and below which it
  /// is a half day. Below the half-day figure it is an absence.
  fullDayMinutes Int @default(480)
  halfDayMinutes Int @default(240)

  /// The usual working day, as `HH:MM` local. Used to decide lateness and as
  /// the `minimum_hour` handed to HRNS for overtime arithmetic.
  shiftStart String @default("09:30")
  shiftEnd   String @default("18:30")

  /// ---------------------------------------------------------------------
  /// GEOFENCING AND IP RESTRICTION - added 18 Sep 2026, both off by default.
  ///
  /// Every one of these is an add-on a business turns on for itself, never a
  /// requirement baked into the attendance flow - the clock-in button must
  /// keep working for a store that has configured none of this. `AttendanceZone`
  /// (below) is where the actual locations live; a store can have several,
  /// unlike Atlas-HRNS's own one-circle-per-company limit.
  geofencingEnabled    Boolean @default(false)
  ipRestrictionEnabled Boolean @default(false)
  /// Comma-separated IPs or CIDR ranges. Null/empty with the toggle on means
  /// nothing currently matches - a deliberately safe default, not a bug: a
  /// store must add at least one range before restriction actually bites.
  allowedIpRanges      String?
  /// The "keep it approx" tolerance - how close a check-in must be to a zone
  /// (or, for a field visit, to the complaint's own coordinates) to count as
  /// a match. Configurable because what counts as "there" differs by site.
  defaultRadiusMeters  Int     @default(150)

  /// ---------------------------------------------------------------------
  /// PAYROLL CYCLE - added 18 Sep 2026.
  ///
  /// The day of the month a pay period starts on. 1-28 only - restricted so
  /// every month actually has that day, rather than a 29/30/31 that silently
  /// shifts in February. 1 (the default) means a plain calendar month, so a
  /// store that has never touched this still gets the answer everyone
  /// assumes without having to configure anything.
  payrollCycleStartDay Int @default(1)

  /// ---------------------------------------------------------------------
  /// AUTO-ABSENT AND OVERTIME - added 18 Sep 2026, both off by default.
  ///
  /// Neither changes the grid until a store deliberately turns it on. That
  /// matters especially for auto-absent: the existing rule is "today is
  /// never absent" (see the comment on `dayStatus` in lib/attendance.ts),
  /// and this is an explicit, opt-in override of it, not a replacement.
  ///
  /// Minutes past midnight after which a working day with no punch and no
  /// approved leave/holiday flips from "not marked yet" to "absent" - but
  /// only for TODAY, and only once that clock time has actually passed.
  /// Null keeps the original, more cautious rule.
  autoAbsentAfterMinute Int?
  /// Minutes worked beyond `fullDayMinutes` required before the excess
  /// counts as overtime at all. Null means overtime is not tracked - not
  /// zero, which would count every minute past a full day as OT and make
  /// the figure noise on a screen nobody configured it for.
  overtimeMinMinutes    Int?

  zones AttendanceZone[]

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
}

/// Config-driven "who may mark/edit attendance for whom" - layered on top
