// ------------------------------------------------- DOCUMENT NUMBERING
// Format: {TYPE}-{BRANCH}-{FY}-{SEQ}  e.g. QT-BR052-2026-0007
// Per-store sequences, FY-aware reset. Concurrency-safe via unique constraint.

/// EVERY DOCUMENT NUMBER EVER HANDED OUT (3 Oct 2026).
///
/// ## The problem
///
/// `allocateDocumentNumber` increments a sequence and returns the number; the
/// document is written afterwards. If that write fails - a locked period, an
/// unknown account code, a dropped connection - the number is gone. The series
/// reads INV-0007 then INV-0009, with nothing anywhere saying what happened to
/// 0008.
///
/// That is not a cosmetic problem. GST expects an unbroken invoice series, and
/// an auditor who finds a gap will ask what was in it. "We do not know" is the
/// wrong answer, and until now it was the only one available.
///
/// ## What this table does
///
/// One row per number issued, written in the same statement that advances the
/// sequence. Two things follow:
///
///   1. A gap can be EXPLAINED. "INV-0008 was issued at 14:32 on 3 October by
///      Pravin and no invoice was ever saved against it" is an answer.
///   2. A gap can be CLOSED. A number issued and never claimed by a document is
///      handed to the next caller instead of a fresh one, so the ordinary case
///      produces no gap at all. The document tables' own unique constraints are
///      the backstop: handing out a number something already holds is refused by
///      the database rather than trusted to this logic.
///
/// Nothing is deleted from here. A reused number keeps its original row and
/// gains a second - the point is the history, not the current state.
model DocumentNumberAllocation {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  docType       String
  financialYear Int
  sequence      Int

  /// The formatted number, e.g. `INV-BR001-2026-0008`. Stored rather than
  /// recomposed, because the branch code or the padding could change later and
  /// the number that was printed on a document must not change with them.
  number String

  /// When a document was found holding this number. Null means nothing does -
  /// either the save is still in flight, or it failed and the number is burnt.
  claimedAt DateTime?

  /// Set when this number was handed out again after going unclaimed. The
  /// original row keeps `reissuedAt` so the history reads in order.
  reissuedAt DateTime?

  allocatedAt DateTime @default(now())
  allocatedBy String?

  @@unique([storeId, docType, financialYear, sequence])
  @@index([storeId, docType, claimedAt])
  @@index([storeId, number])
}

model DocumentSequence {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  docType       String // QT, SO, INV, PO, GRN, GDN, POS
  financialYear Int // 2026 => FY Apr 2026 - Mar 2027
  lastSequence  Int    @default(0)
  padding       Int    @default(4)

  @@unique([storeId, docType, financialYear])
}

