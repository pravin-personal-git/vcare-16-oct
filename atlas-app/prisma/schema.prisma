// ---------------------------------------------------- CONFIGURABILITY (F1a)
// 29 Sep 2026 - CONFIGURABILITY-SPEC.md, decisions D15 and D16.
//
// WHY THESE SIT BESIDE RoleAppAccess RATHER THAN REPLACING IT.
//
// `RoleAppAccess`/`UserAppAccess` hold a live client's phone settings today.
// The key catalogue in lib/config-registry.ts adopts their keys unchanged, so
// these tables store the SAME flat shape and the eventual fold-in is a copy,
// not a translation. Expand now, contract in a later release (AGENTS.md §6) -
// a migration that rewrote Vcare's technicians' access in place would be a
// destructive change to the one thing they use every day.
//
// Keys are namespaced by surface in the registry (`web.*`, `portal.*`, and the
// phone's own `section.*` / `action.* `/ `hide.*`), so one flat map per scope
// covers all three surfaces without a discriminator column.

/// A business's own configuration - the floor for everyone in it.
model StoreConfig {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Flat map of element key -> value. A key absent means the registry default,
  /// so an element added later needs no migration.
  values Json @default("{}")

  /// Flow step key -> { on, fallback }. See D16: a step switched off must say
  /// what happens instead, and `validateStep` refuses anything else.
  flow Json @default("{}")

  /// Client wording: key -> { en, hi }. Reaches prints and exports too - a
  /// business that calls a challan a "Parts slip" means everywhere.
  labels Json?

  updatedBy String?
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
}

