/// A physical biometric/punch machine that posts attendance via HTTP.
///
/// Same trust model as `CallSyncDevice` - the token never appears in the
/// database, only its SHA-256 hash - because this also runs unattended for
/// months with nobody to log back in. It does NOT hook into
/// `AttendanceSession.deviceId`/`AttendanceEvent.deviceId`: those columns are
/// explicitly reserved for phone evidence (`CallSyncDevice`) and a biometric
/// punch must keep them null, same as web/manual - see the comment on
/// `AttendanceSession.source`. Which physical machine produced a punch is
/// recorded on `AttendanceDeviceEvent` instead.
model AttendanceDevice {
  /// F2.5: which adapter talks to this machine - see lib/attendance-capture/registry.
  /// Null on devices paired before F2.5, which keep posting the generic shape.
  vendor String?

  /// F2.5: the adapter's NON-SECRET settings - a base URL, CSV column names.
  ///
  /// Fields the adapter marks `secret` are never written here. A vendor
  /// password belongs in the connector agent's own config on the office PC and
  /// in the password manager, never in this database, a commit or a log
  /// (AGENTS.md section 6). `assertNoSecrets` enforces it and a test proves it.
  config Json?

  /// F2.5: where the last pull stopped. Opaque to everything but the adapter.
  cursor String?

  /// F2.5: `from_state` trusts the vendor's in/out flag; `first_last` ignores it
  /// and reads the first touch of a person's day as arrival, the last as
  /// departure. The second is the COMMON case - at most sites nobody presses
  /// anything - and the old code rejected such punches outright.
  directionMode String @default("first_last")

  /// F2.5: the reader's clock against ours. Reported, never used to rewrite a
  /// punch: the record has to agree with what the person saw on the machine.
  clockSkewSeconds  Int?
  lastSkewCheckedAt DateTime?
  id                String    @id @default(cuid())
  storeId           String
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  label       String
  deviceModel String?

  /// Punches with no branch of their own land at this zone - mainly so a
  /// geofence policy has something to match against.
  defaultZoneId String?
  defaultZone   AttendanceZone? @relation(fields: [defaultZoneId], references: [id], onDelete: SetNull)

  /// Minutes to add to this device's own clock to get real time. Punch
  /// machines are set once at install and rarely NTP-synced afterwards.
  timezoneOffsetMinutes Int @default(0)

  /// How to read this device's payload - vendors do not agree on a wire
  /// format. e.g. { "userCodeField": "empcode", "timestampField": "punch_time",
  /// "directionField": "io", "inValue": "0", "outValue": "1" }. Null uses the
  /// built-in default shape.
  fieldMapping Json?

  isActive  Boolean   @default(true)
  createdBy String
  revokedAt DateTime?
  revokedBy String?

  /// The newest punch this device has had accepted - the ingest equivalent of
  /// `CallSyncDevice.lastCallAt`.
  lastPunchAt  DateTime?
  /// The last time this device talked to us at all, accepted or not - the
  /// ingest equivalent of `CallSyncDevice.lastSyncedAt`. A device that has
  /// been calling in and getting every punch rejected must not look the same
  /// as one that has gone silent.
  lastCalledAt DateTime?

  /// THE OFFICE CONNECTOR, MANAGED FROM ATLAS (9 Oct 2026). Vcare's first
  /// install could only be diagnosed by asking for their PC again; these let
  /// it be configured, watched, tested and updated from here instead. See
  /// lib/attendance-capture/agent-protocol.
  ///
  /// Settings the connector takes on every check-in (clock offset, poll
  /// interval, re-read window). Null = the defaults (India, 5 min, 2 days).
  agentSettings   Json?
  /// The connector version that last checked in.
  agentVersion    String?
  /// The connector's last check-in, with or without punches. `lastCalledAt`
  /// only moves when punches are delivered, so a connector that is running
  /// but getting nothing from BioTime looked dead - this tells them apart.
  agentSeenAt     DateTime?
  /// Its last status report: what the vendor returned, and the error if any.
  agentStatus     Json?
  /// The answer to the last "Test now".
  agentTest       Json?
  /// Set by "Test now"; cleared when the connector reports the test.
  testRequestedAt DateTime?

  createdAt DateTime @default(now())

  events  AttendanceDeviceEvent[]
  punches AttendancePunch[]

  @@index([storeId, isActive])
}

/// Audit of every call a punch device made, accepted or not - not just the
/// punches that landed. A device sending garbage is a support call waiting
