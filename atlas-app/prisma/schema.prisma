/// One line of an imported bank statement - spec 10-accounts-purchase.md §1.9
/// ("Bank Statement"). No `storeId` of its own: scope is always resolved
/// through `bankAccount`, the same pattern `BomComponent` uses through `bom`.
///
/// `matchedType`/`matchedId` is a polymorphic reference to whichever
/// operational record this bank line represents - a Receipt (money in), a
/// SupplierPayment or Transaction (money out). It is deliberately not a
/// foreign key: the target can be any one of three models, and Prisma cannot
/// express a relation that points at a choice of tables. See
/// `server/bank-summary.ts::confirmMatch`, which is the only place these
/// columns are written, and validates the target exists and is in scope
/// before writing - the same discipline `DocumentAttachment.docType/docId`
/// is supposed to have and, per the risk register, does not yet.
model BankTransaction {
  id            String      @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  txnDate     DateTime
  description String
  /// Exactly one of debitPaise/creditPaise is non-zero - enforced in
  /// lib/bank-reconcile.ts::parseStatementRow, not here.
  debitPaise  Int      @default(0)
  creditPaise Int      @default(0)
  /// Cheque number, UTR, or whatever the bank printed - not always present.
  reference   String?

  /// Receipt | SupplierPayment | Transaction
