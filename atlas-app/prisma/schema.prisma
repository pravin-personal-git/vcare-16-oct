/// The Transactions / Expenses ledger - spec 10-accounts-purchase.md §1.2.
///
/// Three kinds, one table, because the toolbar treats them as one list
/// filtered by a chip, not three separate screens.
///
///   expense  - money out. The only kind that starts `pending`: spec says
///              "Pending = expenses awaiting approval", nothing about income
///              or transfers needing it. Posts to the GL only on approval.
///   income   - money in, not a sale (a sale is an invoice). Posts
///              immediately; there is nothing to approve.
///   transfer - cash ↔ bank today. A transfer to a staff member's own
///              account is deliberately out of scope here - that is exactly
///              what `StaffTransaction`'s advance_given already models, and
///              building a second path to the same GL accounts would be two
///              places that could disagree about what an employee is
///              holding.
model Transaction {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  txnType     String // expense | income | transfer
  txnNo       String
  txnDate     DateTime @default(now())
  amountPaise Int

  /// The expense or income category - a code from the chart of accounts
  /// (5xxx for expense, 4900 for income). Null for a transfer, which uses
  /// fromAccountCode/toAccountCode instead. Categorising straight onto a
  /// real GL account rather than a separate category master means a
  /// category can never point at nothing.
  categoryAccountCode String?

  /// cash | bank | upi | cheque - which account the money moved through, for
  /// expense (credited) and income (debited). Null for a transfer.
  method String?

  /// Transfer only - which two accounts moved (account codes, e.g. 1010/1020).
  fromAccountCode String?
  toAccountCode   String?

  description    String?
  attachmentPath String?

  /// The owner's own fields for this voucher (9 Oct 2026) - a bill number, a
  /// vehicle, a meter reading. Defined per branch at Settings > Custom
  /// Fields > Office expenses, the same mechanism customers, leads and
  /// products already use. `{}` when none are set up.
  customFields Json @default("{}")

  /// Who the cash was actually handed to (8 Oct 2026), for a petty-cash
  /// expense: the person who took ₹120 for chai, or the technician who took
  /// the day's petrol money.
  ///
  /// INFORMATIONAL ONLY - it deliberately has NO ledger effect. The posting
  /// is still Dr expense / Cr cash, so nothing lands on `1400 Staff Advances`
  /// and the person does not become a debtor. That distinction is the whole
  /// point: the money was spent BY them, not LENT to them. Not a relation,
  /// same as `createdBy`/`approvedBy` on this table.
  paidToUserId String?

  /// pending | approved | rejected | reversed.
  ///
  /// pending/rejected only ever happen to an expense. approved is where
  /// income and transfer start, and where an approved expense ends up.
  /// reversed is a formal undo of something that was posted - same
  /// reasoning as every other posting in this ledger: correct by reversing,
  /// never by editing or deleting.
  status         String    @default("approved")
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  reversedAt     DateTime?
  reversalReason String?

  createdBy String?
  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@unique([storeId, txnNo])
  @@index([storeId, status, txnDate])
  @@index([storeId, txnType])
}

/// Bill of Materials - spec 06-inventory.md §3 ("Product BOM").
///
/// "A BOM maps a finished product to its component products with
/// quantities. Branch-scoped - the same finished good can have different
/// BOMs per branch." One active BOM per finished product per store is the
/// practical case; nothing here forbids more than one existing (a superseded
/// version kept for history), but `isActive` decides which one a new
/// Production Order can be raised against.
/// WHAT A PRODUCT LOOKS LIKE IN THE SHOP. Added 3 Oct 2026.
///
/// A separate row rather than columns on `Product`, for three reasons that each
/// came up while writing it:
///
///  1. Most products are never listed. Vcare carry 1,339 and would show perhaps
///     eighty; hanging eight marketing columns off every product row to serve
///     6% of them is a cost paid by every stock query in the system.
///  2. What a shop says is not what a warehouse knows. "CP PLUS CAMERA DOME IP
///     2MP DUAL LIGHT VA" is the right name on a GRN and the wrong one on a
///     shop page, and a client must be able to change one without touching the
///     other.
///  3. Listing is a decision somebody makes and unmakes. A row that can be
///     removed says that better than a boolean which has always been there.
///
/// THE PRICE IS NOT HERE, deliberately. Decision 11: the catalogue shows the
/// PRODUCT price and says installation may cost extra. That price is
/// `ProductPrice`, the same number the quotation and the invoice use, so a
/// change in one place is a change everywhere - which is the whole reason this
/// model holds no money of its own.
model CatalogueListing {
  /// What customers wrote about it, and who saved it for later (5 Oct 2026).
  reviews   ProductReview[]
  wishlists ShopWishlist[]
  id        String          @id @default(cuid())
  storeId   String
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Unique on its own, not just within the store. A product belongs to exactly
  /// one store, so a per-store unique would be the same constraint written
  /// twice - and Prisma needs the plain one anyway to see this as one-to-one.
  productId String          @unique
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Shown to the public, or held back while somebody writes the copy.
  isListed Boolean @default(false)

  /// What the shop calls it. Null means "use the product name" rather than an
  /// empty heading - most listings never need their own.
  headline String?
  blurb    String?

  /// "2-3 days". Free text, because a promise about delivery is a sentence a
  /// shopkeeper wants to write, not a number a developer wants to parse.
  deliveryNote String?

  /// "10% off". The label is what the customer reads; it carries no money and
  /// changes no price - an offer that silently altered what is charged would be
  /// a discount nobody approved.
  offerLabel String?
  /// The heading this sits under on the shop (3 Oct 2026). Null = the product's
  /// category. Separate from the category because a client's stock categories
  /// are for the stores ("CCTV CAMERA SERVICE") and a shopper needs "Cameras".
  shopGroup  String?

  /// Hand-ordered within a category. Lower first.
  sort Int @default(0)

  images CatalogueImage[]
  carts  CartItem[]

  createdBy String?
  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md 4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

