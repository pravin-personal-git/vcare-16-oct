/// The Staff Balance / My Personal Account ledger - spec 10-accounts-purchase.md
/// §1.5 ("User Account"). Two independent things can be true about the same
/// employee at once: the company can be holding money they owe back (an
/// advance) and the company can separately owe them money (an unreimbursed
/// expense). Kept as one `kind`-tagged table rather than two, because a
/// settlement can go either direction and a list screen wants both sides in
/// one timeline, the same reasoning as `SalesReturn`'s disposition column.
model StaffTransaction {
  id      String @id @default(cuid())
  storeId String

  /// THE 'ST' NUMBER THIS ROW WAS ISSUED (3 Oct 2026).
  ///
  /// `recordStaffTransaction` has always called `allocateDocumentNumber(.., 'ST')`
  /// and then used the result only inside a GL description string - the number
  /// was never stored, so EVERY staff transaction burned one. Found while
  /// building the burnt-number ledger, which is exactly the class of problem it
  /// exists to surface.
  ///
  /// Nullable because the rows already in the database were issued a number that
  /// is not recoverable - it exists only inside a journal entry's description.
  /// Null means "issued before this column existed", not "has no number".
  txnNo String?
  store Store   @relation(fields: [storeId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// advance_given      - company hands the employee cash; an asset (1400)
  ///                       until repaid.
  /// advance_repaid     - the employee returns money from an earlier advance.
  /// expense_claimed    - the employee paid for something on the company's
  ///                       behalf; a liability (2300) until reimbursed.
  /// expense_reimbursed - the company pays back an earlier expense claim.
  /// incentive_paid     - a sales incentive earned on a won quotation, paid
  ///                       out. See `server/incentives.ts`.
  kind String

  amountPaise Int
  txnDate     DateTime @default(now())

  /// cash | bank | upi | cheque - which account the money moved through on
  /// the company's side, same vocabulary as `SupplierPayment.method`.
  method String  @default("cash")
  note   String?

  /// What this transaction is FOR, when it's tied to a specific document
  /// rather than a free-standing advance or expense - e.g. sourceType
  /// 'quotation_incentive', sourceId the Quotation id, so paying it twice is
  /// checkable by looking, not by trusting memory. Null for the free-standing
  /// case, which is most of them.
  sourceType String?
  sourceId   String?

  /// active | reversed. A transaction entered by mistake is reversed, never
  /// deleted - same reasoning as every other posting in this ledger.
  status         String    @default("active")
  reversedAt     DateTime?
  reversalReason String?

  createdBy String?
  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([storeId, userId, txnDate])
  @@index([storeId, status])
  @@index([storeId, sourceType, sourceId])
}

/// Goods going back to a supplier - spec 06-inventory.md §2.2 / 10-accounts-
/// purchase.md §2.2 ("Mirrors Sales Return"). Same split as the sales side:
/// this model is the physical half only (stock leaving), `SupplierDebitNote`
/// is the financial half (Accounts Payable reduced), for the same reason
/// `SalesReturn` and `CreditNote` are split - the goods and the money can
/// happen on different days, sometimes in different accounting periods, and
/// forcing them into one document means one can never be right without the
/// other.
///
/// Deliberately narrower than `SalesReturn`: no disposition column. A sales
/// return's disposition exists to stop damaged stock quietly re-entering
/// sellable inventory; a purchase return has no equivalent risk; whatever
/// went out - wrong item, damaged on arrival, over-ordered - the movement is
/// identical (Cash goods leave), so there is nothing a second column would
/// distinguish.
model PurchaseReturn {
  id       String @id @default(cuid())
  returnNo String
  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  billId String
  bill   PurchaseBill @relation(fields: [billId], references: [id], onDelete: Restrict)

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: Restrict)

  /// Buyer... supplier snapshot, same reasoning as every other document here:
  /// a renamed supplier must not rewrite a return raised before the rename.
  supplierName String
  gstin        String?

  returnedAt DateTime @default(now())

  /// draft | dispatched | cancelled
  ///
  /// draft: recorded, nothing has moved yet.
  /// dispatched: stock actually left. The only lifecycle that moves it.
  /// cancelled: withdrawn before dispatch. A dispatched return is reversed by
  /// reversing its own stock movement, not by "cancelling" a fact that
  /// already happened - see `cancelPurchaseReturn`.
  lifecycle String @default("draft")

  reason      String
  warehouseId String?
  notes       String?

  dispatchedAt DateTime?
  dispatchedBy String?

  cancelledAt  DateTime?
  cancelReason String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      PurchaseReturnItem[]
  debitNotes SupplierDebitNote[]

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, returnNo])
  @@index([storeId, lifecycle, returnedAt])
  @@index([storeId, billId])
}

model PurchaseReturnItem {
  id       String         @id @default(cuid())
  returnId String
  return   PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  srNo Int

  billItemId String
  billItem   PurchaseBillItem @relation(fields: [billItemId], references: [id], onDelete: Restrict)

  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  productCode String?
  hsnCode     String?

  qty Int

  /// Copied from the bill line at the time of return - same reasoning as
  /// `SalesReturnItem.unitPricePaise`: a bill correction made later must not
  /// change the value of a return already raised.
  unitCostPaise Int
  discountPct   Decimal @default(0) @db.Decimal(5, 2)
  taxRatePct    Decimal @default(18) @db.Decimal(5, 2)

  /// The bill line's own qty and taxable value, snapshotted, so the
  /// cumulative-return cap can be checked without trusting a bill line that
  /// might since have been... nothing on a posted bill can change it, but the
  /// snapshot costs nothing and keeps the reasoning identical to the sales side.
  billLineQty          Int
  billLineTaxablePaise Int

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([billItemId])
}

/// The financial half of a purchase return - spec 10-accounts-purchase.md
/// §2.2. Always goods-based in this build (always linked to a
/// `PurchaseReturn`): an allowance or price correction with no goods
/// involved is a real case `CreditNote` handles on the sales side, but
/// nothing has asked for its purchase-side mirror yet, and guessing at that
/// workflow would be speculative. Reads its line detail from the linked
