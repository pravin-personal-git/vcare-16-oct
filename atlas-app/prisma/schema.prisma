// ===========================================================================
// PAYROLL - contracts, runs, payslips, loans, encashments, reimbursements,
// income tax. Studied from Atlas-HRNS's own Payroll module (Dashboard,
// Payslips, Loans & Salary Advances, Encashments & Reimbursements,
// Contracts, Income Tax, Configuration) and built natively here rather than
// bridged - see the 19 Sep 2026 roadmap decision to stop treating
// Atlas-HRNS as the payroll system of record.
//
// DELIBERATELY BUILT ON `StaffTransaction`, NOT BESIDE IT
//
// Atlas already posts `advance_given` / `advance_repaid` / `expense_claimed`
// / `expense_reimbursed` / `incentive_paid` straight to the general ledger
// (1400 Staff Advances, 2300 Staff Payable) - see staff-accounts.ts. A
// second, parallel ledger for loans and reimbursements would let payroll and
// the Staff Balance screen disagree about who owes what. So `StaffLoan` adds
// only the EMI SCHEDULE a plain advance never had, and `ReimbursementClaim`
// adds only the approval step before a claim becomes a real
// `expense_claimed` transaction - the money itself still moves through the
// one ledger path that already exists.
// ===========================================================================

/// A versioned pay structure - supersedes the flat `EmployeeSalary` above,
/// which stays in the schema (unused once `/hrm/salary` is rebuilt on this)
/// rather than being dropped in the same migration that introduces its
/// replacement.
///
/// Effective-dated like `ReportingAssignment`: a raise creates a new row and
/// closes the old one's `effectiveTo`, it never edits history. A payslip
/// generated under last year's contract must keep meaning what it meant even
/// after this year's raise - the same reasoning `ProductPrice` and
/// `PurchaseBill`'s supplier snapshot already apply.
model SalaryContract {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// `permanent` | `probation` | `contract` | `intern` - Atlas-HRNS's own
  /// Contracts screen groups by this.
  contractType String @default("permanent")

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  /// Annual cost-to-company - the offer-letter figure. Independent of the
  /// monthly `components` below summing to something else on paper, the same
  /// way a real CTC sheet often includes annual-only items (bonus, gratuity
  /// accrual) a monthly payslip never lines up against exactly.
  ctcAnnualPaise Int

  pfApplicable   Boolean @default(true)
  esicApplicable Boolean @default(false)
  ptApplicable   Boolean @default(true)

  /// `old` | `new` Indian income-tax regime, as declared for TDS purposes.
  /// Changeable once per financial year in practice - not enforced here,
  /// the same trust-the-caller line every other date-bounded choice in this
  /// schema already draws.
  taxRegime String @default("new")

  components SalaryComponent[]

  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@index([storeId, userId, effectiveFrom])
}

/// One line of a contract's monthly earnings breakup - Basic, HRA,
/// Conveyance, Special Allowance... A fixed catalogue of `code`s handled by
/// the calculation engine (Basic and HRA specifically drive PF and HRA
/// exemption), `label`/extra codes free-text beyond that, same balance
/// `TaxRate`/`PaymentType` strike between "the engine needs to recognise
/// this" and "a business needn't ask us to add a row for their own naming".
model SalaryComponent {
  id         String         @id @default(cuid())
  contractId String
  contract   SalaryContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  code  String // BASIC | HRA | CONVEYANCE | SPECIAL_ALLOWANCE | LTA | MEDICAL | ...
  label String

  /// `fixed` | `percent_of_basic` | `percent_of_gross` | `percent_of_sales` |
  /// `per_attendance_day` | `per_overtime_hour`. Free text, not a Prisma
  /// enum, on purpose: the whole point raised for building this was "every
  /// component should be flexible" - a new calc type is a new string this
  /// engine recognises, never a migration to widen an enum. Evolved 19 Sep
  /// 2026 (HRM Replication Roadmap Phase 1) from the original two-value set
  /// into the shape atlas-hrns's real rules engine uses - see
  /// `payroll/methods/payslip_calc.py` in that codebase, and `payroll-run.ts`
  /// for how each type actually resolves.
  calcType String @default("fixed")

  /// The flat amount, for `calcType = 'fixed'`. Null for a formula-driven
  /// component - there is no single "monthly" figure until that period's
  /// actual data is known, the same reasoning `SalaryContract.ctcAnnualPaise`
  /// already draws between a contracted figure and a computed one.
  monthlyPaise Int?

  /// For `calcType = 'percent_of_basic' | 'percent_of_gross' |
  /// 'percent_of_sales'`: the percentage applied to that basis.
  ratePct Decimal? @db.Decimal(5, 2)

  /// For `calcType = 'per_attendance_day' | 'per_overtime_hour'`: the flat
  /// rate per unit (paise per day worked, or paise per hour of overtime) -
  /// a separate field from `monthlyPaise` because "paise per day" and "the
  /// month's fixed amount" are different numbers that would otherwise share
  /// one column under two meanings.
  unitRatePaise Int?

  /// Only meaningful for `calcType = 'per_overtime_hour'`: which overtime
  /// bucket this component reads - `regular` (extra hours on a normal work
  /// day), `week_off` (any hours worked on a scheduled day off), or
  /// `holiday` (any hours worked on a holiday). Mirrors atlas-hrns's three
  /// separate overtime `based_on` choices as one calc type with a
  /// sub-selector, not three separate calcTypes.
  overtimeKind String?

  /// Applies to every variable calcType above (previously `percent_of_sales`
  /// only): the most this component ever pays out in one period, however
  /// much its basis would otherwise justify. Null = uncapped.
  capPaise Int?

  /// The employer-matched half of a contribution - tracked for the payslip
  /// document and reporting, never deducted from the employee's own net pay
  /// and never posted to the ledger (same deliberate choice `payroll-run.ts`
  /// already makes for employer-side PF/ESIC - see the comment there).
  /// Applied against this component's own resolved amount as the basis.
  employerRatePct Decimal? @db.Decimal(5, 2)

  /// Set only for a component that pays out in exactly one payroll period -
  /// a one-off bonus, not a recurring line. Any date within the intended
  /// period works; resolution checks whether it falls inside that run's
  /// [periodStart, periodEnd], not an exact match. Null (the default) means
  /// recurring - included in every run, same as today.
  oneTimePeriodStart DateTime?

  conditions SalaryComponentCondition[]

  isTaxable Boolean @default(true)
  sort      Int     @default(0)

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([contractId])
}

/// Optional per-component targeting rule - a component with zero rows here
/// applies to every contract that reaches it, same as before this existed.
/// Deliberately a small, explicit field list (not atlas-hrns's fully
/// dynamic arbitrary-employee-field system) - that's more flexibility than
/// this product's actual use cases need, and it's the one part of the real
/// engine worth simplifying rather than copying wholesale.
model SalaryComponentCondition {
  id          String          @id @default(cuid())
  componentId String
  component   SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  /// `contractType` (reads `SalaryContract.contractType`) or
  /// `employmentType` (reads `EmployeeProfile.employmentType`).
  field    String
  operator String // equal | not_equal
  value    String

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([componentId])
}

/// PF/ESIC/PT statutory rates - Atlas-HRNS's Payroll Configuration screen.
/// Per STORE, not per organisation: Professional Tax is state legislation,
/// and a business with branches in different states needs different slabs
/// per branch - the same reasoning `Holiday` is per-store rather than
/// per-organisation.
model PayrollConfiguration {
  storeId String @id
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  pfEnabled          Boolean @default(true)
  pfEmployeeRatePct  Decimal @default(12) @db.Decimal(5, 2)
  pfEmployerRatePct  Decimal @default(12) @db.Decimal(5, 2)
  /// ₹15,000 - the statutory wage ceiling PF applies against, in paise.
  pfWageCeilingPaise Int     @default(1500000)

  esicEnabled            Boolean @default(false)
  esicEmployeeRatePct    Decimal @default(0.75) @db.Decimal(5, 2)
  esicEmployerRatePct    Decimal @default(3.25) @db.Decimal(5, 2)
  /// ₹21,000 - above this gross, ESIC no longer applies at all.
  esicWageThresholdPaise Int     @default(2100000)

  ptEnabled Boolean @default(true)
  /// This store's PT slab list - `[{"uptoPaise": 2500000, "amountPaise": 20000}, ...]`,
  /// ascending, last entry's `uptoPaise` null for "and above". Flat, not
  /// keyed by state: `PayrollConfiguration` is already per-store, and a
  /// store is already one location in one state (see `Store.stateId`), so a
  /// second layer of state-keying inside a config that is already
  /// store-scoped would be redundant, not more correct. JSON rather than a
  /// table for the same reason `IncomeTaxDeclaration` below uses one: PT
  /// slabs are state legislation that changes on its own schedule, not
  /// something worth a migration each time a state revises it.
  ptSlabs   Json    @default("[]")

  /// Take what staff owe on plain advances out of their salary (8 Oct 2026,
  /// G-19). OFF by default, because switching it on changes what people are
  /// paid and that is a decision, not a default.
  ///
  /// A `StaffLoan` is unaffected either way - it has its own schedule and its
  /// own `LOAN_EMI` line. This is for the money handed over without one, which
  /// until now nothing ever recovered: the balance simply sat on 1400 Staff
  /// Advances for ever, and nobody noticed until somebody left.
  advanceRecoveryEnabled  Boolean @default(false)
  /// The most to take in one month, in paise. 0 = whatever is outstanding,
  /// which on a big advance can take a whole month's pay - hence the cap.
  advanceRecoveryMaxPaise Int     @default(0)

  updatedBy String?
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
}

/// One payroll cycle for one store - "September 2026". The period boundary
/// comes from `AttendancePolicy.payrollCycleStartDay` via
/// `payPeriodsForYear()` in lib/payroll-cycle.ts, not reinvented here.
model PayrollRun {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  /// "September 2026" - computed once at creation, so a later change to
  /// `payrollCycleStartDay` never relabels a past run.
  label       String

  /// `draft` -> `processed` -> `paid`. Independent of `locked` below: a run
  /// can be marked paid and still be open to a correction until somebody
  /// deliberately locks it for the financial-year close.
  status String @default("draft")

  processedAt DateTime?
  processedBy String?
  paidAt      DateTime?
  paidBy      String?

  /// Once true, no payslip in this run can be recalculated or edited - a
  /// payslip already handed to an employee or filed with the government
  /// cannot quietly change under them.
  locked   Boolean   @default(false)
  lockedAt DateTime?
  lockedBy String?

  /// Taken back to `draft` after it had already been processed (8 Oct 2026),
  /// so a mistake found after processing can be corrected and the whole run
  /// rebuilt. The ledger entries are REVERSED, never deleted, and the loan
  /// repayments this run collected are removed so the EMI is not taken
  /// twice. Only the latest revert is kept here; the full history is in
  /// `AuditEvent` and in the reversal entries themselves.
  revertedAt   DateTime?
  revertedBy   String?
  revertReason String?

  payslips Payslip[]

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, periodStart])
  @@index([storeId, status])
}

/// One employee's payslip for one run - a FROZEN snapshot, not a live view.
/// A contract change or an attendance correction after generation must not
/// reach back into an already-generated payslip; regenerating is explicit,
/// never implicit.
model Payslip {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// Snapshot at generation time - see the note on `PurchaseBill.supplierName`
  /// for why this is copied rather than joined live.
  employeeName      String
  employeeCode      String
  designation       String?
  department        String?
  /// Snapshot of `EmployeeProfile.bankAccountNumber` - same reasoning as
  /// `employeeName`/`employeeCode` above. Null if the employee has none on
  /// file; the payslip document shows "-" rather than blocking generation.
  bankAccountNumber String?

  /// Attendance-derived for this period only, from `AttendanceDay` +
  /// approved `LeaveRequest` + `Holiday` - never recomputed after generation.
  workingDays Int
  paidDays    Decimal @db.Decimal(4, 1)
  /// Loss-of-pay days, half-day aware - unpaid absence this period.
  lopDays     Decimal @db.Decimal(4, 1)

  grossPaise           Int
  totalDeductionsPaise Int
  netPaise             Int

  /// Bank transfer reference / cheque number - free text, same looseness as
  /// `Receipt.reference`.
  paymentRef String?

  lines PayslipLine[]

  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([payrollRunId, userId])
  @@index([storeId, userId])
}

/// One line of a generated payslip's breakup - Basic, HRA, PF, ESIC, PT,
/// TDS, Loan EMI, LOP deduction. The printed/downloaded payslip is this
/// table, in `sort` order, under its `payslip` header figures.
model PayslipLine {
  id        String  @id @default(cuid())
  payslipId String
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  /// `earning` | `deduction` | `employer_contribution` (informational only -
  /// never included in gross/net, see `payroll-engine.ts`)
  kind        String
  code        String // BASIC | HRA | PF | ESIC | PT | TDS | LOAN_EMI | LOP | ...
  label       String
  amountPaise Int
  sort        Int    @default(0)

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([payslipId])
}

/// A structured loan with an EMI schedule - Atlas-HRNS's "Loans" half of
/// Loans & Salary Advances, as distinct from a plain advance (which stays
/// exactly `StaffTransaction.advance_given/advance_repaid`, no schedule).
/// Disbursal and every repayment still post through those same
/// `createStaffTransaction` calls; this model only remembers the schedule
/// and which ledger rows belong to it.
model StaffLoan {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// `loan` | `advance` (9 Oct 2026).
  ///
  /// The arithmetic is identical - a salary advance IS a loan, usually of one
  /// instalment - and that is exactly why they share a model rather than
  /// having two. The word is kept only so a report can tell them apart and so
  /// the form can offer the right defaults for each: one month and the whole
  /// amount for an advance, several months for a loan.
  ///
  /// Before this an advance had nowhere to live except a bare
  /// `StaffTransaction`, which nothing ever recovered. Raised here, it is
  /// collected by the same payslip EMI as a loan.
  kind String @default("loan")

  /// `LN-BR001-2026-0007` or `ADV-BR001-2026-0011`. Null on rows raised before
  /// numbering existed - the screen falls back to the kind and the date.
  loanNo String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  principalPaise Int
  emiPaise       Int
  tenureMonths   Int
  /// The first payroll period this EMI is deducted from.
  startPeriod    DateTime

  reason String?
  /// `active` | `closed` | `written_off`
  status String  @default("active")

  /// The `StaffTransaction` (`advance_given`) that actually disbursed this
  /// loan - the ledger entry already exists; this only remembers which one
  /// funded this schedule, the same `sourceType`/`sourceId` pattern other
  /// documents use to point at what caused a ledger line.
  disbursalTransactionId String?

  approvedBy String?
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  repayments StaffLoanRepayment[]

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@index([storeId, userId, status])
  @@index([storeId, kind])
}

/// One EMI actually collected - either automatically, deducted on a payslip
/// (`payslipId` set), or off-cycle by hand (`payslipId` null).
model StaffLoanRepayment {
  id     String    @id @default(cuid())
  loanId String
  loan   StaffLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  payslipId     String?
  amountPaise   Int
  /// The `StaffTransaction` (`advance_repaid`) this repayment posted to the
  /// ledger.
  transactionId String?

  paidAt DateTime @default(now())

  // ---- sync (F2) ----
