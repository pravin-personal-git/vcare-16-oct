enum PlatformRoleScopeType {
  PLATFORM
  RESELLER
  TENANT
  LEGAL_ENTITY
}

/// The non-store-scoped half of D045's 14 system roles
/// (`PLATFORM_OWNER`/`PLATFORM_ADMIN`/`SUPPORT_ADMIN`/`RESELLER_OWNER`/
/// `RESELLER_ADMIN`/`TENANT_OWNER`/`TENANT_ADMIN`/`ENTITY_ADMIN`). Mirrors
/// `Role`'s shape deliberately (isSystem + a permission bag) but is a
/// separate table because `Role.storeId` is required and this tier has no
/// store. `scopeType` says what KIND of scope pointer a `Membership` row
/// using this role must carry - the same role definition is reused for
/// every install, it does not itself name an instance.
///
/// The remaining 6 of the 14 roles (`BRANCH_ADMIN`, `DEPARTMENT_MANAGER`,
/// `EMPLOYEE`, `ACCOUNTANT`, `HR_ADMIN`, `SALES_ADMIN`) need no new table -
/// they are ordinary store-scoped `Role` rows, seeded per-store exactly like
/// every other role.
model PlatformRole {
  id        String                @id @default(cuid())
  key       String                @unique // PLATFORM_OWNER, RESELLER_ADMIN, TENANT_OWNER, ...
  name      String
  scopeType PlatformRoleScopeType
  isSystem  Boolean               @default(false)

  permissions PlatformRolePermission[]
  memberships Membership[]
}

model PlatformRolePermission {
  platformRoleId String
  permissionId   String
  platformRole   PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([platformRoleId, permissionId])
}

/// `User -> Membership -> (scope) -> PlatformRole -> Permission`, per spec
/// §10 - the non-store-scoped counterpart to `UserStoreRole`. Exactly ONE of
/// `platformAccountId` / `organizationId` / `legalEntityId` is set, matching
/// `platformRole.scopeType` (PLATFORM/RESELLER -> platformAccountId, TENANT
/// -> organizationId, LEGAL_ENTITY -> legalEntityId) - enforced in the
/// membership-creation server function, not a DB CHECK constraint (Prisma
/// cannot express a conditional-NOT-NULL check declaratively).
///
/// A person may hold a Membership alongside ordinary `UserStoreRole` rows,
/// or instead of them (`User.organizationId` is nullable precisely so a
/// pure platform/reseller user needs no tenant membership to exist at all).
model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformRoleId String
  platformRole   PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)

  platformAccountId String?
  platformAccount   PlatformAccount? @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  organizationId    String?
  organization      Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalEntityId     String?
  legalEntity       LegalEntity?     @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([platformAccountId])
  @@index([organizationId])
  @@index([legalEntityId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@id([roleId, permissionId])
}

/// A user holds MANY roles per store. Permissions resolve as a UNION.
/// Do not collapse this into a roleId column on User.
model UserStoreRole {
  userId  String
  storeId String
  roleId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@id([userId, storeId, roleId])
  @@index([storeId])
  @@index([userId])
}

/// THE ADMIN-READABLE COPY OF A USER'S PASSWORD (Vcare, 9 Oct 2026).
///
/// Vcare's admin wanted to see staff passwords instead of resetting them.
/// `User.passwordHash` cannot be reversed, so this keeps a SECOND copy,
/// AES-256-GCM sealed with ATLAS_SECRET_KEY (server/secret-box.ts). The key
/// lives in the deployment's environment, never in the database, so a dump
/// of this table alone is ciphertext.
///
/// Its own table rather than a column on User, on purpose: nothing that loads
/// a user can carry it by accident, and the audit trigger is not attached
/// (scripts/audit-trigger-sql.cjs EXCLUDED), so the ciphertext is not copied
/// into AuditEvent either.
///
/// Login never reads this - `passwordHash` is still the only thing checked.
/// Read only through server/password-copy.ts, which re-checks it against the
/// hash, so a copy that has gone stale is reported, never shown as current.
model UserPasswordCopy {
  userId String   @id
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sealed String
  setAt  DateTime @default(now()) @updatedAt
}

model LoginSession {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String  @unique
  device       String?
  userAgent    String?
  ipAddress    String?
  location     String?

  loggedInAt   DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  loggedOutAt  DateTime?
  isRevoked    Boolean   @default(false)

  @@index([userId])
}

/// "Access Tenant" (superadmin-roadmap Slice 5, spec §8) - a Platform/
/// Reseller user viewing/acting within a tenant's scope, WITHOUT becoming a
/// specific tenant user. DB-backed and revocable, same reasoning
/// `LoginSession`'s own doc comment already gives for not using a stateless
/// JWT: "you cannot revoke a stateless token". The cookie holds only this
/// row's opaque `token`; `context.ts` looks it up and, while active, feeds
/// the impersonated org's stores (and a synthetic union of that org's own
/// Admin roles) into the SAME unmodified `resolveScope()` every ordinary
/// tenant login already uses - see that file's own comment on the branch
/// that reads this table. Ends explicitly ("Return to Platform"), never
/// silently - `endedAt` null means still active.
model ImpersonationSession {
  id             String                @id @default(cuid())
  token          String                @unique
  actingUserId   String
  actingUser     User                  @relation(fields: [actingUserId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String                @unique
  event          PrivilegedAccessEvent @relation(fields: [eventId], references: [id])

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([actingUserId])
  @@index([organizationId])
}

/// The customer portal's own session table - deliberately separate from
/// LoginSession rather than a nullable dual-purpose row. A customer and a
/// staff member are different kinds of identity (one party per store, no
/// roles or permissions), and keeping the tables apart means a bug in one
/// login system structurally cannot grant the other's access.
model PartyLoginSession {
  id           String  @id @default(cuid())
  partyId      String
  party        Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  sessionToken String  @unique
  userAgent    String?
  ipAddress    String?

  loggedInAt   DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  loggedOutAt  DateTime?
  isRevoked    Boolean   @default(false)

  @@index([partyId])
}

