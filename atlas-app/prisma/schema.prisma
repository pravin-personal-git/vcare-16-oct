/// A dated history of who reported to whom, in what designation, at which
/// branch - alongside `User.reportsToId`, not instead of it.
///
/// `reportsToId` stays the live column everything else in the app already
/// reads (the mark-permission reporting-line walk, the org chart itself,
/// approval delegation) - rewriting every one of those to read a time-ranged
/// table instead would be a far bigger change than "keep a history" calls
/// for. So every assignment change updates `reportsToId` AND appends a row
/// here, closing whatever was previously open - real history, zero blast
/// radius on existing reads.
///
/// Effective immediately, never future-dated: `effectiveFrom` is always
/// "now" at creation. A row scheduled to start next month would need
/// something to wake up and activate it later, which is more machinery than
/// this earns - see `ProductPrice` for the one other effective-dated model
/// in this schema, which shares this same immediate-effect shape.
model ReportingAssignment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ReportingAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)

  managerId String?
  manager   User?   @relation("ReportingAssignmentManager", fields: [managerId], references: [id], onDelete: SetNull)

  /// The designation this assignment carries - a Role used for its
  /// `level`/`designationCode`, not for permissions.
  designationRoleId String?
  designationRole   Role?   @relation(fields: [designationRoleId], references: [id], onDelete: SetNull)

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdBy String
  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([userId, effectiveFrom])
  @@index([organizationId, effectiveFrom])
}

