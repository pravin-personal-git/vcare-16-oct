  legacyRef String?

  /// Where the order came from. Null means it was raised directly.
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id])

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id])

  // Buyer snapshot at the time of ordering. A party's details may change; a
  // confirmed order must not silently change with them.
  customerName     String
  organizationName String?
  email            String?
  phone            String
  gstin            String?
  billingAddress   String?
  shippingAddress  String?
  stateId          String?
  cityId           String?

  orderDate            DateTime  @default(now())
  expectedDeliveryDate DateTime?

  salespersonId String?
  approvedBy    String?
