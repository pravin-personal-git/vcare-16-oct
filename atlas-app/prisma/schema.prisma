  @@unique([storeId, sessionKey, listingId])
  @@index([storeId, listingId])
  @@index([partyId])
}

/// ONE ITEM ON A COMPLAINT (10 Oct 2026, SERVICE-REPAIR-FLOW-SPEC stage 2).
///
/// A complaint used to carry one product and no serial, so "the camera and the
/// NVR at the ICU" was one line of text and the warranty was read off the last
/// time the customer bought that product. Each item now names the exact unit
/// (when we sold it) or what the customer says it is (when we did not), and
/// carries its own cover: a camera can be under warranty while the NVR beside
/// it is not, and a single item's warranty can be voided.
model ComplaintItem {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  srNo        Int       @default(1)

  /// False: "not our product" - the customer bought it elsewhere. No warranty
  /// from us; any work on it goes through an estimate.
  ours Boolean @default(true)

  /// The exact unit, when it is a serialised one we sold.
  stockUnitId   String?
  stockUnit     StockUnit? @relation(fields: [stockUnitId], references: [id], onDelete: SetNull)
  productId     String?
  product       Product?   @relation(fields: [productId], references: [id])
  /// What it is called on this job - the product name then, or the brand and
  /// model the customer gave for one we did not sell.
  equipmentName String
  serialNo      String?
  /// What is wrong with this item, when it differs from the complaint's description.
  problem       String?

  /// The pickup receipt it left the customer's site on (stage 3) - null while it is still there.
  pickupId         String?
  pickup           ItemPickup?       @relation(fields: [pickupId], references: [id], onDelete: SetNull)
  /// The GDN it was handed back to the customer on (stage 6).
  handbackIssueId  String?
  handbackIssue    MaterialIssue?    @relation(fields: [handbackIssueId], references: [id], onDelete: SetNull)
  /// Its supplier cases, normally one (stage 3 opens it at pickup).
  replacementCases ReplacementCase[]

  /// open | picked_up | with_supplier | back | handed_back | declined | cancelled.
  /// Stages 3-6 move it; stage 2 only opens and cancels.
  status       String  @default("open")
  cancelReason String?

  /// WARRANTY VOID - lightning, water, physical damage, a broken seal. Asked
  /// for with a reason and one of the job's photos, decided by a manager
  /// (approval type `warranty_void`). Only `approved` changes who pays.
  /// requested | approved | rejected; null when never asked.
  voidStatus       String?
  voidReason       String?
  voidPhotoId      String?
  voidRequestedBy  String?
  voidRequestedAt  DateTime?
  voidDecidedBy    String?
  voidDecidedAt    DateTime?
  voidDecisionNote String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@index([complaintId])
  @@index([storeId, stockUnitId])
  @@index([storeId, voidStatus])
}

/// PICKUP RECEIPT (10 Oct 2026, SERVICE-REPAIR-FLOW-SPEC stage 3).
///
/// Vcare does not swap a faulty item from stock: the technician takes the
/// customer's own item away for repair and the customer waits. This is the
/// paper for that - which items left the site, when, with whom, and who at the
/// customer handed them over - so nobody later argues about whether the camera
/// was ever collected. The items' units go to `in_repair`: with us, still the
/// customer's, still on their invoice.
model ItemPickup {
  id           String          @id @default(cuid())
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  complaintId  String
  complaint    Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  pickupNo     String
  pickedUpAt   DateTime        @default(now())
  /// The staff member who took them.
  pickedUpBy   String?
  /// The person at the customer who handed them over.
  handedOverBy String?
  note         String?
  items        ComplaintItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, pickupNo])
  @@index([complaintId])
}

/// SUPPLIER DISPATCH (10 Oct 2026, SERVICE-REPAIR-FLOW-SPEC stage 4).
///
/// One box to one supplier. Vcare sends four cameras from four customers in
/// one parcel, or one customer's four items to three suppliers - so the
/// supplier case (ReplacementCase) stays one per item, and this is the trip
/// they share: courier, docket, tracking link, what the courier cost and how
/// it was paid, and the delivery challan number the goods travel on (it is
/// for repair, not a sale - no tax). Creating it sends every case on it.
model SupplierDispatch {
  id         String @id @default(cuid())
  storeId    String
  store      Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// DSP-...; printed as the delivery challan.
  dispatchNo String

  supplierId    String?
  supplier      Party?  @relation("DispatchSupplier", fields: [supplierId], references: [id])
  /// Free text when the supplier is not on file.
  supplierName  String?
  serviceCentre String?
  /// The supplier's own RMA / authorisation number, when they give one.
  supplierRmaNo String?

  courier            String?
  docketNo           String?
  /// Opened from the screen, never fetched by Atlas.
  trackingUrl        String?
  courierChargePaise Int      @default(0)
  /// cash | bank | none - how the courier was paid; none posts nothing.
  courierPaidBy      String   @default("none")
  /// equal | value - how the charge is shared across the cases.
  chargeSplit        String   @default("equal")
  boxes              Int?
  weightKg           Decimal? @db.Decimal(8, 2)
  /// The courier expense entry, when one was posted.
  journalEntryId     String?

  sentAt         DateTime          @default(now())
  expectedBackAt DateTime?
  /// sent | part_back | back | cancelled - kept in step with its cases.
  status         String            @default("sent")
  note           String?
  cases          ReplacementCase[]
  receipts       RmaReceipt[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, dispatchNo])
  @@index([storeId, status])
  @@index([storeId, docketNo])
}

/// RMA RECEIPT (stage 5, 10 Oct 2026, SERVICE-REPAIR-FLOW-SPEC): what came
/// back from a supplier, line by line - each line is one supplier case with
/// its result (repaired, new serial, came back unrepaired). Its own series
/// (GRR) rather than a purchase GRN: a customer's repaired unit is not our
/// stock, and purchase reports must never count it. A box may come back in
/// parts, so one dispatch can have several receipts.
model RmaReceipt {
  id        String @id @default(cuid())
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  receiptNo String

  dispatchId   String?
  dispatch     SupplierDispatch? @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  supplierId   String?
  supplier     Party?            @relation("RmaReceiptSupplier", fields: [supplierId], references: [id])
  supplierName String?

  receivedAt         DateTime          @default(now())
  /// The return courier, when the supplier did not pay for it.
  courier            String?
  docketNo           String?
  courierChargePaise Int               @default(0)
  /// cash | bank | none
  courierPaidBy      String            @default("none")
  journalEntryId     String?
  note               String?
  cases              ReplacementCase[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, receiptNo])
  @@index([dispatchId])
}

