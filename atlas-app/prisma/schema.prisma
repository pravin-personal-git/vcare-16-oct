/// What we last paid for a product.
///
/// WHY THIS EXISTS BEFORE THE PURCHASE MODULE
///
/// Atlas had no product cost at all: `ProductPrice.costPaise` was a column
/// nothing ever filled. So there was no COGS, no stock valuation, and the
/// "profit" on a quotation was a number a salesperson typed - a guess, not a
/// calculation. The roadmap treated that as blocked on building Purchase.
///
/// Walking the reference app on 5 Sep 2026 showed it is not. That app keeps a
/// rolling history of the **last three purchase prices** per product and offers
/// Standard Cost / Last Purchase Price / Historical Average as the valuation
/// basis - see its System Configuration card 9. A purchase order is a much
/// bigger thing than "what did we last pay for this", and only the second is
/// needed to answer *"is mahine kitna profit hua?"*.
///
/// So this table is the cheap route to a real cost. When the Purchase module
/// lands, a GRN writes a row here rather than replacing it - the shape does not
/// change, only who writes it.
///
/// Append-only. A wrong price is corrected by recording the right one, because
/// the history *is* the valuation basis and editing it retrospectively changes
/// figures that have already been reported.
model ProductPurchasePrice {
  id        String  @id @default(cuid())
  storeId   String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Unit cost excluding tax. Landed cost, if freight is known.
  unitCostPaise Int
  qty           Int      @default(1)
  purchasedAt   DateTime @default(now())

  supplierId String?
  reference  String? // bill number, or how we know
  note       String?

  /// Where this came from: manual | grn | opening.
  /// A GRN-written row is evidence; a manual one is somebody's recollection,
  /// and a valuation should be able to tell them apart.
  source String @default("manual")

  createdBy String?
  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([storeId, productId, purchasedAt])
}

