/// Production Order - spec 06-inventory.md §2 ("Production Order").
///
/// "Consumes a BOM, reserves component stock, produces finished goods.
/// Light manufacturing - not full MRP." Read literally: no WIP/reservation
/// state, no partial completion. An order either hasn't happened yet
/// (`draft`) or it has - components consumed and finished goods produced
/// together, in one step, on `completePurchaseOrder`... on
/// `completeProductionOrder`. The spec's own rebuild notes call
/// manufacturing optional and near-empty in live use; this matches that
/// scope rather than building reservation/scheduling nothing has asked for.
model ProductionOrder {
  id      String @id @default(cuid())
  orderNo String
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  bomId String
