  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([storeId, orderNo])
  @@index([storeId, status, createdAt])
}

/// Employee Salary - spec 09-attendance-hrm.md §7 ("Payroll"), the light half.
///
/// Atlas-HRNS is the actual payroll system of record - see
/// `server/hrns-bridge.ts` ("Atlas-HRNS owns payroll, because that is where
/// leave, overtime and salary maths live"). This model is deliberately NOT a
/// second payroll engine: one row per employee, no versioning/history, no
/// statutory filing. It exists so a small tenant with no Atlas-HRNS
/// deployment can still see a gross-cost number per employee and a rough
/// payroll summary on the HR dashboard - a convenience read, not a system of
/// record. PF/ESIC figures derived from it are indicative (12% of Basic /
/// 0.75% of Gross), not a compliance calculation.
model EmployeeSalary {
