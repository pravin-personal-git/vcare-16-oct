// Project Atlas - Phase 0 foundation schema
// Spec: 03-technical-docs/01-specification/12-users-roles-permissions.md
//
// NON-NEGOTIABLE: every transactional table carries storeId.
// Retrofitting store scoping is a rewrite, not a refactor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer, port 6543) - used at runtime.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) - required for migrations; PgBouncer
  // cannot run the DDL that `prisma migrate` issues.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- TENANCY

// -------------------------------------------------------- PLATFORM HIERARCHY
// Platform Owner / Reseller / Tenant architecture. Spec:
// 09-documentation/_archive/status/HANDOVER-2026-09-18.md §4, decisions D045-D050
// in 09-documentation/00-recall/DECISIONS.md.
//
// `Organization` below is the Tenant. It is NOT a node in the tree here -
// it is a leaf that points at whichever PlatformAccount is its technical
// parent (`Organization.platformAccountId`, added in a later migration of
// this same phase). Keeping Organization out of this tree is deliberate:
// every one of the ~84 `scopeWhere`/`StoreScope` call sites in `src/server`
// only ever resolves within one tenant, and none of them need to know this
// tree exists.

enum PlatformAccountType {
  PLATFORM
  RESELLER
}

/// Lifecycle states shared by PlatformAccount and Organization (D048).
/// Manual transitions only in this phase - no payment-provider webhook.
enum AccountLifecycleState {
  PENDING
  ACTIVE
  GRACE_PERIOD
  READ_ONLY
  SUSPENDED
  TERMINATED
  ARCHIVED
}

/// The recursive Platform -> Reseller -> Sub-reseller spine (spec §13).
/// Depth is unbounded in the schema; `PlatformConfig.maxResellerDepth` is
/// what keeps it to one level in the UI today (D049) - raising it later is
/// a config change, not a migration.
model PlatformAccount {
  id   String              @id @default(cuid())
  type PlatformAccountType

  parentAccountId String?
  parentAccount   PlatformAccount?  @relation("AccountTree", fields: [parentAccountId], references: [id], onDelete: Restrict)
  children        PlatformAccount[] @relation("AccountTree")

  /// Denormalized pointer to the top PLATFORM row of this tree - the same
  /// value as walking `parentAccountId` to the root, cached so a subtree
  /// membership check never has to walk it. Self-referential on the root
  /// row (rootPlatformId == id).
  rootPlatformId String

  /// Materialized ancestor-id path, root-first, dot-joined, INCLUDING this
  /// row's own id - e.g. "platform123.resellerABC". Subtree membership
  /// ("this reseller and everything under it") is then one indexed prefix
  /// query: `path: { startsWith: reseller.path }`. Rewritten only when a
  /// node is re-parented (rare, admin-only, bounded by maxResellerDepth).
  /// The migration adding this column hand-adds a `text_pattern_ops` index -
  /// a plain btree (what `@@index` alone emits) does not serve a Postgres
  /// `LIKE 'prefix%'`/`startsWith` query well.
  path String

  name           String
  accountCode    String                @unique // e.g. RESELLER-2026-0007
  lifecycleState AccountLifecycleState @default(PENDING)

  // ---- Superadmin-roadmap Slice 6 - manual lock, distinct from D050's
  // billing-flow fields (contractEnd/graceUntil) below. A platform-owner-
  // set "lock this reseller on this date" is a different concept from a
  // billing cycle boundary, and conflating them would make a future
  // billing-webhook slice harder to reason about. Same shape as
  // Organization's own copy of these fields - see that model's comment.
  scheduledLockAt DateTime?
  lockReason      String?
  lockedAt        DateTime?
  lockedBy        String?
  unlockedAt      DateTime?
  unlockedBy      String?

  // ---- D050 billing ownership - tracked even though nothing auto-charges yet
  billingOwnerAccountId String? // which PlatformAccount actually bills this node; null = self-bills
  plan                  String?
  licenseType           String? // SAAS_SUBSCRIPTION | PERPETUAL | RESELLER_LICENSE
  commercialModel       String?
  subscriptionStatus    String?
  licenseStatus         String?
  contractStart         DateTime?
  contractEnd           DateTime?
  graceUntil            DateTime?

  organizations Organization[]
  memberships   Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentAccountId])
  @@index([rootPlatformId])
  @@index([path])
}

/// Exactly one row must ever exist - an app-level enforced singleton, the
/// same shape as `PayrollConfiguration`/`AttendancePolicy` elsewhere in this
/// schema, just global instead of per-store: always read with `findFirst()`,
/// never given a second row to create.
model PlatformConfig {
  id               String @id @default(cuid())
  maxResellerDepth Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id             String      @id @default(cuid())
  savedViews     SavedView[]
  /// How AMC fees become income (health check ACC-1, decision 3 of 25 Sep 2026):
  /// spread = held in AMC Received in Advance and released month by month over
  /// the contract; at_invoice = all income on the day it is invoiced.
  amcRevenueMode String      @default("spread")
  orgCode        String      @unique // ORG-YYYY-####
  /// The business's shop address: /shop/<shopSlug> (3 Oct 2026). Lower-case
  /// letters, digits and hyphens, set by the platform owner. Null = no shop link
  /// yet. Unique because two businesses on one server cannot share an address.
  shopSlug       String?     @unique
  name           String
  gstin          String?
  orgSize        String?
  industry       String?
  email          String?
  countryCode    String      @default("+91")
  mobile         String?

  // Brand assets - the white-label surface
  logoPath        String?
  sealPath        String?
  iconPath        String?
  faviconPath     String?
  invoiceLogoPath String?
  paymentQrPath   String?
  paymentLink     String?

  // Theme - the original hard-codes its palette; we do not
  themeTokens Json?

  /// D048/D049 - the technical PlatformAccount (Platform Owner, or the
  /// Reseller that created this tenant) this Organization sits under.
  /// Required since `require_organization_platform_account` - every
  /// existing tenant was backfilled onto the root PLATFORM account first,
  /// see `20260920212650_backfill_organization_platform_account`.
  /// `onDelete: Restrict` deliberately: a reseller with live tenants
  /// underneath must never cascade-delete them.
  platformAccountId String
  platformAccount   PlatformAccount       @relation(fields: [platformAccountId], references: [id], onDelete: Restrict)
  /// D048. Existing tenants default to ACTIVE (they are already live, not
  /// pending approval) - the one lifecycle field that needed no backfill
  /// script, since a column DEFAULT fills every existing row the moment
  /// it's added.
  lifecycleState    AccountLifecycleState @default(ACTIVE)

  /// Superadmin-roadmap Slice 6, D052 - a Platform Owner (or an in-subtree
  /// Reseller) sets a future date; `login/actions.ts` lazily compares it
  /// against `now()` on the tenant's *next* login attempt and flips
  /// `lifecycleState` to SUSPENDED inline before the rest of that flow
  /// runs, rather than a cron sweep - this project has no background job
  /// runner today (confirmed: no cron config, no queue), same "manual-only,
  /// no webhook yet" spirit D048 already chose for billing. A tenant with
  /// nobody attempting to log in stays nominally at its prior state past
  /// its lock date until someone tries - acceptable for this phase, and
  /// revisited only if exact-time locking turns out to matter.
  /// ---- plan and entitlement (workstream F, 1 Oct 2026) ----
  /// Which plan this client is on - see lib/plans.ts for the catalogue.
  /// The platform owner's layer: applied in server/context.ts BEFORE role and
  /// user menu visibility, so a client cannot switch on a module their plan
  /// excludes.
  planId          String    @default("full")
  /// Overrides the plan's own cap. Null means "use the plan".
  userLimit       Int?
  /// Module names this tenant may not see, overriding the plan's list. Null
  /// means "use the plan". Names in ALWAYS_INCLUDED are ignored.
  excludedModules Json?
  /// INDIVIDUAL PAGES THIS TENANT MAY NOT OPEN (F-01, 10 Oct 2026).
  ///
  /// `excludedModules` above deals in whole sidebar groups, which `lib/plans`
  /// argued was the only grain the platform owner should sell in. Pravin asked
  /// for the finer one - "hum har cheez ko hide kar sake as a platform owner" -
  /// because a client is sometimes sold HRM without Payroll, or Sales without
  /// the cost trail, and inventing a module for every such pair is worse than
  /// naming the page.
  ///
  /// Routes, not menu-row ids: a menu row is per-tenant and gets rebuilt by
  /// `sync-tenant-defaults` on every deploy, while `/hrm/payroll` is the same
  /// string forever and is what every door already matches on. Longest prefix
  /// wins, so hiding `/hrm/payroll` hides its children too.
  ///
  /// Empty - the default - means nothing extra is hidden, which is every
  /// tenant's behaviour before this column existed. Data is kept; putting the
  /// page back brings everything back.
  excludedPages   String[]  @default([])
  /// When a trial ends. Null means this is not a trial.
  trialEndsAt     DateTime?

  scheduledLockAt DateTime?
  /// Set on every manual SUSPENDED transition (both a direct Suspend and a
  /// scheduled lock firing) and every Schedule Lock call, respectively -
  /// distinct fields because a schedule can be set, then separately
  /// fire later, and both moments are worth keeping.
  lockReason      String?
  lockedAt        DateTime?
  lockedBy        String?
  unlockedAt      DateTime?
  unlockedBy      String?

  // ---- D050 billing ownership - a tenant may be billed directly by Atlas
  // or by its reseller; tracked even though nothing auto-charges yet.
  billingOwnerAccountId String?
  plan                  String?
  licenseType           String?
  commercialModel       String?
  subscriptionStatus    String?
  licenseStatus         String?
  contractStart         DateTime?
  contractEnd           DateTime?
  graceUntil            DateTime?

  /// Superadmin-roadmap Slice 8, D053 - per-tenant capability flags the
  /// Platform Owner can turn off individually. Both default `true` so every
  /// already-live tenant keeps today's behaviour unchanged the moment this
  /// ships; nobody defaults to off and has to be turned on. Two independent
  /// gates alongside `business.selfService` (the §1.2 tenant-side permission
  /// stop-gap) rather than replacing it - a tenant Admin can still be
  /// individually restricted even when the platform allows the tenant the
  /// feature in general, and vice versa.
  ///
  /// 25 Sep 2026 (founder decision): creating a new business is part of the
  /// paid plan, so it now defaults OFF and only the Platform Owner turns it
  /// on. When on, only holders of the tenant's built-in Admin role may use
  /// it, up to `businessLimit`. Linked accounts stay on by default.
  allowSelfServiceBusinessCreation Boolean @default(false)
  allowLinkedAccounts              Boolean @default(true)
  /// Most new businesses this tenant's admins may create for themselves.
  /// Null = no cap (only meaningful while creation is allowed).
  businessLimit                    Int?
  /// Most branches (stores) this tenant may have. Null = no cap.
  branchLimit                      Int?
  /// Set on a business created from inside another one ("Create a new
  /// business"), so the parent's usage against `businessLimit` is counted
  /// and the Platform Owner can see who created what.
  createdFromOrganizationId        String?
  createdByUserId                  String?

  /// Camera scanner - reading invoices, cards and labels with an AI model.
  /// OFF until an admin turns it on, because it sends the photo to Anthropic;
  /// barcode scanning runs on the phone and needs neither. The limit is reads
  /// per IST calendar month, counted from AiScanLog - see lib/scan/quota.
  aiScanEnabled      Boolean @default(false)
  aiScanMonthlyLimit Int     @default(500)

  /// PLATFORM FEATURE SWITCHES (2 Oct 2026). See lib/plans `PLATFORM_FEATURES`.
  ///
  /// Finer than `excludedModules`, which deals in sidebar groups. Some
  /// capabilities cut across modules and are wrong for most clients: expiry
  /// dates matter to a pharmacy and are noise to a CCTV installer. The
  /// platform owner decides per client; the client cannot switch one on.
  ///
  /// Empty - the default - means none of them, which is every tenant's
  /// behaviour before this column existed.
  enabledFeatures String[] @default([])

  stores                 Store[]
  aiScanLogs             AiScanLog[]
  users                  User[]
  accounts               Account[]
  messages               Message[]
  reportingAssignments   ReportingAssignment[]
  apiTokens              ApiToken[]
  legalEntities          LegalEntity[]
  memberships            Membership[]
  privilegedAccessEvents PrivilegedAccessEvent[]
  impersonationSessions  ImpersonationSession[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@index([platformAccountId])
}

enum LegalEntityStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// D046 - a Tenant may operate several legal/business identities (spec §6),
/// each with its own GSTIN/PAN/statutory info/financial year. `Store` moved
/// under this (see `Store.legalEntityId`) rather than staying a direct
/// child of `Organization` - added as a required FK once every existing
/// Store has been backfilled onto a default LegalEntity, see the migration
/// history around `add_legal_entity`/`require_store_legal_entity`.
///
/// `Organization.id` is DELIBERATELY still kept on `Store` too
/// (`Store.organizationId`, denormalized) rather than dropped - see the
/// comment on that field. Read it before "fixing" this by removing one.
model LegalEntity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name               String
  legalName          String?
  gstin              String?
  pan                String?
  registrationNumber String?

  /// 4 = April, matching CLAUDE.md #8's Apr-Mar financial year by default.
  /// Kept per-entity because D046 allows one legal entity a different FY
  /// from its siblings under the same tenant.
  financialYearStartMonth Int @default(4)

  status       LegalEntityStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?

  stores      Store[]
  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// A workspace-level bearer token - for an external agent (an MCP-style
/// connector, a ChatGPT/OpenAI integration) to authenticate against this
/// organisation's data, not a person signing into the product. Same trust
/// model as `CallSyncDevice`/`AttendanceDevice`: the token itself never
/// touches the database, only its SHA-256 hash does, so a leaked database
/// cannot hand over a working credential.
model ApiToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  label     String
  tokenHash String @unique

  createdBy  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  revokedBy  String?

  @@index([organizationId])
}

/// Platform-API-layer roadmap, Phase 1 - staff/owner mobile+external API
/// login. Deliberately separate from `LoginSession` (opaque, cookie-based,
/// web-only): a native app has no reliable cookie jar and needs to stay
/// authenticated for days with zero connectivity, which is a different shape
/// of problem - see 09-documentation/04-roadmap/PLATFORM-API-LAYER.md §4.
/// Hash-at-rest, same idiom as `ApiToken` above - a leaked database must not
/// hand over a working credential. The short-lived access token this backs
/// is a signed JWT and is never stored anywhere (see server/auth/jwt.ts);
/// only this refresh token touches the database, and only on `/refresh`.
model MobileRefreshToken {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String  @unique
  deviceLabel String? // "Priya's Redmi" - from the phone's own device name

  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  expiresAt    DateTime // sliding window - extended on every successful /refresh
  revokedAt    DateTime?
  /// Set when /refresh rotated this token; the id of the token that replaced
  /// it. A logout or a revoke leaves it empty. Lets a phone whose /refresh
  /// reply was lost on a weak signal retry with the old token (15 Oct 2026).
  replacedById String?

  @@index([userId])
}

/// Same shape as `MobileRefreshToken` above, for the customer-portal login
/// (`Party.portalEnabled`) instead of staff/owner `User` accounts - the
/// mobile API's "Business Customer" login mode. Kept as its own table rather
/// than a nullable-either-or column on one shared table, matching this
/// schema's existing preference for a clean split over a polymorphic
/// reference (see `Membership`'s own comment on why that pattern is
/// tolerated there and avoided everywhere it can be).
model PartyRefreshToken {
  id          String  @id @default(cuid())
  partyId     String
  party       Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  tokenHash   String  @unique
  deviceLabel String?

  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String? // see MobileRefreshToken.replacedById

  @@index([partyId])
}

/// One-time codes for OTP login - either a staff/owner `User` or a portal
/// customer `Party`, delivered by SMS or email. Hashed at rest, same
/// reasoning as every other credential-shaped value in this file. Short-lived
/// and single-use by design; `attempts` caps guessing, `consumedAt` prevents
/// replay. The actual send step (`server/auth/otp-delivery.ts`) is what's
/// pending real SMS/email provider configuration - this table and its
/// generate/verify logic are already fully real and testable without one
/// (see that file's module comment).
model OtpCode {
  id          String @id @default(cuid())
  channel     String // 'sms' | 'email'
  destination String // the phone number or email address, exactly as given
  codeHash    String
  purpose     String // 'staff_login' | 'customer_login'

  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId String?

  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([destination, purpose, createdAt])
}

model Store {
  /// Shop reviews and wishlists (5 Oct 2026).
  productReviews        ProductReview[]
  shopWishlists         ShopWishlist[]
  /// Site visits, which now carry their own store (7 Oct 2026).
  serviceVisits         ServiceVisit[]
  jobSettings           JobSettings?
  incentiveSettings     IncentiveSettings?
  travelSettings        TravelSettings?
  messagingChannels     MessagingChannel[]
  documentTemplates     DocumentTemplate[]
  staffChecklistItems   StaffChecklistItem[]
  staffChecklistEntries StaffChecklistEntry[]
  id                    String                @id @default(cuid())
  /// Kept alongside `legalEntityId` below (denormalized), not replaced by
  /// it, even though D046 conceptually moves Store under LegalEntity - a
  /// deliberate deviation from a literal reading of the spec, flagged for
  /// review in the platform-ownership implementation plan. None of the
  /// ~84 `scopeWhere`/`StoreScope` call sites in `src/server` ever read
  /// this column; only a handful of tenant-admin functions
  /// (`administration.ts`, `provisioning.ts`) do, and dropping it would
  /// force rewriting all of them to walk `legalEntity.organizationId` for
  /// no functional gain in this phase. Every Store-creation call site must
  /// keep setting both fields together, consistently.
  organizationId        String
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// D046 - which legal business entity this branch operates under.
  /// Required since `require_store_legal_entity` - every Store was
  /// backfilled onto its organisation's default LegalEntity first, see
  /// `backfill-legal-entity.ts`/`backfill-store-legal-entity.ts`.
  legalEntityId String
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)

  name       String
  branchCode String // BR052 - document number prefix
  stateId    String?
  cityId     String?
  address    String?

  currency String @default("INR")
  timezone String @default("Asia/Kolkata")
  locale   String @default("en")

  /// How a product's cost is decided: standard | last_purchase | average_3.
  ///
  /// A decision, not a preference - it changes every profit figure and every
  /// stock valuation in the branch. Named to match the reference app's
  /// "Standard Cost, Last Purchase Price, or Historical Average".
  costMethod String @default("last_purchase")

  /// WHEN A SOLD UNIT'S WARRANTY STARTS: `invoice` | `install`.
  ///
  /// A trade that installs what it sells can reasonably count from either day,
  /// and the gap between them is the difference: counted from the invoice, a
  /// camera installed three weeks later loses three weeks of cover. `invoice`
  /// is the default because it is the date on a document the customer holds.
  /// A setting rather than a constant because it is a policy the client
  /// answers, not a fact the code knows - see lib/stock-units `warrantyStart`,
  /// which falls back to the other date when the chosen one is missing.
  warrantyStartsOn String @default("invoice")

  isActive Boolean @default(true)

  roles                 Role[]
  userStoreRoles        UserStoreRole[]
  roleAppAccess         RoleAppAccess[]
  userAppAccess         UserAppAccess[]
  storeConfig           StoreConfig?
  numberBlocks          NumberBlock[]
  numberAllocations     DocumentNumberAllocation[]
  attendancePunches     AttendancePunch[]
  attendanceCodeMaps    AttendanceCodeMap[]
  attendancePhotos      AttendancePhoto[]
  roleConfigs           RoleConfig[]
  userConfigs           UserConfig[]
  stepRequests          StepRequest[]
  menuConfigs           StoreMenuConfig[]
  roleMenuConfigs       RoleMenuConfig[]
  userMenuConfigs       UserMenuConfig[]
  reportingAssignments  ReportingAssignment[]
  sequences             DocumentSequence[]
  quotations            Quotation[]
  salesOrders           SalesOrder[]
  invoices              Invoice[]
  stockMovements        StockMovement[]
  userTargets           UserTarget[]
  activityLogs          ActivityLog[]
  departments           Department[]
  complaints            Complaint[]
  repairChallans        RepairChallan[]
  installationChallans  InstallationChallan[]
  amcContracts          AmcContract[]
  complaintFieldConfigs ComplaintFieldConfig[]
  entityFieldConfigs    EntityFieldConfig[]
  policyRenewalPayments PolicyRenewalPayment[]
  notifications         Notification[]
  notificationSettings  NotificationSetting[]
  personalReminders     PersonalReminder[]
  approvalRules         ApprovalRule[]
  stockUnits            StockUnit[]
  stockUnitEvents       StockUnitEvent[]
  stockLots             StockLot[]
  stockFieldConfigs     StockFieldConfig[]
  partySites            PartySite[]
