/// WHAT THE OLD VCARE SOFTWARE SAID ON A DOCUMENT (29 Oct 2026).
///
/// The old app wrote every remark against an enquiry or a complaint, and named
/// the challan it was about. The import kept the remark on the lead or the
/// complaint but lost the challan, so a challan, quotation, order or bill
/// opened here showed none of its history. One row per remark per document
/// of that job, keyed on the document's OLD number (`legacyRef`), so any page
/// finds its own with one lookup. Read-only: written by the migration, never
/// by the app, which is why it carries no sync columns.
model LegacyRemark {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// The document this row shows on: ECHN…, CCHN…, QTN…, ORD…, INV….
  docRef     String
  /// The old remark's _id - a re-run writes nothing twice.
  sourceRef  String
  /// The enquiry or complaint the remark was written on (ENQ…, COMP…).
  jobRef     String
  /// The challan the remark named, when it named one.
  challanRef String?
  /// Office update | Work done | For technician | Items returned | Challan rejected
  kind       String?
  body       String
  /// The old user's name as text: some no longer have a login here.
  authorName String?
  at         DateTime
  createdAt  DateTime @default(now())

  @@unique([storeId, docRef, sourceRef])
  @@index([storeId, docRef, at])
}

/// ONE PERSON'S OWN ACCESS TO ONE MODULE, IN ONE BRANCH (30 Oct 2026).
///
/// Roles give the same access to everyone who holds them. Vcare asked for the
/// switch per person ("kaunsa user specifically kis feature ko access kr skta
/// h"): Settings > Operations & approvals writes a row here when a person's
/// level differs from their roles, and deletes it when it matches again. The
/// level replaces the module's View / Edit / Approve keys for that person in
/// that branch (server/context); every other module still comes from roles.
model UserAccessOverride {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// lib/role-modules ROLE_MODULES key.
  moduleKey String
  /// none | view | edit | approve
  level     String
  /// Who set it - the audit trigger records the rest.
  setBy     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, userId, moduleKey])
  @@index([userId])
}
