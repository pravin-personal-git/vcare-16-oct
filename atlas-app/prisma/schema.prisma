  complaintItems        ComplaintItem[]
  itemPickups           ItemPickup[]
  supplierDispatches    SupplierDispatch[]
  rmaReceipts           RmaReceipt[]
  documentSends         DocumentSend[]
  replacementEvents     ReplacementEvent[]

  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  attachments                DocumentAttachment[]
  uiCustomisations           UiCustomisation[]
  sharedFiles                SharedFile[]
  bankAccounts               BankAccount[]
  couriers                   Courier[]
  notices                    Notice[]
