model Product {
  jobChallanLines   JobChallanLine[]
  faultyPartReturns FaultyPartReturn[]
  id                String             @id @default(cuid())
  storeId           String
  productCode       String // CAM-00001

  /// Owner-defined extra fields, keyed by `EntityFieldConfig.fieldKey`.
  customFields Json?
  productName  String
  barcode      String?
  sku          String?

  categoryId    String?
  category      Category? @relation("ProductCategory", fields: [categoryId], references: [id])
  subCategoryId String?
  subCategory   Category? @relation("ProductSubCategory", fields: [subCategoryId], references: [id])
  brandId       String?
  brand         Brand?    @relation(fields: [brandId], references: [id])

  /// goods | service.
  ///
  /// The reference app calls this Physical / Non Physical and has always had
  /// it. A service has no stock - no movement, no balance, no valuation - and
  /// carries a SAC code where goods carry an HSN. Every code path that assumes
  /// "a product has stock" has to check this.
  kind String @default("goods")

  /// HOW CLOSELY THIS PRODUCT'S STOCK IS TRACKED: none | quantity | batch | serial.
  ///
  /// A property of the PRODUCT, not of the tenant - one store mixes all four
  /// freely, and that is the whole point. A CCTV installer, a pharmacy and a
  /// consultancy are the same framework with different settings:
  ///
  ///   none      labour, charges, AMC fees. Never touches stock at all.
  ///   quantity  cable, connectors, fixings. A number on a shelf.
  ///   batch     anything with an expiry or a per-lot cost - see `StockLot`.
  ///   serial    one row per physical unit - see `StockUnit`.
  ///
  /// `kind` and this answer different questions. `kind` is what the thing IS
  /// (goods take an HSN, services a SAC); this is how carefully it is counted.
  /// The one rule joining them: a service is always `none`, because a unit of
  /// labour cannot sit on a shelf. lib/stock-tracking owns that rule, and
  /// `applyMovements` refuses to move stock for a `none` product whatever the
  /// calling document says.
  ///
  /// Defaults to `quantity`, the behaviour every product had before this
  /// column existed.
  trackingMode String @default("quantity")

  hsnCode  String? // goods: drives the GST rate
  sacCode  String? // services: the SAC equivalent
  location String?
  unit     String  @default("pcs")

  deliveryEstimateDays Int?

  isCombo        Boolean @default(false)
  isRateEditable Boolean @default(true) // may a salesperson override price?
  isInOffer      Boolean @default(false)
  isActive       Boolean @default(true)

  imagePath String?
  specs     Json?

  prices                ProductPrice[]
  balances              ProductBalance[]
  movements             StockMovement[]
  purchasePrices        ProductPurchasePrice[]
  returnItems           SalesReturnItem[]
  billItems             PurchaseBillItem[]
  purchaseReturnItems   PurchaseReturnItem[]
  bomsAsFinishedProduct BillOfMaterials[]         @relation("BomFinishedProduct")
  bomsAsComponent       BomComponent[]            @relation("BomComponentProduct")
  complaints            Complaint[]
  repairChallans        RepairChallan[]
  installChallanItems   InstallationChallanItem[]
  amcContractItems      AmcContractItem[]
  stockUnits            StockUnit[]
  stockLots             StockLot[]
  replacementCases      ReplacementCase[]
  complaintItems        ComplaintItem[]

  /// HOW LONG THIS PRODUCT IS COVERED AFTER IT IS SOLD.
  ///
  /// Added 24 Sep 2026 for Phase 4. Without it, coverage resolution can only
  /// ever answer "chargeable" - there was no warranty column anywhere in the
  /// schema, so "is this still under warranty" had no data to read.
  ///
  /// Null means this product carries no warranty, which is different from 0
  /// only in intent; both are treated as no cover by `warrantyUntil`. Left
  /// null by default rather than defaulted to a guess, because inventing a
  /// warranty period would produce confident wrong answers about who pays -
  /// and a wrong "under warranty" is a free site visit given away.
  ///
  /// Product-level, not unit-level. Per-unit warranty needs serialised stock
  /// (Phase 3); until then this plus the invoice line's date is the best
  /// available answer, and it is the one this trade actually uses.
  warrantyMonths Int?

  // ---- Expiry. Added 2 Oct 2026.
  //
  // WHY THIS IS SEPARATE FROM `trackingMode`.
  //
  // `trackingMode = batch` means "I need to know which lot each item came
  // from" - a recall question. Expiry is a different question: "will this go
  // out of date on my shelf". A kirana store's milk expires and is counted by
  // quantity; a bolt is batch-tracked for a certification audit and never
  // expires. Tying the two together would force every shop that wants an
  // expiry reminder into per-lot paperwork it does not need.
  //
  // Where the two DO meet: a batch product's expiry is the lot's
  // (`StockLot.expiryDate`), because different lots expire on different days.
  // For anything else it is the receipt line's (`GoodsReceiptNoteItem
  // .expiryDate`), which has existed since batches did and was never read.

  /// Whether this product goes out of date at all. Off for the overwhelming
  /// majority of what Atlas holds, so the field is never shown unless it is on.
  tracksExpiry Boolean @default(false)

  /// How many days it keeps from the day it is received, when the pack does
  /// not print a date. Lets the receiving clerk leave the expiry box empty and
  /// still get a correct reminder. Null means the date must be typed.
  shelfLifeDays Int?

  /// How many days before expiry to start warning. Null means the platform
  /// default (lib/expiry-policy `DEFAULT_WARN_DAYS`, 10 days) - enough notice
  /// to discount it or send it back, not so much that the list is noise.
  expiryWarnDays Int?

  // ---- AMC offer. Added 24 Sep 2026.
  //
  // THIS IS AN OFFER, NOT A CONTRACT.
  //
  // Three different things get confused with each other, so to be explicit:
  // `warrantyMonths` above is free cover that comes with the product;
  // `AmcContract` is a signed agreement with one named customer; and these
  // columns are the PRICE-LIST FACT that sits between them - "this product can
  // have an AMC, on these terms". Nobody is covered by anything here until a
  // contract exists.

  /// Whether this product can carry an AMC at all. A cable or a connector
  /// cannot; a DVR or a software licence can.
  amcAvailable Boolean @default(false)

  /// `included` | `extra`
  ///
  /// `included` means the AMC comes inside the purchase price for
  /// `amcDurationMonths` - the customer pays nothing more and is covered from
  /// the day they buy. `extra` means it is a separate yearly fee the customer
  /// may decline, which is why `InvoiceItem.amcOpted` exists.
  amcPricingMode String?

  /// How many months one term of cover runs for. Used by BOTH modes: the free
