/// A BASKET, INCLUDING THE ONES NOBODY FINISHED. Added 3 Oct 2026.
///
/// Pravin asked to see abandoned carts, which is the only reason this is a
/// stored row rather than a cookie: a cart that lives in the browser is a cart
/// nobody can report on, and "what did people nearly buy" is the question he
/// actually wants answered.
///
/// `sessionKey` is how an anonymous visitor keeps a basket before they have an
/// account - a random id in their browser, matched here. When they register,
/// `partyId` is filled in and the basket they built while browsing survives,
/// which is the difference between a shop and a form.
///
/// NO PAYMENT, ever (decision 10). A cart becomes a REQUEST: a Lead when they
/// want to buy something, a complaint when they want somebody to come out.
model Cart {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Null while the visitor is anonymous.
  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)

  /// The browser own id, so an anonymous basket survives a page reload.
  sessionKey String

  /// open | requested | abandoned
  ///
  /// `abandoned` is set by a sweep, not by the customer - nobody presses "give
  /// up". That is why the status is stored rather than derived from the item
  /// count: an abandoned cart and an empty one look identical otherwise.
  status String @default("open")

  /// What it became, when it became something.
  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  complaintId String?
  complaint   Complaint? @relation("CartComplaint", fields: [complaintId], references: [id], onDelete: SetNull)

  /// What the customer typed when they asked. Their words, kept.
  message String?

  requestedAt DateTime?
  abandonedAt DateTime?

  items CartItem[]

  createdAt DateTime @default(now())

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md 4).
  deletedBy    String?
  updatedAt    DateTime  @updatedAt

  @@unique([storeId, sessionKey])
  @@index([storeId, status, updatedAt])
  @@index([storeId, partyId])
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  /// Exactly one of these. A line is a listing or a combo, never both and never
  /// neither; the check lives in code because Prisma cannot express it.
  listingId String?
  listing   CatalogueListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  comboId   String?
