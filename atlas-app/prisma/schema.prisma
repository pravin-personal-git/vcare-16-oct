/// prints when a store has more than one.
model BankAccount {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  accountHolderName String
  bankName          String
  accountNumber     String
