  /// Units of the BOM's finished product this order intends to produce.
  qtyToProduce Int

  /// draft | completed | cancelled
  status String @default("draft")

  warehouseId String?
  notes       String?

  completedAt DateTime?
  completedBy String?

  cancelledAt  DateTime?
  cancelReason String?

  createdBy String?
  createdAt DateTime @default(now())
