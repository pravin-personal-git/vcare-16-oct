/// Personal/employment facts `User` never needed until Onboarding needed a
/// join date and Offboarding needed an exit date. One row per person,
/// not store-scoped - the same shape as `EmployeeSalary`, since these
/// facts belong to the person, not to whichever store they're currently
/// assigned to.
model EmployeeProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth           DateTime?
  dateOfJoining         DateTime?
  employmentType        String    @default("full_time") // full_time | part_time | contract | intern
  personalEmail         String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?

  /// For the payslip document (§4 of the Field Report) - Atlas had nowhere
  /// to keep an employee's own bank details before payroll needed to print
  /// them. Free text, not validated against a bank master - this is a
  /// display field on a document, not a payment-rail integration.
  bankAccountNumber String?
  bankIfsc          String?

  /// Set once probation ends and the employee is confirmed - null while on
  /// probation or for a role with no probation period.
  confirmedAt DateTime?

  /// Set when Offboarding completes - the two fields Onboarding's
  /// `dateOfJoining` has always implicitly needed a counterpart for.
  exitDate   DateTime?
  exitReason String?

  /// Work Schedules (roadmap §4.2) - which named shift and work
  /// arrangement this person is assigned to. See the deliberate scope
  /// limit noted on `EmployeeShift` below: this is an assignment, not yet
  /// something attendance classification reads.
  shiftId    String?
  shift      EmployeeShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  workTypeId String?
  workType   WorkType?      @relation(fields: [workTypeId], references: [id], onDelete: SetNull)

  /// Employee Configuration (roadmap §4.2) - an admin-defined, free-text
  /// label ("Full-Time Contractor", "Seasonal") - atlas-hrns's real
  /// `EmployeeType` (`base/models.py:732`).
  ///
  /// DELIBERATELY SEPARATE from `employmentType` above, not a replacement
  /// for it: `employmentType`'s fixed four values are read by the payroll
  /// rules engine's condition targeting (`CONDITION_FIELDS` in
  /// `salary-contracts.ts`, `EMPLOYMENT_TYPES` in `ContractsClient.tsx`) as
  /// a closed, known set a component's eligibility can branch on. Making
  /// that dynamic would ripple into every place that assumes those four
  /// literal strings. This field is purely descriptive/informational - a
  /// tag shown on the profile, nothing downstream reads it (yet).
  employeeTypeTagId String?
  employeeTypeTag   EmployeeTypeTag? @relation(fields: [employeeTypeTagId], references: [id], onDelete: SetNull)

  /// Employee Configuration (roadmap §4.2) - free-form, many-per-employee
  /// labels ("Remote-first", "On PIP", "Key Holder") - atlas-hrns's real
  /// `Tags` (`base/models.py:1986`). Display/filtering only, same
  /// informational status as `employeeTypeTag` above.
  tags EmployeeTag[]

  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?
}

