model HelpdeskTicket {
  id       String @id @default(cuid())
  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ticketNo String // HD-BR001-2026-0001, same numbering service as every other document

  raisedById String
  raisedBy   User   @relation("HelpdeskRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)

  /// Nullable rather than required - a category an admin later deactivates
  /// or removes must not orphan tickets already raised against it.
  categoryId String?
  category   HelpdeskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  subject     String
  description String

  priority String @default("normal") // low | normal | high | urgent

  /// open -> in_progress -> resolved -> closed. `resolved` is the support
  /// side saying "done"; `closed` is a separate step so the person who
  /// raised it can reopen a `resolved` ticket that didn't actually fix
  /// anything, instead of starting a new one that loses the history.
  status String @default("open")

  assignedToId String?
  assignedTo   User?   @relation("HelpdeskAssignee", fields: [assignedToId], references: [id])

  resolvedAt DateTime?
  closedAt   DateTime?

