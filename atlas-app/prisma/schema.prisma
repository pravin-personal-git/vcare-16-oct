  /// server/bank-accounts.ts, not the schema, because a partial unique index
  /// on a boolean needs a raw migration Prisma cannot express declaratively.
  isDefault       Boolean @default(false)
  showOnDocuments Boolean @default(true)
  isActive        Boolean @default(true)

  /// Balance on the day the account was added to Atlas - not a live figure.
  /// Current balance is never stored (same rule as everywhere else in this
  /// schema: "derived, never a stored running total"); it is
  /// openingBalancePaise plus the sum of this account's BankTransaction rows,
  /// computed in server/bank-summary.ts.
