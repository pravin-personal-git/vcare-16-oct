  salesReturns       SalesReturn[]
  creditNotes        CreditNote[]
  refunds            Refund[]
  purchaseBills      PurchaseBill[]
  purchaseOrders     PurchaseOrder[]
  goodsReceiptNotes  GoodsReceiptNote[]
  supplierPayments   SupplierPayment[]
  purchaseReturns    PurchaseReturn[]
  supplierDebitNotes SupplierDebitNote[]
  complaints         Complaint[]
  amcContracts       AmcContract[]
  /// Units this party currently holds - a customer they were sold to, or a
  /// supplier they went back to. Which of the two is read off the unit's status.
  heldUnits          StockUnit[]
  sites              PartySite[]
  rmaAsCustomer      ReplacementCase[]   @relation("RmaCustomer")
  rmaAsSupplier      ReplacementCase[]   @relation("RmaSupplier")
  supplierDispatches SupplierDispatch[]  @relation("DispatchSupplier")
  rmaReceipts        RmaReceipt[]        @relation("RmaReceiptSupplier")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- sync (F2) ----
  /// F2: bumped on every write. What F3 compares - two clocks give two answers, a counter gives one.
  version      Int       @default(1)
  /// F2: which node created this row. Null = the hub. Lets a bad node be traced.
  originNodeId String?
  /// F2: tombstone. Absent and deleted must not look the same to a sync pull.
  deletedAt    DateTime?
  /// F2: nothing is removed without a name against it (AGENTS.md §4).
  deletedBy    String?

  surveyVisits         ServiceVisit[]        @relation("ServiceVisitCustomer")
  installationChallans InstallationChallan[] @relation("InstallationChallanCustomer")

  @@unique([storeId, partyCode])
  @@index([storeId, isCustomer])
  @@index([storeId, isSupplier])
  @@index([storeId, phone])
}

