{
  "expo": {
    "name": "Vcare",
    "slug": "malikos",
    "version": "1.0.28",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nairsolutions.maalikos",
      "versionCode": 30,
      "permissions": [
        "android.permission.READ_CALL_LOG",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1220",
          "image": "./assets/splash-icon.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-font",
      "expo-background-task",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Vcare uses the camera to scan barcodes, serial numbers, invoices and visiting cards.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Vcare records voice notes on a job when you tap Voice note.",
          "enableBackgroundPlayback": false
        }
      ],
      "./plugins/with-release-signing",
      [
        "expo-notifications",
        {
          "color": "#1F43C2",
          "defaultChannel": "default"
        }
      ]
    ],
    "scheme": "maalikos",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://atlas.nairsolutions.org",
      "otpLaunchDate": "2026-12-01",
      "router": {},
      "eas": {
        "projectId": "04b63902-b57f-48ed-8282-6cb3878debdc"
      }
    },
    "owner": "nairsolutions"
  }
}
